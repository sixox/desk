<%
  cis ||= project.cis.includes(:swift).order(issue_date: :desc).to_a
  new_ci = @new_ci || project.cis.build
%>

<div class="m-card">

  <div class="m-card__header">
    <div>
      <h5 class="m-card__title">Commercial Invoices</h5>
      <p class="m-card__subtitle">
        Customer invoices, balance amounts and receipts
      </p>
    </div>

    <span class="badge bg-light text-secondary border">
      <%= cis.size %> CIs
    </span>
  </div>

  <div class="p-3">

    <% cis.each do |ci| %>

      <div class="border rounded-3 p-3 mb-3">

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">

          <div>
            <div class="fw-semibold">
              CI <%= ci.number %>
            </div>

            <small class="text-body-secondary">
              <%= ci.issue_date&.strftime("%d %b %Y") %>
              · <%= number_with_delimiter(ci.net_weight) %> MT net
              · <%= number_with_delimiter(ci.gross_weight) %> MT gross
            </small>
          </div>

          <div class="d-flex flex-wrap gap-2 align-items-center">

            <% if ci.swift.present? %>
              <span class="badge bg-success-subtle text-success">
                Swift attached
              </span>
            <% else %>
              <span class="badge bg-warning-subtle text-warning-emphasis">
                Unpaid
              </span>
            <% end %>

            <% if ci.sent? %>
              <span class="badge bg-info-subtle text-info">Sent</span>
            <% else %>
              <span class="badge bg-light text-secondary border">Not sent</span>
            <% end %>

            <% if ci.document.attached? %>
              <%= link_to rails_blob_path(ci.document, disposition: "attachment"),
                target: "_blank",
                rel: "noopener",
                class: "btn btn-sm btn-light border" do %>
                <i class="fa-solid fa-file-pdf me-1"></i> CI
              <% end %>
            <% end %>

          </div>

        </div>

        <div class="row g-3 mt-2">

          <div class="col-4">
            <small class="text-body-secondary">Advance</small>
            <div class="fw-semibold">
              <%= number_with_delimiter(ci.advance_payment) %>
              <small><%= project.pi&.currency %></small>
            </div>
          </div>

          <div class="col-4">
            <small class="text-body-secondary">Balance</small>
            <div class="fw-semibold">
              <%= number_with_delimiter(ci.balance_payment) %>
              <small><%= project.pi&.currency %></small>
            </div>
          </div>

          <div class="col-4">
            <small class="text-body-secondary">Total</small>
            <div class="fw-semibold">
              <%= number_with_delimiter(ci.total_price) %>
              <small><%= project.pi&.currency %></small>
            </div>
          </div>

        </div>

        <% if can_manage %>

          <details class="mt-3" <%= "open" if @editing_ci_id.to_i == ci.id %>>

            <summary class="btn btn-light border btn-sm">
              <i class="fa-solid fa-pen-to-square me-1"></i>
              Edit CI
            </summary>

            <div class="pt-3">

              <%= form_with model: [project, ci],
                multipart: true,
                data: { turbo: false },
                class: "erp-form" do |form| %>

                <%= render "shared/forms/errors", object: ci %>

                <div class="row g-3">

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :number,
                      label: "CI Number",
                      required: true %>
                  </div>

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :issue_date,
                      label: "Issue Date",
                      type: :date_field,
                      required: true %>
                  </div>

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :validity,
                      label: "Validity",
                      type: :number_field %>
                  </div>

                  <div class="col-md-6">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :net_weight,
                      label: "Net Weight (MT)",
                      type: :number_field,
                      required: true,
                      input_options: { min: 0, step: "0.0001" } %>
                  </div>

                  <div class="col-md-6">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :gross_weight,
                      label: "Gross Weight (MT)",
                      type: :number_field,
                      required: true,
                      input_options: { min: 0, step: "0.0001" } %>
                  </div>

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :advance_payment,
                      label: "Advance Payment",
                      type: :number_field,
                      required: true,
                      input_options: { min: 0, step: "any" } %>
                  </div>

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :balance_payment,
                      label: "Balance Payment",
                      type: :number_field,
                      required: true,
                      input_options: { min: 0, step: "any" } %>
                  </div>

                  <div class="col-md-4">
                    <%= render "shared/forms/field",
                      form: form,
                      attribute: :total_price,
                      label: "Total Price",
                      type: :number_field,
                      required: true,
                      input_options: { min: 0, step: "any" } %>
                  </div>

                  <div class="col-md-6">
                    <%= form.label :account_id, "Bank Account",
                      class: "form-label" %>
                    <%= form.collection_select :account_id,
                      Account.includes(:bank).order(:id),
                      :id,
                      :display_name_with_bank,
                      { include_blank: "Select account" },
                      { class: "form-select" } %>
                  </div>

                  <div class="col-md-6">
                    <%= form.label :document, "Invoice Document",
                      class: "form-label" %>
                    <%= form.file_field :document,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png" %>

                    <% if ci.document.attached? %>
                      <small class="text-body-secondary">
                        Current: <%= ci.document.filename %>
                      </small>
                    <% end %>
                  </div>

                </div>

                <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">

                  <div class="d-flex gap-2">

                    <% if ci.swift.present? %>
                      <span class="small text-success align-self-center">
                        Receipt already attached
                      </span>
                    <% else %>
                      <%= link_to new_ci_swift_path(ci),
                        data: { controller: "bs-modal-form" },
                        class: "btn btn-light border btn-sm" do %>
                        <i class="fa-solid fa-money-bill-transfer me-1"></i>
                        Add Balance Swift
                      <% end %>
                    <% end %>

                    <%= link_to toggle_sent_ci_path(ci),
                      data: {
                        turbo_method: :patch,
                        turbo_confirm: "Change CI sent status?"
                      },
                      class: "btn btn-light border btn-sm" do %>
                      <i class="fa-solid fa-paper-plane me-1"></i>
                      <%= ci.sent? ? "Mark Not Sent" : "Mark Sent" %>
                    <% end %>

                  </div>

                  <%= form.submit "Save CI",
                    class: "btn btn-primary" %>

                </div>

              <% end %>

            </div>
          </details>

        <% end %>

      </div>

    <% end %>


    <% if project.pi.present? && can_manage %>

      <details class="border rounded-3 p-3" <%= "open" if new_ci.errors.any? || !new_ci.persisted? && @new_ci.present? %>>

        <summary class="fw-semibold">
          <i class="fa-solid fa-plus me-1"></i>
          Create Commercial Invoice
        </summary>

        <div class="pt-3">

          <%= form_with model: [project, new_ci],
            multipart: true,
            data: { turbo: false },
            class: "erp-form" do |form| %>

            <%= render "shared/forms/errors", object: new_ci %>

            <div class="row g-3">

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :number,
                  label: "CI Number",
                  required: true %>
              </div>

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :issue_date,
                  label: "Issue Date",
                  type: :date_field,
                  required: true %>
              </div>

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :validity,
                  label: "Validity",
                  type: :number_field %>
              </div>

              <div class="col-md-6">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :net_weight,
                  label: "Net Weight (MT)",
                  type: :number_field,
                  required: true,
                  input_options: { min: 0, step: "0.0001" } %>
              </div>

              <div class="col-md-6">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :gross_weight,
                  label: "Gross Weight (MT)",
                  type: :number_field,
                  required: true,
                  input_options: { min: 0, step: "0.0001" } %>
              </div>

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :advance_payment,
                  label: "Advance Payment",
                  type: :number_field,
                  required: true,
                  input_options: { min: 0, step: "any" } %>
              </div>

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :balance_payment,
                  label: "Balance Payment",
                  type: :number_field,
                  required: true,
                  input_options: { min: 0, step: "any" } %>
              </div>

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :total_price,
                  label: "Total Price",
                  type: :number_field,
                  required: true,
                  input_options: { min: 0, step: "any" } %>
              </div>

              <div class="col-md-6">
                <%= form.label :account_id, "Bank Account",
                  class: "form-label" %>
                <%= form.collection_select :account_id,
                  Account.includes(:bank).order(:id),
                  :id,
                  :display_name_with_bank,
                  { include_blank: "Select account" },
                  { class: "form-select" } %>
              </div>

              <div class="col-md-6">
                <%= form.label :document, "Invoice Document",
                  class: "form-label" %>
                <%= form.file_field :document,
                  class: "form-control",
                  required: true,
                  accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png" %>
              </div>

            </div>

            <div class="d-flex justify-content-end mt-3">
              <%= form.submit "Create CI",
                class: "btn btn-primary" %>
            </div>

          <% end %>

        </div>
      </details>

    <% elsif project.pi.blank? %>

      <p class="small text-body-secondary mb-0">
        Create a PI before adding Commercial Invoices.
      </p>

    <% end %>

  </div>
</div>