<section class="m-card mb-3">

  <header class="m-card__header">

    <div>
      <h2 class="m-card__title">
        <i class="fa-solid fa-money-bill-transfer me-2"></i>
        Customer Receipts
      </h2>

      <p class="m-card__subtitle">
        Advance payments, CI receipts, and bank deposits
      </p>
    </div>

    <% if @can_manage_project && @pi.present? %>

      <%= link_to new_project_swift_path(@project),
        class: "btn btn-sm btn-light border",
        data: { controller: "bs-modal-form" } do %>
        <i class="fa-solid fa-plus me-1"></i>
        New Swift
      <% end %>

    <% end %>

  </header>

  <!-- CONFIRMED CUSTOMER RECEIPTS -->

  <div class="row g-2 mb-3">

    <% if @confirmed_receipts_by_currency.any? %>

      <% @confirmed_receipts_by_currency.sort.each do |currency, amount| %>

        <div class="col-6 col-md-4">

          <div class="border rounded-3 p-3 h-100">

            <div class="small text-body-secondary">
              Confirmed · <%= currency.upcase %>
            </div>

            <div class="fw-bold mt-1">
              <%= number_with_delimiter(amount.round(2)) %>
            </div>

          </div>

        </div>

      <% end %>

    <% else %>

      <div class="col-12">

        <div class="border rounded-3 p-3 small text-body-secondary">
          No confirmed customer receipts yet.
        </div>

      </div>

    <% end %>

  </div>

  <!-- BANK CREDITS -->

  <% if @bank_credits_by_currency.any? %>

    <div class="mb-3">

      <div class="small fw-semibold text-body-secondary mb-2">
        Amount credited by banks
      </div>

      <div class="d-flex flex-wrap gap-2">

        <% @bank_credits_by_currency.sort.each do |currency, amount| %>

          <span class="badge bg-primary-subtle text-primary p-2">

            <%= currency.upcase %>:

            <%= number_with_delimiter(amount.round(2)) %>

          </span>

        <% end %>

      </div>

      <p class="small text-body-secondary mt-2 mb-0">
        Bank credits use each Swift's deposited amount and the bank's currency.
        They are not added to customer-received amounts.
      </p>

    </div>

  <% end %>

  <!-- STATUS SUMMARY -->

  <div class="d-flex flex-wrap gap-2 mb-3">

    <span class="badge bg-success-subtle text-success">
      <%= @confirmed_swifts.size %> confirmed
    </span>

    <span class="badge bg-warning-subtle text-warning-emphasis">
      <%= @pending_swifts.size %> pending
    </span>

    <span class="badge bg-danger-subtle text-danger">
      <%= @rejected_swifts.size %> rejected
    </span>

    <% if @conflicting_swifts.any? %>

      <span class="badge bg-danger text-white">
        <%= @conflicting_swifts.size %> conflicting status
      </span>

    <% end %>

  </div>

  <!-- SWIFT RECORDS -->

  <% if @project_swifts.any? %>

    <div class="table-responsive">

      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Source</th>
            <th>Bank</th>
            <th class="text-end">Customer sent</th>
            <th class="text-end">Bank credited</th>
            <th>Status</th>
            <th>Date</th>
            <th>Documents</th>
          </tr>
        </thead>

        <tbody>

          <% @project_swifts.each do |swift| %>

            <%
              source =
                if swift.ci.present?
                  "CI #{swift.ci.number}"
                elsif swift.advance == true
                  "Project advance"
                else
                  "Project receipt"
                end

              status, status_class =
                if swift.confirmed == true && swift.rejected == true
                  ["Conflicting", "bg-danger-subtle text-danger"]
                elsif swift.rejected == true
                  ["Rejected", "bg-danger-subtle text-danger"]
                elsif swift.confirmed == true
                  ["Confirmed", "bg-success-subtle text-success"]
                else
                  ["Pending", "bg-warning-subtle text-warning-emphasis"]
                end
            %>

            <tr>

              <td class="text-nowrap">

                <div class="fw-semibold small">
                  <%= source %>
                </div>

                <div class="small text-body-secondary">
                  #<%= swift.id %>
                </div>

              </td>

              <td class="small">
                <%= swift.bank&.name || "—" %>
              </td>

              <td class="text-end text-nowrap">

                <div class="fw-semibold">
                  <%= number_with_delimiter(swift.amount.to_f.round(2)) %>
                </div>

                <div class="small text-body-secondary">
                  <%= swift.currency&.upcase %>
                </div>

              </td>

              <td class="text-end text-nowrap">

                <% if swift.deposited_amount.present? %>

                  <div class="fw-semibold">
                    <%= number_with_delimiter(swift.deposited_amount.to_f.round(2)) %>
                  </div>

                  <div class="small text-body-secondary">
                    <%= swift.bank&.currency&.upcase || "Bank currency not set" %>
                  </div>

                <% else %>

                  <span class="text-body-secondary">—</span>

                <% end %>

              </td>

              <td>
                <span class="badge <%= status_class %>">
                  <%= status %>
                </span>
              </td>

              <td class="small text-nowrap">

                <% if swift.confirmed == true %>

                  <%= swift.confirm_at&.strftime("%d %b %Y") || "Confirmed" %>

                <% elsif swift.rejected == true %>

                  <%= swift.rejected_at&.strftime("%d %b %Y") || "Rejected" %>

                <% else %>

                  <%= swift.created_at&.strftime("%d %b %Y") || "—" %>

                <% end %>

              </td>

              <td>

                <% if swift.documents.attached? %>

                  <div class="d-flex gap-1">

                    <% swift.documents.each_with_index do |document, index| %>

                      <%= link_to index + 1,
                        rails_blob_path(document, disposition: "attachment"),
                        target: "_blank",
                        class: "btn btn-sm btn-light border" %>

                    <% end %>

                  </div>

                <% else %>

                  <span class="text-body-secondary small">—</span>

                <% end %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="text-center py-4">

      <i class="fa-solid fa-money-bill-transfer fs-3 text-body-secondary"></i>

      <p class="small text-body-secondary mt-2 mb-0">
        No Swift records are associated with this Project.
      </p>

    </div>

  <% end %>

</section>