<section class="m-card mb-3">

  <header class="m-card__header">

    <div>
      <h2 class="m-card__title">
        <i class="fa-solid fa-shield-halved me-2"></i>
        Risk & Project Control
      </h2>

      <p class="m-card__subtitle">
        Project risk assessment and workflow completion
      </p>
    </div>

  </header>

  <%
    risk_attributes = {
      new_customer: "New customer",
      new_destination: "New destination",
      shipping: "Shipping",
      exchange: "Exchange",
      supplier_prepaid: "Supplier prepaid",
      delivery_failure: "Delivery failure",
      supplier_credits: "Supplier credits",
      third_person: "Third person",
      custom_clearance: "Custom clearance",
      logistic: "Logistics",
      quality: "Quality"
    }

    active_risks = risk_attributes.select do |attribute, _label|
      @project.public_send(attribute) == true
    end
  %>

  <!-- RISK SCORE -->

  <div class="border rounded-3 p-3 mb-3">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

      <div>

        <div class="small text-body-secondary">
          Calculated risk score
        </div>

        <div class="fs-3 fw-bold">
          <%= @project.risk.to_i %>
        </div>

      </div>

      <div class="text-end">

        <div>
          <%= risk_level_tag(@project) %>
        </div>

        <div class="small text-body-secondary mt-2">
          Impact: <strong><%= @project.impact.to_i %></strong>
          · Likelihood: <strong><%= @project.likelihood.to_i %></strong>
        </div>

      </div>

    </div>

    <% if @project.selected_risk.present? %>

      <div class="small text-body-secondary mt-3">
        Highest calculated factor:
        <strong><%= @project.selected_risk.to_s.humanize %></strong>
      </div>

    <% end %>

  </div>

  <!-- ACTIVE RISK FACTORS -->

  <div class="mb-3">

    <div class="small fw-semibold text-body-secondary mb-2">
      Active risk factors
    </div>

    <% if active_risks.any? %>

      <div class="d-flex flex-wrap gap-2">

        <% active_risks.each do |_attribute, label| %>

          <span class="badge bg-warning-subtle text-warning-emphasis p-2">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            <%= label %>
          </span>

        <% end %>

      </div>

    <% else %>

      <span class="small text-body-secondary">
        No risk factors are currently selected.
      </span>

    <% end %>

  </div>

  <!-- COMPLETION STATUS -->

  <div class="border-top pt-3">

    <div class="small fw-semibold text-body-secondary mb-3">
      Workflow completion
    </div>

    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">

      <div>

        <div class="fw-semibold">
          Sales
        </div>

        <div class="small text-body-secondary">
          Commercial project workflow
        </div>

      </div>

      <% if @project.sales_done? %>

        <span class="badge bg-success-subtle text-success">
          Completed
        </span>

      <% elsif current_user.sales? %>

        <%= button_to "Finish Sales",
          finish_sales_project_path(@project),
          method: :patch,
          class: "btn btn-sm btn-outline-success" %>

      <% else %>

        <span class="badge bg-warning-subtle text-warning-emphasis">
          In progress
        </span>

      <% end %>

    </div>

    <div class="d-flex justify-content-between align-items-center gap-2">

      <div>

        <div class="fw-semibold">
          Logistics
        </div>

        <div class="small text-body-secondary">
          Booking and shipping workflow
        </div>

      </div>

      <% if @project.logistics_done? %>

        <span class="badge bg-success-subtle text-success">
          Completed
        </span>

      <% elsif current_user.logistics? %>

        <%= button_to "Finish Logistics",
          finish_logistics_project_path(@project),
          method: :patch,
          class: "btn btn-sm btn-outline-success",
          data: {
            turbo_confirm: "This will mark all Project Bookings as payment done. Continue?"
          } %>

      <% else %>

        <span class="badge bg-warning-subtle text-warning-emphasis">
          In progress
        </span>

      <% end %>

    </div>

  </div>

  <div class="alert alert-light border small mt-3 mb-0">

    <i class="fa-solid fa-circle-info me-1"></i>

    Finishing Logistics also marks all associated Bookings as
    <strong>payment done</strong>. This action should only be used
    when the logistics workflow is complete.

  </div>

</section>