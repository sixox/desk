
<div class="project-directory">

  <!-- TOP TOOLBAR -->
  <header class="project-directory__toolbar">

    <h1 class="project-directory__title">Project</h1>

    <%= form_with url: projects_path,
      method: :get,
      local: true,
      class: "project-directory__search" do %>

      <div class="project-directory__search-field">

        <i class="fa-solid fa-magnifying-glass"></i>

        <%= text_field_tag "q[name_or_number_cont]",
          params.dig(:q, :name_or_number_cont),
          class: "project-directory__search-input",
          placeholder: "Search project number or keywords...",
          autocomplete: "off" %>

      </div>

      <%= select_tag :sort,
        options_for_select(
          [
            ["Newest ID", "id"],
            ["Last updated", "updated_at"]
          ],
          @sort
        ),
        class: "project-directory__sort",
        aria: { label: "Sort projects" } %>

      <button type="submit"
        class="project-directory__search-button"
        title="Search"
        aria-label="Search projects">
        <i class="fa-solid fa-arrow-right"></i>
      </button>

    <% end %>


    <!-- QUICK LINKS -->
    <div class="project-directory__actions">

      <%= link_to release_requests_path,
        class: "project-directory__action project-directory__action--release" do %>
        <i class="fa-solid fa-file-signature"></i>
        <span>Release Requests</span>
      <% end %>

      <%= link_to turnovers_projects_path,
        class: "project-directory__action project-directory__action--dso" do %>
        <i class="fa-solid fa-chart-line"></i>
        <span>DSO Report</span>
      <% end %>

      <% if current_user.sales? || current_user.logistics? %>

        <%= link_to new_project_path,
          class: "project-directory__action project-directory__action--new",
          data: { controller: "bs-modal-form" } do %>
          <i class="fa-solid fa-plus"></i>
          <span>New Project</span>
        <% end %>

      <% end %>

    </div>

  </header>


  <!-- PROJECT CARDS -->
  <div class="row g-3">

    <% @projects.each do |project| %>

      <div class="col-12 col-md-6 col-xl-4">
        <%= render "project_card", project: project %>
      </div>

    <% end %>


    <% if @projects.empty? %>

      <div class="col-12">

        <div class="project-directory__empty">

          <div class="project-directory__empty-icon">
            <i class="fa-solid fa-folder-open"></i>
          </div>

          <h3>No projects found</h3>

          <p>
            No matching projects. Try another search.
          </p>

          <%= link_to "Clear search",
            projects_path,
            class: "btn btn-light border btn-sm" %>

        </div>

      </div>

    <% end %>

  </div>


  <!-- PAGINATION -->
  <% if @projects.total_pages > 1 %>

    <div class="d-flex justify-content-center mt-4">
      <%= paginate @projects %>
    </div>

  <% end %>

</div>
