<div class="page-header mb-3">

  <div>
    <h1>Projects</h1>

    <p class="subtitle mb-0">
      Commercial, financial and logistics overview of all projects.
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">

    <%= link_to list_projects_path,
      class: "btn btn-light border btn-sm" do %>
      <i class="fa-solid fa-table-list me-1"></i>
      Detailed List / Export
    <% end %>

    <%= link_to release_requests_path,
      class: "btn btn-light border btn-sm" do %>
      <i class="fa-solid fa-file-signature me-1"></i>
      Release Requests
    <% end %>

    <%= link_to turnovers_projects_path,
      class: "btn btn-light border btn-sm" do %>
      <i class="fa-solid fa-chart-line me-1"></i>
      DSO Report
    <% end %>

    <% if current_user.sales? || current_user.logistics? %>

      <%= link_to new_project_path,
        class: "btn btn-primary btn-sm",
        data: { controller: "bs-modal-form" } do %>
        <i class="fa-solid fa-plus me-1"></i>
        New Project
      <% end %>

    <% end %>

  </div>

</div>


<!-- PROJECT COUNTS -->

<div class="row g-2 mb-3">

  <% [
    ["Total Projects", @project_stats[:total], "fa-folder-open", "c1"],
    ["Sales Pending", @project_stats[:sales_open], "fa-handshake", "c2"],
    ["Logistics Pending", @project_stats[:logistics_open], "fa-truck-fast", "c3"],
    ["High / Extreme Risk", @project_stats[:high_risk], "fa-triangle-exclamation", "c4"]
  ].each do |label, value, icon, color| %>

    <div class="col-6 col-xl-3">

      <div class="stat-card h-100">

        <div class="stat-card__head">

          <p class="stat-card__label">
            <%= label %>
          </p>

          <span class="stat-card__icon stat-card__icon--<%= color %>">
            <i class="fa-solid <%= icon %>"></i>
          </span>

        </div>

        <p class="stat-card__value">
          <%= number_with_delimiter(value) %>
        </p>

      </div>

    </div>

  <% end %>

</div>


<!-- DIRECTORY -->

<section class="m-card">

  <div class="m-card__header">

    <div>
      <h2 class="m-card__title">Project Directory</h2>

      <p class="m-card__subtitle">
        <%= number_with_delimiter(@project_total_count) %>
        matching projects
      </p>
    </div>

  </div>


  <div class="p-3">


    <!-- SEARCH -->

    <%= form_with url: projects_path,
      method: :get,
      local: true,
      class: "row g-2 align-items-end mb-3" do %>

      <div class="col-12 col-lg-7">

        <label class="form-label small">
          Search project
        </label>

        <%= text_field_tag "q[name_or_number_cont]",
          params.dig(:q, :name_or_number_cont),
          class: "form-control",
          placeholder: "Project number or name..." %>

      </div>

      <div class="col-8 col-lg-3">

        <label class="form-label small">
          Stage
        </label>

        <%= select_tag :stage,
          options_for_select(
            [
              ["All projects", ""],
              ["Sales pending", "sales_open"],
              ["Logistics pending", "logistics_open"],
              ["Completed", "completed"],
              ["High / extreme risk", "at_risk"],
              ["Without PI", "without_pi"]
            ],
            params[:stage]
          ),
          class: "form-select" %>

      </div>

      <div class="col-4 col-lg-2 d-flex gap-2">

        <%= submit_tag "Search",
          class: "btn btn-primary flex-grow-1" %>

        <%= link_to projects_path,
          class: "btn btn-light border",
          title: "Reset filters" do %>
          <i class="fa-solid fa-rotate-left"></i>
        <% end %>

      </div>

    <% end %>


    <!-- QUICK FILTERS -->

    <div class="d-flex flex-wrap gap-2 mb-3">

      <% [
        ["All", ""],
        ["Sales pending", "sales_open"],
        ["Logistics pending", "logistics_open"],
        ["Completed", "completed"],
        ["At risk", "at_risk"],
        ["Without PI", "without_pi"]
      ].each do |label, value| %>

        <%= link_to label,
          projects_path(
            q: params[:q]&.to_unsafe_h,
            stage: value
          ),
          class: "btn btn-sm #{params[:stage].to_s == value ? 'btn-primary' : 'btn-light border'}" %>

      <% end %>

    </div>


    <!-- PROJECT TABLE -->

    <div class="table-responsive">

      <table class="table table-hover align-middle">

        <thead class="table-light">

          <tr>
            <th>Project</th>
            <th>Customer</th>
            <th>PI / Product</th>
            <th>CIs</th>
            <th>Logistics</th>
            <th>Receipts</th>
            <th>Workflow</th>
            <th>Updated</th>
            <th></th>
          </tr>

        </thead>

        <tbody>

          <% @projects.each do |project| %>

            <%= render "projects/project_row",
              project: project %>

          <% end %>


          <% if @projects.empty? %>

            <tr>

              <td colspan="9">

                <div class="text-center py-5">

                  <i class="fa-solid fa-folder-open fs-2 text-body-secondary"></i>

                  <h3 class="h6 mt-3">
                    No projects found
                  </h3>

                  <p class="small text-body-secondary mb-0">
                    Try changing the search or filters.
                  </p>

                </div>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>


    <!-- PAGINATION -->

    <% if @projects.total_pages > 1 %>

      <div class="d-flex justify-content-center mt-3">
        <%= paginate @projects %>
      </div>

    <% end %>

  </div>

</section>