<%
  project = local_assigns[:project] || @project
  in_modal = local_assigns.fetch(:in_modal, true)

  form_css_class = in_modal ? "erp-modal__form" : "erp-form"

  risk_attributes = [
    [:new_customer, "New customer"],
    [:new_destination, "New destination"],
    [:shipping, "Shipping risk"],
    [:exchange, "Exchange risk"],
    [:supplier_prepaid, "Supplier prepaid"],
    [:delivery_failure, "Delivery failure"],
    [:supplier_credits, "Supplier credits"],
    [:third_person, "Third person involved"],
    [:custom_clearance, "Custom clearance"],
    [:logistic, "Logistics risk"],
    [:quality, "Quality risk"]
  ]
%>

<%= form_with(
  model: project,
  html: {
    class: form_css_class
  }
) do |f| %>

  <div class="<%= in_modal ? 'modal-body' : 'card-body' %> erp-form__body">

    <%= render "shared/forms/errors", object: project %>

    <!-- PROJECT DETAILS -->

    <section class="erp-form__section">

      <%= render "shared/forms/section_heading",
        icon: "fa-folder-open",
        title: "Project Details",
        description: "Enter the project identity and basic information." %>

      <div class="row g-3">

        <div class="col-md-6">

          <%= render "shared/forms/field",
            form: f,
            attribute: :number,
            label: "Project number",
            required: true,
            hint: "Use the existing Project number format.",
            input_options: {
              placeholder: "e.g. 1400-0001",
              autofocus: true
            } %>

        </div>

        <div class="col-md-6">

          <%= render "shared/forms/field",
            form: f,
            attribute: :name,
            label: "Project name",
            required: true,
            input_options: {
              placeholder: "Enter project name"
            } %>

        </div>

      </div>

      <div class="mt-3">

        <div class="form-check form-switch">

          <%= f.check_box :started,
            class: "form-check-input",
            role: "switch" %>

          <%= f.label :started,
            "Project has started",
            class: "form-check-label fw-medium" %>

        </div>

        <div class="erp-form__hint">
          This records the operational start flag. Sales and Logistics
          completion remain separate workflow states.
        </div>

      </div>

    </section>

    <!-- PROJECT PORTAL ACCESS -->

    <section class="erp-form__section">

      <%= render "shared/forms/section_heading",
        icon: "fa-lock",
        title: "Project Portal Access",
        description: "The Project password is used for external timeline access with the PI number." %>

      <div class="row g-3">

        <div class="col-md-6">

          <%= render "shared/forms/field",
            form: f,
            attribute: :password,
            type: :password_field,
            label: project.persisted? ? "New password" : "Project password",
            required: !project.persisted?,
            hint: project.persisted? ? "Leave blank to keep the current password." : "Required when creating a project.",
            input_options: {
              autocomplete: "new-password",
              placeholder: project.persisted? ? "Leave blank to keep current password" : "Create project password"
            } %>

        </div>

        <div class="col-md-6">

          <%= render "shared/forms/field",
            form: f,
            attribute: :password_confirmation,
            type: :password_field,
            label: "Confirm password",
            hint: "Repeat the new password when changing it.",
            input_options: {
              autocomplete: "new-password",
              placeholder: "Confirm password"
            } %>

        </div>

      </div>

    </section>

    <!-- RISK ASSESSMENT -->

    <section class="erp-form__section">

      <%= render "shared/forms/section_heading",
        icon: "fa-shield-halved",
        title: "Project Risk Assessment",
        description: "Select every applicable risk factor. The Project model recalculates the risk score, impact, likelihood, and selected risk when saving." %>

      <div class="row g-3">

        <% risk_attributes.each do |attribute, label| %>

          <div class="col-12 col-sm-6">

            <div class="border rounded-3 p-3 h-100">

              <div class="form-check">

                <%= f.check_box attribute,
                  class: "form-check-input" %>

                <%= f.label attribute,
                  label,
                  class: "form-check-label fw-medium" %>

              </div>

            </div>

          </div>

        <% end %>

      </div>

      <% if project.persisted? && project.risk.to_i.positive? %>

        <div class="small text-body-secondary mt-3">

          Current calculated risk:
          <strong><%= project.risk %></strong>

          · Impact:
          <strong><%= project.impact %></strong>

          · Likelihood:
          <strong><%= project.likelihood %></strong>

          <% if project.selected_risk.present? %>
            · Main factor:
            <strong><%= project.selected_risk.to_s.humanize %></strong>
          <% end %>

        </div>

      <% end %>

    </section>

  </div>

  <%= render "shared/forms/actions",
    in_modal: in_modal,
    cancel_path: projects_path,
    submit_label: project.persisted? ? "Save project changes" : "Create project" %>

<% end %>