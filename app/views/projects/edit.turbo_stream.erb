<%= turbo_stream.replace "remote_modal" do %>

  <%= render "shared/turbo_modal",
    modal_title: "Edit Project",
    modal_subtitle: "Update project details and risk assessment.",
    modal_icon: "fa-folder-open",
    modal_size: "modal-lg",
    form_partial: "projects/form",
    form_locals: {
      project: @project,
      in_modal: true
    } %>

<% end %>