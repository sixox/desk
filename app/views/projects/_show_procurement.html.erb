<section class="m-card mb-3">

  <header class="m-card__header">

    <div>
      <h2 class="m-card__title">
        <i class="fa-solid fa-boxes-stacked me-2"></i>
        Procurement & Inventory
      </h2>

      <p class="m-card__subtitle">
        Supplier allocations linked to this Project
      </p>
    </div>

    <%= link_to ballances_path,
      class: "btn btn-sm btn-light border" do %>
      Inventories
      <i class="fa-solid fa-arrow-right ms-1"></i>
    <% end %>

  </header>

  <!-- PI ALLOCATION SUMMARY -->

  <div class="border rounded-3 p-3 mb-3">

    <div class="row g-3">

      <div class="col-4">
        <div class="small text-body-secondary">PI quantity</div>
        <div class="fw-semibold">
          <%= number_with_delimiter(@pi&.quantity.to_i) %> MT
        </div>
      </div>

      <div class="col-4">
        <div class="small text-body-secondary">Allocated</div>
        <div class="fw-semibold">
          <%= number_with_delimiter(
            @allocates.sum { |allocation| allocation.quantity.to_i }
          ) %> MT
        </div>
      </div>

      <div class="col-4">

        <div class="small text-body-secondary">Remaining</div>

        <div class="fw-bold <%= @remains.negative? ? 'text-danger' : 'text-success' %>">
          <%= number_with_delimiter(@remains) %> MT
        </div>

      </div>

    </div>

    <% if @remains.negative? %>

      <div class="alert alert-danger py-2 small mt-3 mb-0">
        Allocated quantity exceeds the Project PI quantity.
        Please review the inventory allocations.
      </div>

    <% end %>

  </div>

  <!-- ALLOCATIONS -->

  <% if @allocates.any? %>

    <% @allocates.each do |allocation| %>

      <% balance = allocation.ballance %>
      <% spi = balance&.spi %>

      <article class="border rounded-3 p-3 mb-3">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">

          <div>

            <div class="small text-body-secondary">
              Inventory allocation
            </div>

            <%= link_to balance.number,
              ballance_path(balance),
              class: "fw-bold text-decoration-none" %>

            <div class="small text-body-secondary">
              <%= balance.name.presence || "—" %>
            </div>

          </div>

          <span class="badge bg-primary-subtle text-primary">
            <%= number_with_delimiter(allocation.quantity.to_i) %> MT allocated
          </span>

        </div>

        <div class="row g-3">

          <div class="col-6">

            <div class="small text-body-secondary">
              Supplier
            </div>

            <% if balance.supplier.present? %>

              <%= link_to balance.supplier.name,
                supplier_path(balance.supplier),
                class: "fw-semibold text-decoration-none" %>

            <% else %>

              <span class="text-body-secondary">—</span>

            <% end %>

          </div>

          <div class="col-6">

            <div class="small text-body-secondary">
              Supplier PI
            </div>

            <div class="fw-semibold">
              <%= spi&.number.presence || "—" %>
            </div>

          </div>

          <div class="col-6">

            <div class="small text-body-secondary">
              Supplier PI quantity
            </div>

            <div class="fw-semibold">
              <%= number_with_delimiter(spi&.quantity.to_i) %> MT
            </div>

          </div>

          <div class="col-6">

            <div class="small text-body-secondary">
              Inventory remaining
            </div>

            <div class="fw-semibold">
              <%= number_with_delimiter(balance.remaining_quantity) %> MT
            </div>

          </div>

          <div class="col-6">

            <div class="small text-body-secondary">
              Product
            </div>

            <div class="fw-semibold">
              <%= balance.product.presence || "—" %>
            </div>

          </div>

          <div class="col-6">

            <div class="small text-body-secondary">
              Packing
            </div>

            <div class="fw-semibold">
              <%= spi&.packing_type.presence || "—" %>
            </div>

          </div>

          <% if spi&.issue_date.present? %>

            <div class="col-6">

              <div class="small text-body-secondary">
                Supplier PI issue date
              </div>

              <div class="fw-semibold">
                <%= spi.issue_date.strftime("%d %b %Y") %>
              </div>

            </div>

          <% end %>

        </div>

      </article>

    <% end %>

    <p class="small text-body-secondary mb-0">
      Supplier advance payments linked to a shared Balance are not
      counted as payments belonging entirely to this Project.
      They remain associated with their Balance.
    </p>

  <% else %>

    <div class="text-center py-4">

      <i class="fa-solid fa-boxes-stacked fs-3 text-body-secondary"></i>

      <p class="small text-body-secondary mt-2 mb-0">
        No supplier inventory has been allocated to this Project.
      </p>

    </div>

  <% end %>

</section>