<%
  risk_labels = {
    new_customer: "New customer",
    new_destination: "New destination",
    shipping: "Shipping",
    exchange: "Exchange",
    supplier_prepaid: "Supplier prepaid",
    delivery_failure: "Delivery failure",
    supplier_credits: "Supplier credits",
    third_person: "Third person",
    custom_clearance: "Custom clearance",
    logistic: "Logistics",
    quality: "Quality"
  }

  active_risks = risk_labels.select do |attribute, _label|
    project.public_send(attribute) == true
  end
%>

<div class="m-card">

  <div class="m-card__header">

    <div>
      <h5 class="m-card__title">Project Information</h5>
      <p class="m-card__subtitle">
        General details, risk and workflow status
      </p>
    </div>

    <% if can_manage %>
      <span class="badge bg-light text-secondary border">Editable</span>
    <% end %>

  </div>

  <div class="p-3">

    <div class="row g-3">

      <div class="col-6">
        <small class="text-body-secondary">Project Number</small>
        <div class="fw-semibold"><%= project.number %></div>
      </div>

      <div class="col-6">
        <small class="text-body-secondary">Project Name</small>
        <div class="fw-semibold">
          <%= project.name.presence || "—" %>
        </div>
      </div>

      <div class="col-6">
        <small class="text-body-secondary">Created</small>
        <div class="fw-semibold">
          <%= project.created_at&.strftime("%d %b %Y") || "—" %>
        </div>
      </div>

      <div class="col-6">
        <small class="text-body-secondary">Last Updated</small>
        <div class="fw-semibold">
          <%= project.updated_at&.strftime("%d %b %Y") || "—" %>
        </div>
      </div>

    </div>


    <hr class="my-3">


    <!-- RISK SUMMARY -->

    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">

      <div>
        <small class="text-body-secondary">Calculated Risk</small>
        <div class="fw-bold">
          <%= project.risk.to_i %>
          <span class="ms-1"><%= risk_level_tag(project) %></span>
        </div>
      </div>

      <div class="text-end">
        <small class="text-body-secondary">Main Risk Factor</small>
        <div class="fw-semibold">
          <%= project.selected_risk.present? ?
            project.selected_risk.to_s.humanize : "None" %>
        </div>
      </div>

    </div>

    <% if active_risks.any? %>

      <div class="d-flex flex-wrap gap-1 mb-3">

        <% active_risks.each do |_attribute, label| %>
          <span class="badge bg-warning-subtle text-warning-emphasis">
            <%= label %>
          </span>
        <% end %>

      </div>

    <% else %>

      <p class="small text-body-secondary mb-3">
        No risk factors selected.
      </p>

    <% end %>


    <!-- WORKFLOW -->

    <div class="row g-2">

      <div class="col-6">

        <div class="border rounded-3 p-2 h-100">

          <small class="text-body-secondary">Sales</small>

          <div class="fw-semibold mt-1">
            <% if project.sales_done? %>
              <span class="text-success">
                <i class="fa-solid fa-circle-check me-1"></i>
                Completed
              </span>
            <% else %>
              <span class="text-warning-emphasis">
                <i class="fa-solid fa-clock me-1"></i>
                In progress
              </span>
            <% end %>
          </div>

        </div>

      </div>

      <div class="col-6">

        <div class="border rounded-3 p-2 h-100">

          <small class="text-body-secondary">Logistics</small>

          <div class="fw-semibold mt-1">
            <% if project.logistics_done? %>
              <span class="text-success">
                <i class="fa-solid fa-circle-check me-1"></i>
                Completed
              </span>
            <% else %>
              <span class="text-warning-emphasis">
                <i class="fa-solid fa-clock me-1"></i>
                In progress
              </span>
            <% end %>
          </div>

        </div>

      </div>

    </div>


    <!-- EDIT PROJECT -->

    <% if can_manage %>

      <details class="mt-3" <%= "open" if project.errors.any? %>>

        <summary class="btn btn-light border btn-sm">
          <i class="fa-solid fa-pen-to-square me-1"></i>
          Edit Project & Risk
        </summary>

        <div class="pt-4">

          <%= form_with model: project,
            data: { turbo: false },
            class: "erp-form" do |form| %>

            <%= render "shared/forms/errors", object: project %>

            <div class="row g-3">

              <div class="col-md-4">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :number,
                  label: "Project Number",
                  required: true %>
              </div>

              <div class="col-md-8">
                <%= render "shared/forms/field",
                  form: form,
                  attribute: :name,
                  label: "Project Name" %>
              </div>

              <div class="col-12">
                <div class="form-check form-switch">
                  <%= form.check_box :started,
                    class: "form-check-input" %>
                  <%= form.label :started,
                    "Project Started",
                    class: "form-check-label" %>
                </div>
              </div>

            </div>


            <hr class="my-4">

            <h6 class="mb-1">Risk Factors</h6>

            <p class="small text-body-secondary">
              Risk score, impact and likelihood are recalculated when saved.
            </p>

            <div class="row g-2">

              <% risk_labels.each do |attribute, label| %>

                <div class="col-6 col-md-4">

                  <div class="border rounded-3 p-2 h-100">

                    <div class="form-check form-switch">

                      <%= form.check_box attribute,
                        class: "form-check-input" %>

                      <%= form.label attribute,
                        label,
                        class: "form-check-label small" %>

                    </div>

                  </div>

                </div>

              <% end %>

            </div>


            <details class="mt-3">

              <summary class="small fw-semibold text-body-secondary">
                Change project portal password
              </summary>

              <div class="row g-3 mt-1">

                <div class="col-md-6">

                  <%= form.label :password,
                    "New Password",
                    class: "form-label" %>

                  <%= form.password_field :password,
                    class: "form-control",
                    autocomplete: "new-password" %>

                  <small class="text-body-secondary">
                    Leave blank to keep the current password.
                  </small>

                </div>

                <div class="col-md-6">

                  <%= form.label :password_confirmation,
                    "Confirm Password",
                    class: "form-label" %>

                  <%= form.password_field :password_confirmation,
                    class: "form-control",
                    autocomplete: "new-password" %>

                </div>

              </div>

            </details>


            <div class="d-flex justify-content-end mt-4">
              <%= form.submit "Save Project",
                class: "btn btn-primary" %>
            </div>

          <% end %>

        </div>

      </details>


      <hr class="my-3">


      <!-- FINISH ACTIONS -->

      <div class="d-flex flex-wrap gap-2">

        <% if current_user.sales? && !project.sales_done? %>

          <%= button_to finish_sales_project_path(project),
            method: :patch,
            class: "btn btn-outline-success btn-sm",
            form: {
              data: { turbo_confirm: "Finish the sales stage?" }
            } do %>
            <i class="fa-solid fa-check me-1"></i>
            Finish Sales
          <% end %>

        <% end %>


        <% if current_user.logistics? && !project.logistics_done? %>

          <%= button_to finish_logistics_project_path(project),
            method: :patch,
            class: "btn btn-outline-success btn-sm",
            form: {
              data: {
                turbo_confirm: "This will mark all bookings as payment done. Continue?"
              }
            } do %>
            <i class="fa-solid fa-check me-1"></i>
            Finish Logistics
          <% end %>

        <% end %>

      </div>

    <% end %>

  </div>
</div>