<div class="m-card">

  <div class="m-card__header">
    <div>
      <h5 class="m-card__title">Project Details</h5>
      <p class="m-card__subtitle">
        General information and project risk assessment
      </p>
    </div>

    <% if can_manage %>
      <span class="badge bg-light text-secondary border">Editable</span>
    <% end %>
  </div>

  <div class="p-3">

    <% if can_manage %>

      <%= form_with model: project,
        data: { turbo: false },
        class: "erp-form" do |form| %>

        <%= render "shared/forms/errors", object: project %>

        <div class="row g-3">

          <div class="col-md-3">
            <%= render "shared/forms/field",
              form: form,
              attribute: :number,
              label: "Project Number",
              required: true %>
          </div>

          <div class="col-md-6">
            <%= render "shared/forms/field",
              form: form,
              attribute: :name,
              label: "Project Name" %>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
              <%= form.check_box :started,
                class: "form-check-input" %>
              <%= form.label :started,
                "Project Started",
                class: "form-check-label" %>
            </div>
          </div>

        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="mb-0">Risk Assessment</h6>
            <small class="text-body-secondary">
              The project model recalculates risk when saved.
            </small>
          </div>

          <div class="fw-semibold">
            Risk: <%= project.risk.to_i %>
          </div>
        </div>

        <div class="row g-2">

          <% [
            [:new_customer, "New Customer"],
            [:new_destination, "New Destination"],
            [:shipping, "Shipping Risk"],
            [:exchange, "Exchange Risk"],
            [:supplier_prepaid, "Supplier Prepaid"],
            [:delivery_failure, "Delivery Failure"],
            [:supplier_credits, "Supplier Credits"],
            [:third_person, "Third Person"],
            [:custom_clearance, "Customs Clearance"],
            [:logistic, "Logistics Risk"],
            [:quality, "Quality Risk"]
          ].each do |attribute, label| %>

            <div class="col-6 col-md-4 col-xl-3">
              <div class="border rounded-3 px-3 py-2 h-100">
                <div class="form-check form-switch">
                  <%= form.check_box attribute,
                    class: "form-check-input" %>
                  <%= form.label attribute,
                    label,
                    class: "form-check-label small" %>
                </div>
              </div>
            </div>

          <% end %>

        </div>

        <details class="mt-3">
          <summary class="small fw-semibold text-body-secondary">
            Project portal password
          </summary>

          <div class="row g-3 mt-1">

            <div class="col-md-6">
              <%= form.label :password, "New Password",
                class: "form-label" %>
              <%= form.password_field :password,
                class: "form-control",
                autocomplete: "new-password" %>
              <small class="text-body-secondary">
                Leave blank to keep the existing password.
              </small>
            </div>

            <div class="col-md-6">
              <%= form.label :password_confirmation,
                "Confirm Password",
                class: "form-label" %>
              <%= form.password_field :password_confirmation,
                class: "form-control",
                autocomplete: "new-password" %>
            </div>

          </div>
        </details>

        <div class="d-flex justify-content-end mt-4">
          <%= form.submit "Save Project",
            class: "btn btn-primary" %>
        </div>

      <% end %>

    <% else %>

      <div class="row g-3">

        <div class="col-md-4">
          <small class="text-body-secondary">Project Number</small>
          <div class="fw-semibold"><%= project.number %></div>
        </div>

        <div class="col-md-4">
          <small class="text-body-secondary">Project Name</small>
          <div class="fw-semibold"><%= project.name.presence || "—" %></div>
        </div>

        <div class="col-md-4">
          <small class="text-body-secondary">Risk Score</small>
          <div class="fw-semibold"><%= project.risk.to_i %></div>
        </div>

      </div>

    <% end %>

    <% if can_manage %>

      <hr class="my-3">

      <div class="d-flex flex-wrap gap-2">

        <% if current_user.sales? && !project.sales_done? %>
          <%= button_to "Finish Sales",
            finish_sales_project_path(project),
            method: :patch,
            class: "btn btn-outline-success btn-sm",
            form: { data: { turbo_confirm: "Finish the sales stage?" } } %>
        <% end %>

        <% if current_user.logistics? && !project.logistics_done? %>
          <%= button_to "Finish Logistics",
            finish_logistics_project_path(project),
            method: :patch,
            class: "btn btn-outline-success btn-sm",
            form: {
              data: {
                turbo_confirm: "This will mark all bookings as payment done. Continue?"
              }
            } %>
        <% end %>

      </div>

    <% end %>

  </div>
</div>