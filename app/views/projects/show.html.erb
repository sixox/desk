<%
  pi = @pi || @project.pi

  cis = @cis || @project.cis
    .includes(:swift)
    .order(issue_date: :desc)
    .to_a

  bookings = @bookings || @project.bookings
    .includes(:release_request)
    .order(created_at: :desc)
    .to_a

  allocations = @allocates || @project.ballance_projects
    .includes(ballance: :supplier)
    .to_a

  customer = pi&.customer

  can_manage_project =
    current_user.logistics? ||
    current_user.admin? ||
    current_user.sales? ||
    (current_user.is_manager && current_user.procurement?) ||
    current_user.ceo? ||
    current_user.cob?

  can_add_swift =
    current_user.admin? ||
    current_user.sales? ||
    current_user.logistics? ||
    current_user.ceo? ||
    current_user.cob? ||
    current_user.id == 5
%>

<div class="project-show" data-controller="project-workspace">

  <!-- TOP ROW: PROJECT IDENTITY + ACTIONS -->



   <!-- PROJECT TOP BAR — PLAIN, FULL WIDTH -->

<header class="project-show__hero">

  <div class="project-show__identity-line">

    <h1><%= @project.number %></h1>

    <span class="project-show__risk">
      <%= risk_level_tag(@project) %>
    </span>

    <% if customer.present? %>
      <%= link_to customer.nickname,
        customer_path(customer),
        class: "project-show__identity-item project-show__identity-item--customer" %>
    <% else %>
      <span class="project-show__identity-item">No customer</span>
    <% end %>

    <% if pi&.product.present? %>
      <span class="project-show__identity-item">
        <i class="fa-solid fa-box"></i>
        <%= pi.product %>
      </span>
    <% end %>

    <% if pi&.pod.present? %>
      <span class="project-show__identity-item">
        <i class="fa-solid fa-location-dot"></i>
        <%= pi.pod %>
      </span>
    <% end %>

    <nav class="project-show__hero-nav">

      <%= link_to projects_path do %>
        <i class="fa-solid fa-arrow-left"></i>
        Projects
      <% end %>

      <%= link_to time_line_project_path(@project) do %>
        <i class="fa-solid fa-clock-rotate-left"></i>
        Timeline
      <% end %>

    </nav>

  </div>

</header>


<!-- ACTIONS -->

<aside class="project-action-dock">

      <aside class="project-action-dock">

      <div class="project-action-dock__heading">
        <div>
          <i class="fa-solid fa-bolt"></i>
          Project Actions
        </div>
      </div>


      <div class="project-action-dock__actions">

        <% if can_manage_project %>

          <button type="button"
            class="project-action project-action--primary"
            data-action="project-workspace#togglePi">

            <i class="fa-solid fa-file-invoice"></i>
            <%= pi&.persisted? ? "Edit PI" : "Create PI" %>

          </button>


          <% if @project.pi.present? %>

            <button type="button"
              class="project-action"
              data-action="project-workspace#toggleCi">

              <i class="fa-solid fa-receipt"></i>
              New CI

            </button>

          <% end %>


          <button type="button"
            class="project-action"
            data-action="project-workspace#toggleBooking">

            <i class="fa-solid fa-boxes-stacked"></i>
            New Booking

          </button>


          <%= link_to edit_project_path(@project),
            class: "project-action",
            data: { controller: "bs-modal-form" } do %>

            <i class="fa-solid fa-pen-to-square"></i>
            Edit Project

          <% end %>


          <%= link_to project_ballance_projects_path(@project),
            class: "project-action" do %>

            <i class="fa-solid fa-warehouse"></i>
            Allocate

          <% end %>

        <% end %>


        <% if can_add_swift && (@project.pi.present? || current_user.id == 5) %>

          <%= link_to new_project_swift_path(@project),
            class: "project-action project-action--receipt",
            data: { controller: "bs-modal-form" } do %>

            <i class="fa-solid fa-money-bill-transfer"></i>
            Advance Swift

          <% end %>

        <% end %>


        <% if current_user.sales? && !@project.sales_done? %>

          <%= button_to finish_sales_project_path(@project),
            method: :patch,
            class: "project-action project-action--success",
            form: {
              class: "project-action-dock__form",
              data: {
                turbo_confirm: "Finish the sales stage?"
              }
            } do %>

            <i class="fa-solid fa-check"></i>
            Finish Sales

          <% end %>

        <% end %>


        <% if current_user.logistics? && !@project.logistics_done? %>

          <%= button_to finish_logistics_project_path(@project),
            method: :patch,
            class: "project-action project-action--success",
            form: {
              class: "project-action-dock__form",
              data: {
                turbo_confirm: "This will mark all bookings as payment done. Continue?"
              }
            } do %>

            <i class="fa-solid fa-truck-fast"></i>
            Finish Logistics

          <% end %>

        <% end %>

      </div>


      <!-- PROJECT STATUS -->

      <div class="project-action-dock__status">

        <span class="<%= @project.sales_done? ? 'is-done' : 'is-open' %>">
          <i class="fa-solid <%= @project.sales_done? ? 'fa-circle-check' : 'fa-clock' %>"></i>
          Sales <%= @project.sales_done? ? "Complete" : "Open" %>
        </span>

        <span class="<%= @project.logistics_done? ? 'is-done' : 'is-open' %>">
          <i class="fa-solid <%= @project.logistics_done? ? 'fa-circle-check' : 'fa-clock' %>"></i>
          Logistics <%= @project.logistics_done? ? "Complete" : "Open" %>
        </span>

      </div>


      <!-- SECONDARY LINKS -->

      <div class="project-action-dock__quick-links">

        <% if @show_turnover_report %>
          <%= link_to turnover_project_path(@project) do %>
            <i class="fa-solid fa-chart-line"></i>
            DSO
          <% end %>
        <% end %>

        <%= link_to payment_orders_path do %>
          <i class="fa-solid fa-file-invoice-dollar"></i>
          Payment Orders
        <% end %>

        <%= link_to swifts_path do %>
          <i class="fa-solid fa-money-bill-transfer"></i>
          Swifts
        <% end %>

        <%= link_to release_requests_path do %>
          <i class="fa-solid fa-file-signature"></i>
          Release Requests
        <% end %>

      </div>

    </aside>

</aside>


    <!-- ACTIONS -->



  


  <!-- PI + FINANCE -->

  <div class="project-show__commercial-grid">

    <section id="project-pi"
      class="project-show__section">

      <%= render "projects/workspace_pi",
        project: @project,
        pi: pi,
        can_manage: can_manage_project %>

    </section>


    <section id="project-finance"
      class="project-show__section">

      <%= render "projects/workspace_finance",
        project: @project,
        cis: cis,
        allocations: allocations,
        can_manage: can_manage_project %>

    </section>

  </div>


  <!-- LOGISTICS: FULL WIDTH -->

  <section id="project-logistics"
    class="project-show__section project-show__section--logistics">

    <%= render "projects/workspace_logistics",
      project: @project,
      bookings: bookings,
      can_manage: can_manage_project %>

  </section>

</div>