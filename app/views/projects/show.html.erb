
<%
  pi = @pi || @project.pi

  cis = @cis || @project.cis
    .includes(:swift)
    .order(issue_date: :desc)
    .to_a

  bookings = @bookings || @project.bookings
    .includes(:release_request)
    .order(created_at: :desc)
    .to_a

  allocations = @allocates || @project.ballance_projects
    .includes(ballance: :supplier)
    .to_a

  project_swifts = @project_swifts || (
    @project.swifts.to_a + cis.filter_map(&:swift)
  ).uniq(&:id)

  customer = pi&.customer

  can_manage_project =
    current_user.logistics? ||
    current_user.admin? ||
    current_user.sales? ||
    (current_user.is_manager && current_user.procurement?) ||
    current_user.ceo? ||
    current_user.cob?

  can_add_swift =
    current_user.admin? ||
    current_user.sales? ||
    current_user.logistics? ||
    current_user.ceo? ||
    current_user.cob? ||
    current_user.id == 5
%>

<div class="project-show" data-controller="project-workspace">

  <!-- =====================================================
       PROJECT HEADER
       ===================================================== -->

  <header class="project-show__hero">

    <div class="project-show__hero-main">

      <div class="project-show__eyebrow">
        PROJECT WORKSPACE
      </div>

      <div class="project-show__title-row">

        <h1>
          <%= @project.number %>
        </h1>

        <span class="project-show__risk">
          <%= risk_level_tag(@project) %>
        </span>

      </div>

      <div class="project-show__subtitle">

        <% if customer.present? %>
          <%= link_to customer.nickname,
            customer_path(customer) %>
        <% else %>
          Customer not assigned
        <% end %>

        <% if pi.present? %>
          <span>·</span>
          PI <%= pi.number %>
          <span>·</span>
          <%= pi.product %>
          <% if pi.pod.present? %>
            <span>·</span>
            <%= pi.pod %>
          <% end %>
        <% end %>

      </div>

      <div class="project-show__status-row">

        <% if @project.started? %>
          <span class="project-show__status is-started">
            <i class="fa-solid fa-play"></i>
            Started
          </span>
        <% else %>
          <span class="project-show__status is-muted">
            <i class="fa-regular fa-circle"></i>
            Not started
          </span>
        <% end %>

        <% if @project.sales_done? %>
          <span class="project-show__status is-done">
            <i class="fa-solid fa-circle-check"></i>
            Sales completed
          </span>
        <% else %>
          <span class="project-show__status is-open">
            <i class="fa-solid fa-clock"></i>
            Sales open
          </span>
        <% end %>

        <% if @project.logistics_done? %>
          <span class="project-show__status is-done">
            <i class="fa-solid fa-circle-check"></i>
            Logistics completed
          </span>
        <% else %>
          <span class="project-show__status is-open">
            <i class="fa-solid fa-clock"></i>
            Logistics open
          </span>
        <% end %>

      </div>

    </div>


    <div class="project-show__hero-meta">

      <div>
        <span>Created</span>
        <strong>
          <%= @project.created_at&.strftime("%d %b %Y") || "—" %>
        </strong>
      </div>

      <div>
        <span>Last updated</span>
        <strong>
          <%= @project.updated_at&.strftime("%d %b %Y") || "—" %>
        </strong>
      </div>

    </div>

  </header>


  <!-- =====================================================
       PROJECT ACTIONS & USEFUL LINKS
       ===================================================== -->

  <section class="project-action-dock">

    <div class="project-action-dock__heading">
      <div>
        <i class="fa-solid fa-bolt"></i>
        Project Actions
      </div>

      <span>
        Operations and useful links
      </span>
    </div>


    <div class="project-action-dock__groups">

      <!-- OPERATIONS -->

      <div class="project-action-dock__group">

        <span class="project-action-dock__label">
          Manage
        </span>


        <% if can_manage_project %>

          <button type="button"
            class="project-action project-action--primary"
            data-action="project-workspace#togglePi">

            <i class="fa-solid fa-file-invoice"></i>

            <%= pi&.persisted? ? "Edit PI" : "Create PI" %>

          </button>


          <% if pi.present? %>

            <button type="button"
              class="project-action"
              data-action="project-workspace#toggleCi">

              <i class="fa-solid fa-receipt"></i>
              New CI

            </button>

          <% end %>


          <button type="button"
            class="project-action"
            data-action="project-workspace#toggleBooking">

            <i class="fa-solid fa-boxes-stacked"></i>
            New Booking

          </button>


          <%= link_to edit_project_path(@project),
            class: "project-action",
            data: { controller: "bs-modal-form" } do %>

            <i class="fa-solid fa-pen-to-square"></i>
            Edit Project

          <% end %>


          <%= link_to project_ballance_projects_path(@project),
            class: "project-action" do %>

            <i class="fa-solid fa-warehouse"></i>
            Inventory Allocation

          <% end %>

        <% end %>


        <% if can_add_swift && (pi.present? || current_user.id == 5) %>

          <%= link_to new_project_swift_path(@project),
            class: "project-action project-action--receipt",
            data: { controller: "bs-modal-form" } do %>

            <i class="fa-solid fa-money-bill-transfer"></i>
            Advance Swift

          <% end %>

        <% end %>


        <% if current_user.sales? && !@project.sales_done? %>

          <%= button_to finish_sales_project_path(@project),
            method: :patch,
            class: "project-action project-action--success",
            form: {
              class: "d-inline",
              data: {
                turbo_confirm: "Finish the sales stage?"
              }
            } do %>

            <i class="fa-solid fa-check"></i>
            Finish Sales

          <% end %>

        <% end %>


        <% if current_user.logistics? && !@project.logistics_done? %>

          <%= button_to finish_logistics_project_path(@project),
            method: :patch,
            class: "project-action project-action--success",
            form: {
              class: "d-inline",
              data: {
                turbo_confirm: "This will mark all bookings as payment done. Continue?"
              }
            } do %>

            <i class="fa-solid fa-check"></i>
            Finish Logistics

          <% end %>

        <% end %>

      </div>


      <!-- NAVIGATION -->

      <div class="project-action-dock__group">

        <span class="project-action-dock__label">
          Navigate
        </span>

        <%= link_to projects_path,
          class: "project-action" do %>
          <i class="fa-solid fa-arrow-left"></i>
          Projects
        <% end %>

        <%= link_to time_line_project_path(@project),
          class: "project-action" do %>
          <i class="fa-solid fa-clock-rotate-left"></i>
          Timeline
        <% end %>

        <% if @show_turnover_report %>
          <%= link_to turnover_project_path(@project),
            class: "project-action" do %>
            <i class="fa-solid fa-chart-line"></i>
            DSO Report
          <% end %>
        <% end %>

        <%= link_to payment_orders_path,
          class: "project-action" do %>
          <i class="fa-solid fa-file-invoice-dollar"></i>
          Payment Orders
        <% end %>

        <%= link_to swifts_path,
          class: "project-action" do %>
          <i class="fa-solid fa-money-bill-transfer"></i>
          All Swifts
        <% end %>

        <%= link_to release_requests_path,
          class: "project-action" do %>
          <i class="fa-solid fa-file-signature"></i>
          Release Requests
        <% end %>

      </div>

    </div>

  </section>


  <!-- =====================================================
       1. PI
       ===================================================== -->

  <section id="project-pi" class="project-show__section">

    <%= render "projects/workspace_pi",
      project: @project,
      pi: pi,
      can_manage: can_manage_project %>

  </section>


  <!-- =====================================================
       2. FINANCE
       ===================================================== -->

  <section id="project-finance" class="project-show__section">

    <%= render "projects/workspace_finance",
      project: @project,
      cis: cis,
      allocations: allocations,
      can_manage: can_manage_project %>

  </section>


  <!-- =====================================================
       3. LOGISTICS
       ===================================================== -->

  <section id="project-logistics" class="project-show__section">

    <%= render "projects/workspace_logistics",
      project: @project,
      bookings: bookings,
      can_manage: can_manage_project %>

  </section>

</div>
