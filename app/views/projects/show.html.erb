<%
  pi = @pi || @project.pi
  cis = @cis || @project.cis.includes(:swift).order(issue_date: :desc).to_a
  bookings = @bookings || @project.bookings.includes(:release_request).order(created_at: :desc).to_a
  allocations = @allocates || @project.ballance_projects.includes(:ballance).to_a

  total_containers = bookings.sum { |booking| booking.quantity.to_i }
  total_picked_up = bookings.sum { |booking| booking.picked_up.to_i }
  total_stuffed = bookings.sum { |booking| booking.filled.to_i }

  unpaid_cis = cis.count { |ci| ci.swift.nil? }
  pending_bookings = bookings.count { |booking| booking.payment_done != true }

  can_manage_project =
    current_user.logistics? ||
    current_user.admin? ||
    current_user.sales? ||
    (current_user.is_manager && current_user.procurement?) ||
    current_user.ceo? ||
    current_user.cob?

  can_manage_logistics =
    current_user.logistics? ||
    current_user.admin? ||
    current_user.ceo? ||
    current_user.cob?

  can_manage_commercial =
    current_user.sales? ||
    current_user.admin? ||
    current_user.ceo? ||
    current_user.cob? ||
    (current_user.is_manager && current_user.procurement?)
%>

<div class="container-fluid project-workspace py-3">

  <!-- HEADER -->

  <div class="page-header mb-3">

    <div>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-1">

        <h1 class="mb-0">
          <%= @project.number %>
        </h1>

        <%= risk_level_tag(@project) %>

        <% if @project.sales_done? %>
          <span class="badge bg-success-subtle text-success">Sales complete</span>
        <% else %>
          <span class="badge bg-light text-secondary border">Sales open</span>
        <% end %>

        <% if @project.logistics_done? %>
          <span class="badge bg-success-subtle text-success">Logistics complete</span>
        <% else %>
          <span class="badge bg-warning-subtle text-warning-emphasis">Logistics open</span>
        <% end %>

      </div>

      <p class="subtitle mb-0">
        <%= pi&.customer&.nickname || "No customer assigned" %>
        <% if pi.present? %>
          <span class="mx-1">·</span>
          PI <%= pi.number %>
        <% end %>
        <span class="mx-1">·</span>
        Updated <%= time_ago_in_words(@project.updated_at) %> ago
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

      <%= link_to projects_path, class: "btn btn-light border btn-sm" do %>
        <i class="fa-solid fa-arrow-left me-1"></i>
        Projects
      <% end %>

      <%= link_to time_line_project_path(@project),
        class: "btn btn-light border btn-sm" do %>
        <i class="fa-solid fa-clock-rotate-left me-1"></i>
        Timeline
      <% end %>

      <% if @show_turnover_report %>
        <%= link_to turnover_project_path(@project),
          class: "btn btn-light border btn-sm" do %>
          <i class="fa-solid fa-chart-line me-1"></i>
          DSO / Turnover
        <% end %>
      <% end %>

    </div>

  </div>


  <!-- QUICK NAVIGATION -->

  <div class="d-flex flex-wrap gap-2 mb-3">

    <% [
      ["Project", "#project-details"],
      ["PI", "#project-pi"],
      ["CIs", "#project-cis"],
      ["Logistics", "#project-logistics"],
      ["Finance", "#project-finance"]
    ].each do |label, anchor| %>

      <%= link_to label, anchor,
        class: "btn btn-sm btn-light border" %>

    <% end %>

  </div>


  <!-- SUMMARY -->

  <div class="row g-2 mb-4">

    <% [
      ["PI Quantity", pi.present? ? "#{number_with_delimiter(pi.quantity.to_i)} MT" : "—"],
      ["Invoices", cis.size],
      ["Unpaid CIs", unpaid_cis],
      ["Containers", total_containers],
      ["Picked Up", total_picked_up],
      ["Stuffed", total_stuffed]
    ].each do |label, value| %>

      <div class="col-6 col-md-4 col-xl-2">

        <div class="stat-card h-100">

          <div class="stat-card__head">
            <p class="stat-card__label"><%= label %></p>
          </div>

          <p class="stat-card__value">
            <%= value %>
          </p>

        </div>

      </div>

    <% end %>

  </div>


  <!-- PROJECT DETAILS -->

  <section id="project-details" class="mb-4">
    <%= render "projects/workspace_project",
      project: @project,
      can_manage: can_manage_project %>
  </section>


  <!-- COMMERCIAL -->

  <section id="project-pi" class="mb-4">
    <%= render "projects/workspace_pi",
      project: @project,
      pi: pi,
      can_manage: can_manage_commercial %>
  </section>

  <section id="project-cis" class="mb-4">
    <%= render "projects/workspace_cis",
      project: @project,
      cis: cis,
      can_manage: can_manage_commercial %>
  </section>


  <!-- LOGISTICS -->

  <section id="project-logistics" class="mb-4">
    <%= render "projects/workspace_logistics",
      project: @project,
      bookings: bookings,
      can_manage: can_manage_logistics %>
  </section>


  <!-- FINANCE AND PROCUREMENT -->

  <section id="project-finance" class="mb-4">
    <%= render "projects/workspace_finance",
      project: @project,
      cis: cis,
      allocations: allocations %>
  </section>

</div>