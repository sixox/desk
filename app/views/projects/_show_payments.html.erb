<section class="m-card mb-3">

  <header class="m-card__header">

    <div>
      <h2 class="m-card__title">
        <i class="fa-solid fa-wallet me-2"></i>
        Supplier Payment Orders
      </h2>

      <p class="m-card__subtitle">
        Payments linked directly to this Project or its Bookings
      </p>
    </div>

    <%= link_to payment_orders_path,
      class: "btn btn-sm btn-light border" do %>
      All payments
      <i class="fa-solid fa-arrow-right ms-1"></i>
    <% end %>

  </header>

  <!-- PAID TOTALS BY CURRENCY -->

  <% if @paid_orders_by_currency.any? %>

    <div class="mb-3">

      <div class="small fw-semibold text-body-secondary mb-2">
        Paid / waiting for delivery
      </div>

      <div class="d-flex flex-wrap gap-2">

        <% @paid_orders_by_currency.sort.each do |currency, amount| %>

          <span class="badge bg-success-subtle text-success p-2">
            <%= currency.upcase %>:
            <%= number_with_delimiter(amount.round(2)) %>
          </span>

        <% end %>

      </div>

    </div>

  <% end %>

  <% if @pending_orders_by_currency.any? %>

    <div class="mb-3">

      <div class="small fw-semibold text-body-secondary mb-2">
        Other payment orders
      </div>

      <div class="d-flex flex-wrap gap-2">

        <% @pending_orders_by_currency.sort.each do |currency, amount| %>

          <span class="badge bg-warning-subtle text-warning-emphasis p-2">
            <%= currency.upcase %>:
            <%= number_with_delimiter(amount.round(2)) %>
          </span>

        <% end %>

      </div>

    </div>

  <% end %>

  <!-- PAYMENT ORDER TABLE -->

  <% if @project_payment_orders.any? %>

    <div class="table-responsive">

      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Payment</th>
            <th>Purpose / Booking</th>
            <th class="text-end">Amount</th>
            <th>Status</th>
            <th>Bank</th>
            <th>Date</th>
          </tr>
        </thead>

        <tbody>

          <% @project_payment_orders.each do |order| %>

            <%
              order_status = order.status.to_s.downcase

              status_class =
                case order_status
                when "delivered"
                  "bg-success-subtle text-success"
                when "wait for delivery"
                  "bg-info-subtle text-info"
                when "wait for payment"
                  "bg-warning-subtle text-warning-emphasis"
                when "wait for confirm"
                  "bg-secondary-subtle text-secondary"
                when "rejected"
                  "bg-danger-subtle text-danger"
                else
                  "bg-secondary-subtle text-secondary"
                end
            %>

            <tr>

              <td>

                <%= link_to "PO ##{order.id}",
                  payment_order_path(order),
                  class: "fw-semibold text-decoration-none text-nowrap" %>

                <div class="small text-body-secondary">
                  <%= order.user&.name || "—" %>
                </div>

              </td>

              <td class="small">

                <% if order.booking.present? %>

                  <div>
                    Booking: <strong><%= order.booking.number %></strong>
                  </div>

                <% elsif order.ballance.present? %>

                  <div>
                    Inventory:
                    <strong><%= order.ballance.number %></strong>
                  </div>

                <% else %>

                  <span class="text-body-secondary">
                    Project payment
                  </span>

                <% end %>

                <% if order.cost_type.present? %>
                  <div class="text-body-secondary">
                    <%= order.cost_type %>
                  </div>
                <% end %>

              </td>

              <td class="text-end text-nowrap">

                <div class="fw-semibold">
                  <%= number_with_delimiter(order.amount.to_f.round(2)) %>
                </div>

                <div class="small text-body-secondary">
                  <%= order.currency&.upcase %>
                </div>

              </td>

              <td>
                <span class="badge <%= status_class %>">
                  <%= order.status.presence || "Unknown" %>
                </span>
              </td>

              <td class="small">
                <%= order.bank&.name || "—" %>
              </td>

              <td class="small text-nowrap">
                <%= (order.cob_confirmed_at || order.created_at)&.strftime("%d %b %Y") || "—" %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="text-center py-4">

      <i class="fa-solid fa-wallet fs-3 text-body-secondary"></i>

      <p class="small text-body-secondary mt-2 mb-0">
        No payment orders are directly linked to this Project or its Bookings.
      </p>

    </div>

  <% end %>

  <p class="small text-body-secondary mt-3 mb-0">
    Shared Balance-level advance payments are excluded from these Project totals.
    They are associated with the shared inventory Balance and may serve multiple Projects.
  </p>

</section>