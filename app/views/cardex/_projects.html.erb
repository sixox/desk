<section class="m-card mb-3">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">
        <i class="fa-solid fa-diagram-project me-2"></i>
        Project Operations
      </h2>

      <p class="m-card__subtitle">
        Projects requiring attention and recent project activity
      </p>
    </div>

    <%= link_to projects_path, class: "btn btn-sm btn-light border" do %>
      All projects
      <i class="fa-solid fa-arrow-right ms-1"></i>
    <% end %>
  </header>

  <div class="row row-tight g-2 mb-3">

    <% project_stats = [
      {
        label: "Pending Logistics",
        value: @cardex_pending_logistics_count,
        icon: "fa-truck-fast",
        color: "text-warning"
      },
      {
        label: "Pending Payment",
        value: @cardex_pending_payment_count,
        icon: "fa-money-bill-transfer",
        color: "text-info"
      },
      {
        label: "Unpaid CI",
        value: @cardex_unpaid_ci_count,
        icon: "fa-file-invoice",
        color: "text-danger"
      },
      {
        label: "Unfinished Projects",
        value: @cardex_unfinished_project_count,
        icon: "fa-list-check",
        color: "text-primary"
      }
    ] %>

    <% project_stats.each do |stat| %>

      <div class="col-6 col-xl-3">

        <div class="border rounded-3 px-3 py-2 h-100">

          <div class="d-flex align-items-center justify-content-between gap-2">

            <span class="small text-body-secondary">
              <%= stat[:label] %>
            </span>

            <i class="fa-solid <%= stat[:icon] %> <%= stat[:color] %>"></i>

          </div>

          <div class="fs-4 fw-semibold mt-1">
            <%= number_with_delimiter(stat[:value]) %>
          </div>

        </div>

      </div>

    <% end %>

  </div>

  <div class="d-flex justify-content-between align-items-center mb-2">

    <h3 class="h6 mb-0">Projects to Follow Up</h3>

    <small class="text-body-secondary">
      Showing <%= @cardex_project_rows.size %>
      of <%= @cardex_project_rows_total %>
    </small>

  </div>

  <% if @cardex_project_rows.any? %>

    <div class="table-responsive">

      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Project</th>
            <th>Attention</th>
            <th>Last Updated</th>
            <th class="text-end">Quick Links</th>
          </tr>
        </thead>

        <tbody>

          <% @cardex_project_rows.each do |row| %>

            <% project = row[:project] %>
            <% customer = row[:customer] %>

            <tr>

              <td style="min-width: 160px;">

                <%= link_to project.number,
                    project_path(project),
                    class: "fw-semibold text-decoration-none" %>

                <% if project.name.present? %>
                  <div class="small text-body-secondary">
                    <%= project.name %>
                  </div>
                <% elsif customer.present? %>
                  <div class="small text-body-secondary">
                    <%= customer.nickname %>
                  </div>
                <% end %>

              </td>

              <td style="min-width: 230px;">

                <div class="d-flex flex-wrap gap-1">

                  <% if row[:pending_logistics] %>

                    <span class="badge bg-warning-subtle text-warning-emphasis">
                      Logistics
                      <% if row[:pending_booking_count].positive? %>
                        · <%= row[:pending_booking_count] %>
                      <% end %>
                    </span>

                  <% elsif row[:logistics_open] %>

                    <span class="badge bg-warning-subtle text-warning-emphasis">
                      Logistics open
                    </span>

                  <% end %>

                  <% if row[:pending_payment_count].positive? %>

                    <span class="badge bg-info-subtle text-info">
                      Pending PO · <%= row[:pending_payment_count] %>
                    </span>

                    <% if row[:shared_payment_count].positive? %>
                      <span class="badge bg-light text-secondary border">
                        <%= row[:shared_payment_count] %> shared
                      </span>
                    <% end %>

                  <% end %>

                  <% if row[:unpaid_ci_count].positive? %>

                    <span class="badge bg-danger-subtle text-danger">
                      Unpaid CI · <%= row[:unpaid_ci_count] %>
                    </span>

                  <% end %>

                  <% if row[:sales_open] %>

                    <span class="badge bg-light text-secondary border">
                      Sales open
                    </span>

                  <% end %>

                  <% unless row[:needs_attention] || row[:unfinished] %>

                    <span class="badge bg-light text-secondary border">
                      Recently updated
                    </span>

                  <% end %>

                </div>

              </td>

              <td class="text-nowrap">

                <div class="small fw-medium">
                  <%= time_ago_in_words(project.updated_at) %> ago
                </div>

                <small class="text-body-secondary">
                  <%= project.updated_at&.strftime("%d %b %Y") %>
                </small>

              </td>

              <td class="text-end text-nowrap">

                <%= link_to project_path(project),
                    class: "btn btn-sm btn-light border",
                    title: "Open project" do %>
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <% end %>

                <% if project.bookings.any? %>

                  <%= link_to project_bookings_path(project),
                      class: "btn btn-sm btn-light border",
                      title: "Open bookings" do %>
                    <i class="fa-solid fa-truck"></i>
                  <% end %>

                <% end %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="text-center py-4">

      <i class="fa-solid fa-check-circle text-success fs-3"></i>

      <p class="fw-medium mt-2 mb-1">
        No project follow-ups
      </p>

      <p class="small text-body-secondary mb-0">
        No unfinished or recently updated projects were found.
      </p>

    </div>

  <% end %>

  <div class="mt-3">
    <small class="text-body-secondary">
      Pending supplier Payment Orders may be shared across projects.
      They are marked as shared rather than treated as project-exclusive.
    </small>
  </div>

</section>