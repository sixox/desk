<%
  project_stats = [
    {
      label: "Pending Logistics",
      value: @cardex_pending_logistics_count,
      note: "Projects to follow up",
      icon: "fa-truck-fast",
      color: "c2"
    },
    {
      label: "Pending PO",
      value: @cardex_pending_payment_count,
      note: "Projects with pending orders",
      icon: "fa-money-bill-transfer",
      color: "c1"
    },
    {
      label: "Unpaid CI",
      value: @cardex_unpaid_ci_count,
      note: "Projects with unpaid invoices",
      icon: "fa-file-invoice",
      color: "c3"
    },
    {
      label: "Unfinished",
      value: @cardex_unfinished_project_count,
      note: "Sales or logistics still open",
      icon: "fa-list-check",
      color: "c4"
    }
  ]
%>

<section class="cardex-project-operations mb-3">

  <!-- HEADER -->

  <header class="cardex-project-operations__header">

    <div class="project-trading-overview__identity">

      <div class="project-trading-overview__icon">
        <i class="fa-solid fa-diagram-project"></i>
      </div>

      <div>
        <h2>Project Operations</h2>
        <p>
          Company-wide projects requiring attention
        </p>
      </div>

    </div>


    <nav class="cardex-project-operations__actions">

      <%= link_to projects_path, class: "m-btn m-btn--ghost" do %>
        <i class="fa-solid fa-folder-open me-1"></i>
        All Projects
      <% end %>

      <%= link_to release_requests_path, class: "m-btn m-btn--ghost" do %>
        <i class="fa-solid fa-file-signature me-1"></i>
        Releases
      <% end %>

    </nav>

  </header>


  <!-- OPERATIONAL INDICATORS -->

  <div class="row row-tight cardex-project-operations__stats">

    <% project_stats.each do |stat| %>

      <div class="col-6 col-xl-3">

        <article class="stat-card h-100">

          <div class="stat-card__head">

            <p class="stat-card__label">
              <%= stat[:label] %>
            </p>

            <span class="stat-card__icon stat-card__icon--<%= stat[:color] %>">
              <i class="fa-solid <%= stat[:icon] %>"></i>
            </span>

          </div>

          <p class="stat-card__value">
            <%= number_with_delimiter(stat[:value]) %>
          </p>

          <p class="stat-card__delta">
            <%= stat[:note] %>
          </p>

        </article>

      </div>

    <% end %>

  </div>


  <!-- PRIORITY PROJECTS -->

  <div class="cardex-project-operations__list-header">

    <div>
      <h3>Projects to Follow Up</h3>
      <p>Attention items first, followed by recent activity</p>
    </div>

    <span>
      <%= @cardex_project_rows.size %>
      / <%= @cardex_project_rows_total %>
    </span>

  </div>


  <% if @cardex_project_rows.any? %>

    <div class="row g-3">

      <% @cardex_project_rows.each do |row| %>

        <div class="col-12 col-md-6 col-xl-4">

          <%= render "projects/project_card",
            project: row[:project],
            attention: row,
            cardex: true %>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="project-trading-overview__empty">

      <i class="fa-solid fa-circle-check"></i>

      <div>
        <strong>No project follow-ups</strong>
        <span>There are no recent or unfinished projects to display.</span>
      </div>

    </div>

  <% end %>


  <footer class="cardex-project-operations__footer">
    <i class="fa-solid fa-circle-info"></i>
    Shared supplier Payment Orders can relate to several projects.
    They remain identified as shared in the project cards.
  </footer>

</section>