<div class="card border-0 shadow-sm mb-4">
  <div class="card-body text-center py-4">

    <%= image_tag "dmu1.jpeg",
      alt: "Avatar",
      class: "rounded-circle border mb-3",
      style: "width: 90px; height: 90px; object-fit: cover;" %>

    <h6 class="fw-semibold mb-1"><%= user.name.titleize %></h6>

    <small class="text-muted d-block mb-4">
      <%= user.role.capitalize %> ·
      <%= user.is_manager ? "Manager" : "Expert" %>
    </small>

    <div class="d-grid gap-2">

      <%= link_to new_vacation_path,
          data: { controller: "bs-modal-form" },
          class: "btn btn-sm btn-outline-dark" do %>
        <i class="bi bi-calendar-plus me-1"></i>
        Vacation
      <% end %>

      <%= link_to new_remote_day_path,
          data: { controller: "bs-modal-form" },
          class: "btn btn-sm btn-outline-dark" do %>
        <i class="bi bi-house-door me-1"></i>
        Remote Day
      <% end %>

      <%= link_to new_mission_path,
          data: { controller: "bs-modal-form" },
          class: "btn btn-sm btn-outline-dark" do %>
        <i class="bi bi-briefcase me-1"></i>
        Mission
      <% end %>

      <%= link_to new_manual_entry_path,
          class: "btn btn-sm btn-outline-dark" do %>
        <i class="bi bi-box-arrow-in-right me-1"></i>
        Manual Entry
      <% end %>

      <%= link_to new_overtime_entry_path,
          class: "btn btn-sm btn-outline-dark" do %>
        <i class="bi bi-clock-history me-1"></i>
        Overtime
      <% end %>

    </div>

  </div>
</div>