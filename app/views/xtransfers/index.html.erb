<div class="col-lg-10 mx-auto mt-5">

  <div class="xtransfer-page">
    <div class="container-fluid py-3">

      <div class="xtransfer-header d-flex justify-content-between align-items-center">
        <div>
          <h5 class="xtransfer-title">Transfers</h5>

          <div class="xtransfer-subtitle">
            <%= @xtransfers.size %> transfers
          </div>
        </div>

        <%= link_to new_xtransfer_path,
        data: { controller: "bs-modal-form" },
        class: "btn btn-success xtransfer-create" do %>
        <i class="bi bi-plus-lg me-1"></i>
        Create Transfer
        <% end %>
      </div>


      <div class="xtransfer-card">

        <div class="table-responsive">

          <table class="table table-striped xtransfer-table align-middle mb-0">

            <thead>
              <tr>
                <th>Sender</th>
                <th>Receiver</th>
                <th>Sent</th>
                <th>Received</th>
                <th>Rate</th>
                <th>Exchanges</th>
                <th>Status</th>
                <th>Attach</th>
                <th>Pending</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>


            <tbody id="xtransfers">

              <% if @xtransfers.any? %>

              <% @xtransfers.each do |transfer| %>

              <tr id="<%= dom_id(transfer) %>">

                <!-- Sender -->

                <td>
                  <div
                  class="account-name text-truncate"
                  style="max-width: 19ch;"
                  title="<%= transfer.sender_account.organization.name %>"
                  >
                  <%= transfer.sender_account.organization.name %>
                </div>

                <span
                class="account-number d-inline-block text-truncate"
                style="max-width: 19ch;"
                title="<%= transfer.sender_account.number %>"
                >
                <%= transfer.sender_account.number %>
              </span>
            </td>


            <!-- Receiver -->

            <td>
              <div
              class="account-name text-truncate"
              style="max-width: 19ch;"
              title="<%= transfer.receiver_account.organization.name %>"
              >
              <%= transfer.receiver_account.organization.name %>
            </div>

            <span
            class="account-number d-inline-block text-truncate"
            style="max-width: 19ch;"
            title="<%= transfer.receiver_account.number %>"
            >
            <%= transfer.receiver_account.number %>
          </span>
        </td>







        <!-- Sent Amount -->

        <td>
          <span class="amount-value text-danger">
            <%= number_with_delimiter(transfer.sent_amount) %>
          </span>
          <span class="currency-inline">

            <%= transfer.sender_currency.name %>
          </span>
        </td>


        <!-- Receive Amount -->

        <td>
          <span class="amount-value text-success">
            <%= number_with_delimiter(transfer.receive_amount) %>
          </span>
          <span class="currency-inline">

            <%= transfer.receiver_currency.name %>
          </span>
        </td>


        <!-- Rate -->

        <td>
          <span class="rate-value">
            <%= transfer.exchange_rate %>
          </span>
        </td>
        <!-- Exchanges -->

        <td>
          <% if transfer.exchanges.any? %>

          <div class="d-flex flex-column gap-1">

            <% transfer.exchanges.each do |exchange| %>

            <%= link_to exchange_path(exchange),
            data: { turbo_stream: true },
            class: "text-decoration-none" do %>

            <span class="badge bg-light text-dark border">
              <%= exchange.sell_currency.name %>
              →
              <%= exchange.buy_currency.name %>
            </span>

            <% end %>

            <% end %>

          </div>

          <% else %>

          <span class="text-muted small">
            -
          </span>

          <% end %>
        </td>


        <!-- Status -->

        <td>
          <span class="status-value">
            <%= transfer.status %>
          </span>
        </td>

        <td>
          <% if transfer.documents.attached? %>

          <span class="badge bg-light text-dark">
            <i class="bi bi-paperclip"></i>
            <%= transfer.documents.count %>
          </span>

          <% else %>

          <span class="text-muted">—</span>

          <% end %>
        </td>



        <!-- Pending -->

        <td>
          <%= button_to(
            toggle_pending_xtransfer_path(transfer),
            method: :patch,
            class: "xt-pending-toggle #{transfer.pending? ? 'is-pending' : 'is-not-pending'}",
              title: transfer.pending? ? "Click to unset pending" : "Click to set pending"
              ) do %>

              <span class="xt-pending-dot"></span>

              <span>
                <%= transfer.pending? ? "Pending" : "Not pending" %>
              </span>

              <% end %>
            </td>


            <!-- Actions -->

            <td class="text-end">

              <div class="xt-actions">



                <%= link_to edit_xtransfer_path(transfer),
                data: { controller: "bs-modal-form" },
                class: "btn btn-sm btn-outline-secondary xt-action" do %>
                <span>Edit</span>
                <i class="bi bi-pencil ms-1"></i>
                <% end %>

                <%= button_to(
                  xtransfer_path(transfer),
                  method: :delete,
                  class: "btn btn-sm btn-outline-danger xt-action",
                    form: {
                      data: {
                        turbo_confirm: "Delete this transfer?"
                      }
                    }
                    ) do %>
                    <i class="bi bi-trash3"></i>
                    <% end %>

                  </div>

                </td>

              </tr>

              <% end %>

              <% else %>

              <tr>

                <td colspan="10" class="xtransfer-empty">

                  <div class="xtransfer-empty-icon">
                    <i class="bi bi-arrow-left-right"></i>
                  </div>

                  <div class="xtransfer-empty-title">
                    No transfers yet
                  </div>

                  <div class="small mt-1">
                    Create your first transfer to get started.
                  </div>

                </td>

              </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>
  </div>
</div>

<%= turbo_frame_tag "modal" %>