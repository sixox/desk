<%
  send_movement =
    transfer.money_movements.find { |movement| movement.direction == "send" }

  receive_movement =
    transfer.money_movements.find { |movement| movement.direction == "receive" }

  send_account = send_movement&.xaccount
  receive_account = receive_movement&.xaccount

  send_currency = send_movement&.currency
  receive_currency = receive_movement&.currency

  send_to_currency = send_movement&.to_currency
  receive_to_currency = receive_movement&.to_currency
%>

<!-- ================================================== -->
<!-- TRANSFER CARD -->
<!-- ================================================== -->

<article
  id="<%= dom_id(transfer) %>"
  class="xt-transfer-card <%= 'is-pending' if transfer.pending? %>"
>

  <!-- ================================================= -->
  <!-- CARD HEADER -->
  <!-- ================================================= -->

  <div class="xt-transfer-card-header">

    <div class="xt-transfer-meta">

      <div class="xt-transfer-id">

        <%= link_to xtransfer_path(transfer), class: "link-nodecor-po" do %>

          <h5 class="link-nodecor-po">
            Transfer
            <span class="text-danger">
              <%= transfer.id %>
            </span>
          </h5>

        <% end %>

      </div>

      <span class="xt-transfer-date">

        <i class="bi bi-calendar3"></i>

        <%= (transfer.created_at + 3.5.hours).strftime("%d %b %Y") %>

        <span class="xt-date-separator">
          •
        </span>

        <%= (transfer.created_at + 3.5.hours).strftime("%H:%M") %>

      </span>

    </div>


    <div class="xt-transfer-header-right">

      <% status = transfer.status.to_s.downcase %>

      <%
        status_class =
          case status
          when "completed"
            "xt-status-completed"
          when "cancelled"
            "xt-status-cancelled"
          else
            "xt-status-default"
          end

        status_label =
          case status
          when "completed"
            "Completed"
          when "cancelled"
            "Cancelled"
          when "pending"
            "Pending"
          when ""
            "No status"
          else
            transfer.status.to_s
          end
      %>

      <span class="xt-status-badge <%= status_class %>">
        <span class="xt-status-dot"></span>
        <%= status_label %>
      </span>


      <% if transfer.pending? %>

        <span class="xt-pending-badge">
          <i class="bi bi-clock"></i>
          Pending
        </span>

      <% end %>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- MAIN TRANSFER -->
  <!-- ================================================= -->

  <div class="xt-transfer-main">

    <!-- ================================================= -->
    <!-- SEND MOVEMENT -->
    <!-- ================================================= -->

    <div class="xt-transfer-party xt-transfer-sender">

      <div class="xt-party-top">

        <div class="xt-party-direction xt-direction-sender">
          <i class="bi bi-arrow-up-right"></i>
        </div>

        <span class="xt-party-label">
          Sender
        </span>

      </div>


      <% if send_account.present? %>

        <div
          class="xt-party-organization"
          title="<%= send_account.organization&.name %>"
        >

          <% if send_account.organization.present? %>

            <%= link_to(
              send_account.organization.name,
              organization_path(send_account.organization),
              class: "link-nodecor-po"
            ) %>

          <% else %>

            —
            
          <% end %>

        </div>


        <div
          class="xt-party-account"
          title="<%= send_account.number %>"
        >

          <i class="bi bi-credit-card-2-front"></i>

          <%= link_to(
            send_account.number,
            xaccount_path(send_account),
            class: "link-nodecor-po text-muted"
          ) %>

        </div>

      <% else %>

        <div class="xt-party-organization">
          —
        </div>

        <div class="xt-party-account text-muted">
          No account
        </div>

      <% end %>


      <div class="xt-party-amount xt-amount-sender">

        <span>
          <%= number_with_delimiter(send_movement&.amount || 0) %>
        </span>

        <small>
          <%= send_currency&.name || "—" %>
        </small>

      </div>

    </div>


    <!-- ================================================= -->
    <!-- TRANSFER FLOW -->
    <!-- ================================================= -->

    <div class="xt-transfer-flow">

      <div class="xt-flow-line"></div>

      <div class="xt-flow-icon">
        <i class="bi bi-arrow-right"></i>
      </div>

      <div class="xt-flow-line"></div>

    </div>


    <!-- ================================================= -->
    <!-- RECEIVE MOVEMENT -->
    <!-- ================================================= -->

    <div class="xt-transfer-party xt-transfer-receiver">

      <div class="xt-party-top">

        <div class="xt-party-direction xt-direction-receiver">
          <i class="bi bi-arrow-down-left"></i>
        </div>

        <span class="xt-party-label">
          Receiver
        </span>

      </div>


      <% if receive_account.present? %>

        <div
          class="xt-party-organization"
          title="<%= receive_account.organization&.name %>"
        >

          <% if receive_account.organization.present? %>

            <%= link_to(
              receive_account.organization.name,
              organization_path(receive_account.organization),
              class: "link-nodecor-po"
            ) %>

          <% else %>

            —

          <% end %>

        </div>


        <div
          class="xt-party-account"
          title="<%= receive_account.number %>"
        >

          <i class="bi bi-credit-card-2-front"></i>

          <%= link_to(
            receive_account.number,
            xaccount_path(receive_account),
            class: "link-nodecor-po text-muted"
          ) %>

        </div>

      <% else %>

        <div class="xt-party-organization">
          —
        </div>

        <div class="xt-party-account text-muted">
          No account
        </div>

      <% end %>


      <div class="xt-party-amount xt-amount-receiver">

        <span>
          <%= number_with_delimiter(receive_movement&.amount || 0) %>
        </span>

        <small>
          <%= receive_currency&.name || "—" %>
        </small>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- QUICK INFORMATION -->
  <!-- ================================================= -->

  <div class="xt-transfer-quick-info">

    <!-- SEND TOTAL -->

    <div class="xt-quick-item">

      <span class="xt-quick-label">
        Send total
      </span>

      <strong>

        <%= number_with_delimiter(send_movement&.total || 0) %>

        <small>
          <%= send_to_currency&.name || send_currency&.name || "" %>
        </small>

      </strong>

    </div>


    <!-- RECEIVE TOTAL -->

    <div class="xt-quick-item">

      <span class="xt-quick-label">
        Receive total
      </span>

      <strong>

        <%= number_with_delimiter(receive_movement&.total || 0) %>

        <small>
          <%= receive_to_currency&.name || receive_currency&.name || "" %>
        </small>

      </strong>

    </div>


    <!-- CONVERSION -->

    <div class="xt-quick-item">

      <span class="xt-quick-label">
        Conversion
      </span>

      <strong class="xt-conversion-summary">

        <% if send_movement&.exchange_rate.present? %>

          <%= send_movement.exchange_rate %>

          <span>

            <%= send_currency&.name || "—" %>

            →

            <%= send_to_currency&.name || send_currency&.name || "—" %>

          </span>

        <% else %>

          <span class="xt-no-conversion">
            No conversion
          </span>

        <% end %>

      </strong>

    </div>


    <!-- MOVEMENTS -->

    <div class="xt-quick-item">

      <span class="xt-quick-label">
        Movements
      </span>

      <strong>

        <span class="xt-count-badge">
          <%= transfer.money_movements.count %>
        </span>

      </strong>

    </div>


    <!-- DOCUMENTS -->

    <div class="xt-quick-item">

      <span class="xt-quick-label">
        Documents
      </span>

      <strong>

        <% if transfer.documents.attached? %>

          <span class="xt-count-badge xt-count-files">
            <i class="bi bi-paperclip"></i>
            <%= transfer.documents.count %>
          </span>

        <% else %>

          <span class="xt-no-data">
            None
          </span>

        <% end %>

      </strong>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- SHOW MORE -->
  <!-- ================================================= -->

  <details
    class="xt-transfer-details"
    <%= "open" if action_name == "show" %>
  >

    <summary class="xt-details-summary">

      <span>
        <i class="bi bi-sliders2"></i>
        Transfer details
      </span>

      <i class="bi bi-chevron-down xt-details-chevron"></i>

    </summary>


    <div class="xt-details-content">

      <!-- ============================================= -->
      <!-- MOVEMENT DETAILS -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-arrow-left-right"></i>

          Money Movements

        </div>


        <div class="xt-financial-grid">

          <!-- SEND -->

          <div class="xt-financial-card">

            <div class="xt-financial-title">
              Send
            </div>


            <div class="xt-financial-row">

              <span>
                Account
              </span>

              <strong>
                <%= send_account&.number || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Amount
              </span>

              <strong>

                <%= number_with_delimiter(send_movement&.amount || 0) %>

                <%= send_currency&.name || "—" %>

              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Converted
              </span>

              <strong class="text-success">

                <%= number_with_delimiter(send_movement&.amount_to || 0) %>

                <%= send_to_currency&.name || send_currency&.name || "—" %>

              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Exchange rate
              </span>

              <strong>
                <%= send_movement&.exchange_rate.presence || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Charge
              </span>

              <strong>
                <%= number_with_delimiter(send_movement&.charge || 0) %>
              </strong>

            </div>


            <div class="xt-financial-total">

              <span>
                Total
              </span>

              <strong>

                <%= number_with_delimiter(send_movement&.total || 0) %>

                <%= send_to_currency&.name || send_currency&.name || "—" %>

              </strong>

            </div>

          </div>


          <!-- RECEIVE -->

          <div class="xt-financial-card">

            <div class="xt-financial-title">
              Receive
            </div>


            <div class="xt-financial-row">

              <span>
                Account
              </span>

              <strong>
                <%= receive_account&.number || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Amount
              </span>

              <strong>

                <%= number_with_delimiter(receive_movement&.amount || 0) %>

                <%= receive_currency&.name || "—" %>

              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Converted
              </span>

              <strong class="text-primary">

                <%= number_with_delimiter(receive_movement&.amount_to || 0) %>

                <%= receive_to_currency&.name || receive_currency&.name || "—" %>

              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Exchange rate
              </span>

              <strong>
                <%= receive_movement&.exchange_rate.presence || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Charge
              </span>

              <strong>
                <%= number_with_delimiter(receive_movement&.charge || 0) %>
              </strong>

            </div>


            <div class="xt-financial-total">

              <span>
                Total
              </span>

              <strong>

                <%= number_with_delimiter(receive_movement&.total || 0) %>

                <%= receive_to_currency&.name || receive_currency&.name || "—" %>

              </strong>

            </div>

          </div>

        </div>

      </div>


      <!-- ============================================= -->
      <!-- ACCOUNTING -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-journal-text"></i>

          Accounting

        </div>


        <div class="xt-financial-grid">

          <!-- DEBIT -->

          <div class="xt-financial-card">

            <div class="xt-financial-title">
              Send / Debit
            </div>


            <div class="xt-financial-row">

              <span>
                Account
              </span>

              <strong>
                <%= send_account&.number || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Currency
              </span>

              <strong>
                <%= send_currency&.name || "—" %>
              </strong>

            </div>


            <div class="xt-financial-total">

              <span>
                Debit
              </span>

              <strong>

                <%= number_with_delimiter(send_movement&.total || 0) %>

              </strong>

            </div>

          </div>


          <!-- CREDIT -->

          <div class="xt-financial-card">

            <div class="xt-financial-title">
              Receive / Credit
            </div>


            <div class="xt-financial-row">

              <span>
                Account
              </span>

              <strong>
                <%= receive_account&.number || "—" %>
              </strong>

            </div>


            <div class="xt-financial-row">

              <span>
                Currency
              </span>

              <strong>
                <%= receive_currency&.name || "—" %>
              </strong>

            </div>


            <div class="xt-financial-total">

              <span>
                Credit
              </span>

              <strong>

                <%= number_with_delimiter(receive_movement&.total || 0) %>

              </strong>

            </div>

          </div>

        </div>

      </div>


      <!-- ============================================= -->
      <!-- RELATED EXCHANGES -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-link-45deg"></i>

          Related Exchanges

        </div>


        <% if transfer.exchanges.any? %>

          <div class="xt-exchange-list">

            <% transfer.exchanges.each do |exchange| %>

              <%
                exchange_sell =
                  exchange.exchange_movements.find do |movement|
                    movement.direction == "sell"
                  end

                exchange_buy =
                  exchange.exchange_movements.find do |movement|
                    movement.direction == "buy"
                  end
              %>

              <%= link_to exchange_path(exchange),
                  data: { turbo_stream: true },
                  class: "xt-exchange-chip" do %>

                <span class="xt-exchange-chip-id">
                  #<%= exchange.id %>
                </span>

                <span>
                  <%= exchange_sell&.currency&.name || "—" %>
                </span>

                <i class="bi bi-arrow-right"></i>

                <span>
                  <%= exchange_buy&.currency&.name || "—" %>
                </span>

                <i class="bi bi-chevron-right"></i>

              <% end %>

            <% end %>

          </div>

        <% else %>

          <div class="xt-details-empty">

            <i class="bi bi-link-45deg"></i>

            No related exchanges

          </div>

        <% end %>

      </div>


      <!-- ============================================= -->
      <!-- DOCUMENTS -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-paperclip"></i>

          Attachments

        </div>


        <% if transfer.documents.attached? %>

          <div class="xt-document-list">

            <% transfer.documents.each do |document| %>

              <%= link_to(
                rails_blob_path(
                  document,
                  disposition: "attachment"
                ),
                target: "_blank",
                class: "xt-document-item"
              ) do %>

                <span class="xt-document-icon">
                  <i class="bi bi-file-earmark-text"></i>
                </span>


                <span class="xt-document-info">

                  <strong title="<%= document.filename.to_s %>">
                    <%= document.filename.to_s %>
                  </strong>

                  <small>
                    <%= number_to_human_size(document.byte_size) %>
                  </small>

                </span>


                <i class="bi bi-box-arrow-up-right xt-document-open"></i>

              <% end %>

            <% end %>

          </div>

        <% else %>

          <div class="xt-details-empty">

            <i class="bi bi-paperclip"></i>

            No attachments

          </div>

        <% end %>

      </div>

    </div>

  </details>


  <!-- ================================================= -->
  <!-- CARD FOOTER -->
  <!-- ================================================= -->

  <div class="xt-transfer-card-footer">

    <div class="xt-footer-left">

      <% if transfer.pending? %>

        <%= button_to(
          toggle_pending_xtransfer_path(transfer),
          method: :patch,
          class: "xt-pending-toggle is-pending",
          title: "Click to unset pending"
        ) do %>

          <span class="xt-pending-dot"></span>

          <span>
            Pending
          </span>

        <% end %>

      <% else %>

        <%= button_to(
          toggle_pending_xtransfer_path(transfer),
          method: :patch,
          class: "xt-pending-toggle is-not-pending",
          title: "Click to set pending"
        ) do %>

          <span class="xt-pending-dot"></span>

          <span>
            Mark pending
          </span>

        <% end %>

      <% end %>

    </div>


    <div class="xt-card-actions">

      <%= link_to(
        edit_xtransfer_path(transfer),
        data: { controller: "bs-modal-form" },
        class: "xt-card-action xt-card-action-edit",
        title: "Edit transfer"
      ) do %>

        <i class="bi bi-pencil"></i>

        <span>
          Edit
        </span>

      <% end %>


      <%= button_to(
        xtransfer_path(transfer),
        method: :delete,
        class: "xt-card-action xt-card-action-delete",
        title: "Delete transfer",
        form: {
          data: {
            turbo_confirm: "Delete transfer ##{transfer.id}?"
          }
        }
      ) do %>

        <i class="bi bi-trash3"></i>

        <span>
          Delete
        </span>

      <% end %>

    </div>

  </div>

</article>