<%
  movements =
    transfer.money_movements
      .reject(&:marked_for_destruction?)

  sends =
    movements.select { |movement| movement.direction == "send" }

  receives =
    movements.select { |movement| movement.direction == "receive" }

  first_send = sends.first
  first_receive = receives.first

  conversion_movement =
    sends.find { |movement| movement.exchange_rate.present? } ||
    receives.find { |movement| movement.exchange_rate.present? }

  status = transfer.status.to_s.downcase

  status_class =
    case status
    when "completed"
      "xt-status-completed"
    when "cancelled"
      "xt-status-cancelled"
    else
      "xt-status-default"
    end

  

  status_label =
    case status
    when "completed"
      "Completed"
    when "cancelled"
      "Cancelled"
    when "pending"
      "Pending"
    when ""
      "No status"
    else
      transfer.status.to_s
    end
%>


<!-- ================================================== -->
<!-- TRANSFER CARD -->
<!-- ================================================== -->

<article
  id="<%= dom_id(transfer) %>"
  class="xt-transfer-card <%= 'is-pending' if transfer.pending? %>"
>


  <!-- ================================================= -->
  <!-- HEADER -->
  <!-- ================================================= -->

  <div class="xt-transfer-card-header" style="background: #e5e5782b;">

    <div class="xt-transfer-meta">

      <div class="xt-transfer-id">

        <%= link_to(
          xtransfer_path(transfer),
          class: "link-nodecor-po"
        ) do %>

          <h5 class="link-nodecor-po mb-0">

            Transfer

            <span class="text-danger">
              <%= transfer.id %>
            </span>

          </h5>

        <% end %>

      </div>


      <span class="xt-transfer-date">

        <i class="bi bi-calendar3"></i>

        <%= (transfer.created_at + 3.5.hours).strftime("%d %b %Y") %>

        <span class="xt-date-separator">
          •
        </span>

        <%= (transfer.created_at + 3.5.hours).strftime("%H:%M") %>

      </span>

    </div>


    <div class="xt-transfer-header-right">

      <span class="xt-status-badge <%= status_class %>">

        <span class="xt-status-dot"></span>

        <%= status_label %>

      </span>


      <% if transfer.pending? %>

        <span class="xt-pending-badge">

          <i class="bi bi-clock"></i>

          Pending

        </span>

      <% end %>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- MAIN TRANSFER -->
  <!-- ================================================= -->

  <div class="xt-transfer-main align-items-start">


    <!-- ================================================= -->
    <!-- SEND SIDE -->
    <!-- ================================================= -->

    <div class="xt-transfer-party xt-transfer-sender">

      <div class="xt-party-top">

        <div class="xt-party-direction xt-direction-sender">
          <i class="bi bi-arrow-up-right"></i>
        </div>

        <span class="xt-party-label">
          Sender
        </span>

      </div>


      <div class="d-flex flex-column gap-3">


        <% if sends.present? %>


          <% sends.each_with_index do |movement, index| %>

            <div class="d-flex align-items-center justify-content-between gap-3">


              <!-- MOVEMENT INFO -->

              <div class="d-flex align-items-center gap-2 min-w-0">


                <% if sends.size > 1 %>

                  <span class="badge rounded-pill text-bg-danger flex-shrink-0">
                    <%= index + 1 %>
                  </span>

                <% end %>


                <div
                  class="xt-party-organization text-truncate"
                  title="<%= movement.xaccount&.organization&.name %>"
                >

                  <% if movement.xaccount&.organization.present? %>

                    <%= link_to(
                      movement.xaccount.organization.name,
                      organization_path(
                        movement.xaccount.organization
                      ),
                      class: "link-nodecor-po"
                    ) %>

                  <% else %>

                    —

                  <% end %>

                </div>


                <span
                  class="xt-party-account text-nowrap"
                  title="<%= movement.xaccount&.number %>"
                >

                  <i class="bi bi-credit-card-2-front"></i>

                  <% if movement.xaccount.present? %>

                    <%= link_to(
                      movement.xaccount.number,
                      xaccount_path(movement.xaccount),
                      class: "link-nodecor-po text-muted"
                    ) %>

                  <% else %>

                    No account

                  <% end %>

                </span>

              </div>


              <!-- AMOUNT -->

              <div class="xt-party-amount xt-amount-sender text-nowrap">

                <span>
                  <%= number_with_delimiter(movement.amount || 0) %>
                </span>

                <small>
                  <%= movement.currency&.name || "—" %>
                </small>

              </div>


            </div>

          <% end %>


        <% else %>


          <div class="text-muted">
            No send movement
          </div>


        <% end %>


      </div>

    </div>


    <!-- ================================================= -->
    <!-- TRANSFER FLOW -->
    <!-- ================================================= -->

<div
  class="xt-transfer-flow align-self-center d-flex flex-column align-items-center"
  title="<%= conversion_movement&.exchange_rate.present? ? 'Exchange rate' : 'Transfer' %>"
>

  <div class="xt-flow-line"></div>


  <div class="xt-flow-icon flex-shrink-0" style="background: #ebf380;">

    <i class="bi bi-arrow-right"></i>

  </div>


  <% if conversion_movement&.exchange_rate.present? %>

    <div class="d-flex flex-column align-items-center mt-2 text-center" style="font-size: 9px;">

      <strong class="small text-muted">
        <%= conversion_movement.exchange_rate %>
      </strong>

      <span class="small text-muted text-nowrap">

        <%= conversion_movement.currency&.name || "—" %>

        →

        <%= conversion_movement.to_currency&.name ||
            conversion_movement.currency&.name ||
            "—" %>

      </span>

    </div>

  <% end %>


  <div class="xt-flow-line"></div>

</div>



    <!-- ================================================= -->
    <!-- RECEIVE SIDE -->
    <!-- ================================================= -->

    <div class="xt-transfer-party xt-transfer-receiver">


      <div class="xt-party-top justify-content-end">

        <div class="xt-party-direction xt-direction-receiver">
          <i class="bi bi-arrow-down-left"></i>
        </div>

        <span class="xt-party-label">
          Receiver
        </span>

      </div>


      <div class="d-flex flex-column gap-3">


        <% if receives.present? %>


          <% receives.each_with_index do |movement, index| %>

            <div class="d-flex align-items-center justify-content-between gap-3">


              <!-- AMOUNT -->

              <div class="xt-party-amount xt-amount-receiver text-nowrap">

                <span>
                  <%= number_with_delimiter(movement.amount || 0) %>
                </span>

                <small>
                  <%= movement.currency&.name || "—" %>
                </small>

              </div>


              <!-- MOVEMENT INFO -->

              <div class="d-flex align-items-center justify-content-end gap-2 min-w-0">


                <span
                  class="xt-party-account text-nowrap"
                  title="<%= movement.xaccount&.number %>"
                >

                  <i class="bi bi-credit-card-2-front"></i>

                  <% if movement.xaccount.present? %>

                    <%= link_to(
                      movement.xaccount.number,
                      xaccount_path(movement.xaccount),
                      class: "link-nodecor-po text-muted"
                    ) %>

                  <% else %>

                    No account

                  <% end %>

                </span>


                <div
                  class="xt-party-organization text-truncate"
                  title="<%= movement.xaccount&.organization&.name %>"
                >

                  <% if movement.xaccount&.organization.present? %>

                    <%= link_to(
                      movement.xaccount.organization.name,
                      organization_path(
                        movement.xaccount.organization
                      ),
                      class: "link-nodecor-po"
                    ) %>

                  <% else %>

                    —

                  <% end %>

                </div>


                <% if receives.size > 1 %>

                  <span class="badge rounded-pill text-bg-success flex-shrink-0">
                    <%= index + 1 %>
                  </span>

                <% end %>


              </div>


            </div>

          <% end %>


        <% else %>


          <div class="text-muted text-end">
            No receive movement
          </div>


        <% end %>


      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- COMPACT ATTACHMENTS -->
  <!-- ================================================= -->

  <% if transfer.documents.attached? %>

    <div class="d-flex align-items-center justify-content-center gap-5 mt-3">

      


      <% transfer.documents.each_with_index do |document, index| %>

        <%= link_to(
          rails_blob_path(
            document,
            disposition: "attachment"
          ),
          target: "_blank",
          class: "badge rounded-pill text-bg-light border text-decoration-none",
          title: document.filename.to_s
        ) do %>

          <%= index + 1 %>

          <i class="bi bi-paperclip text-muted"></i>

        <% end %>

      <% end %>

    </div>

  <% end %>


  <!-- ================================================= -->
  <!-- DETAILS -->
  <!-- ================================================= -->

  <details
    class="xt-transfer-details mt-3"
    <%= "open" if action_name == "show" %>
  >

    <summary class="xt-details-summary">

      <span>

        <i class="bi bi-sliders2"></i>

        Transfer details

      </span>

      <i class="bi bi-chevron-down xt-details-chevron"></i>

    </summary>


    <div class="xt-details-content">


      <!-- ============================================= -->
      <!-- MONEY MOVEMENTS -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-arrow-left-right"></i>

          Money Movements

        </div>


        <% if movements.present? %>

          <div class="d-flex flex-column gap-3">

            <% movements.each_with_index do |movement, index| %>

              <div class="xt-financial-card">


                <div class="d-flex align-items-center justify-content-between mb-2">

                  <div class="xt-financial-title">

                    <span
                      class="badge rounded-pill
                        <%= movement.direction == "send" ?
                            "text-bg-danger" :
                            "text-bg-success" %>"
                    >

                      <%= index + 1 %>

                    </span>


                    <%= movement.direction.to_s.humanize %>

                  </div>


                  <strong>

                    <%= number_with_delimiter(
                      movement.amount || 0
                    ) %>

                    <%= movement.currency&.name || "—" %>

                  </strong>

                </div>


                <div class="xt-financial-row">

                  <span>
                    Account
                  </span>

                  <strong>
                    <%= movement.xaccount&.number || "—" %>
                  </strong>

                </div>


                <div class="xt-financial-row">

                  <span>
                    Organization
                  </span>

                  <strong>
                    <%= movement.xaccount&.organization&.name || "—" %>
                  </strong>

                </div>


                <div class="xt-financial-row">

                  <span>
                    Converted
                  </span>

                  <strong>

                    <%= number_with_delimiter(
                      movement.amount_to || 0
                    ) %>

                    <%= movement.to_currency&.name ||
                        movement.currency&.name ||
                        "—" %>

                  </strong>

                </div>


                <div class="xt-financial-row">

                  <span>
                    Exchange rate
                  </span>

                  <strong>
                    <%= movement.exchange_rate.presence || "—" %>
                  </strong>

                </div>


                <div class="xt-financial-row">

                  <span>
                    Charge
                  </span>

                  <strong>
                    <%= number_with_delimiter(
                      movement.charge || 0
                    ) %>
                  </strong>

                </div>


                <div class="xt-financial-total">

                  <span>
                    Total
                  </span>

                  <strong>

                    <%= number_with_delimiter(
                      movement.total || 0
                    ) %>

                    <%= movement.to_currency&.name ||
                        movement.currency&.name ||
                        "—" %>

                  </strong>

                </div>


              </div>

            <% end %>

          </div>

        <% else %>

          <div class="xt-details-empty">

            <i class="bi bi-arrow-left-right"></i>

            No money movements

          </div>

        <% end %>

      </div>


      <!-- ============================================= -->
      <!-- ACCOUNTING -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-journal-text"></i>

          Accounting

        </div>


        <div class="xt-financial-grid">


          <!-- SEND -->

          <% sends.each do |movement| %>

            <div class="xt-financial-card">

              <div class="xt-financial-title">

                Send / Debit

              </div>


              <div class="xt-financial-row">

                <span>
                  Account
                </span>

                <strong>
                  <%= movement.xaccount&.number || "—" %>
                </strong>

              </div>


              <div class="xt-financial-row">

                <span>
                  Currency
                </span>

                <strong>
                  <%= movement.currency&.name || "—" %>
                </strong>

              </div>


              <div class="xt-financial-total">

                <span>
                  Debit
                </span>

                <strong>

                  <%= number_with_delimiter(
                    movement.total || 0
                  ) %>

                </strong>

              </div>

            </div>

          <% end %>


          <!-- RECEIVE -->

          <% receives.each do |movement| %>

            <div class="xt-financial-card">

              <div class="xt-financial-title">

                Receive / Credit

              </div>


              <div class="xt-financial-row">

                <span>
                  Account
                </span>

                <strong>
                  <%= movement.xaccount&.number || "—" %>
                </strong>

              </div>


              <div class="xt-financial-row">

                <span>
                  Currency
                </span>

                <strong>
                  <%= movement.currency&.name || "—" %>
                </strong>

              </div>


              <div class="xt-financial-total">

                <span>
                  Credit
                </span>

                <strong>

                  <%= number_with_delimiter(
                    movement.total || 0
                  ) %>

                </strong>

              </div>

            </div>

          <% end %>


        </div>

      </div>


      <!-- ============================================= -->
      <!-- RELATED EXCHANGES -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-link-45deg"></i>

          Related Exchanges

        </div>


        <% if transfer.exchanges.any? %>


          <div class="xt-exchange-list">

            <% transfer.exchanges.each do |exchange| %>


              <%
                exchange_sell =
                  exchange.exchange_movements.find do |movement|
                    movement.direction == "sell"
                  end

                exchange_buy =
                  exchange.exchange_movements.find do |movement|
                    movement.direction == "buy"
                  end
              %>


              <%= link_to(
                exchange_path(exchange),
                data: { turbo_stream: true },
                class: "xt-exchange-chip"
              ) do %>

                <span class="xt-exchange-chip-id">
                  #<%= exchange.id %>
                </span>


                <span>
                  <%= exchange_sell&.currency&.name || "—" %>
                </span>


                <i class="bi bi-arrow-right"></i>


                <span>
                  <%= exchange_buy&.currency&.name || "—" %>
                </span>


                <i class="bi bi-chevron-right"></i>

              <% end %>


            <% end %>

          </div>


        <% else %>


          <div class="xt-details-empty">

            <i class="bi bi-link-45deg"></i>

            No related exchanges

          </div>


        <% end %>

      </div>


      <!-- ============================================= -->
      <!-- DOCUMENTS -->
      <!-- ============================================= -->

      <div class="xt-details-section">

        <div class="xt-details-section-title">

          <i class="bi bi-paperclip"></i>

          Attachments

        </div>


        <% if transfer.documents.attached? %>


          <div class="xt-document-list">

            <% transfer.documents.each do |document| %>


              <%= link_to(
                rails_blob_path(
                  document,
                  disposition: "attachment"
                ),
                target: "_blank",
                class: "xt-document-item"
              ) do %>


                <span class="xt-document-icon">

                  <i class="bi bi-file-earmark-text"></i>

                </span>


                <span class="xt-document-info">

                  <strong title="<%= document.filename.to_s %>">

                    <%= document.filename.to_s %>

                  </strong>


                  <small>

                    <%= number_to_human_size(
                      document.byte_size
                    ) %>

                  </small>

                </span>


                <i class="bi bi-download xt-document-open"></i>


              <% end %>


            <% end %>

          </div>


        <% else %>


          <div class="xt-details-empty">

            <i class="bi bi-paperclip"></i>

            No attachments

          </div>


        <% end %>


      </div>


    </div>

  </details>


  <!-- ================================================= -->
  <!-- FOOTER -->
  <!-- ================================================= -->

  <div class="xt-transfer-card-footer">

    <div class="xt-footer-left">


      <% if transfer.pending? %>


        <%= button_to(
          toggle_pending_xtransfer_path(transfer),
          method: :patch,
          class: "xt-pending-toggle is-pending",
          title: "Click to unset pending"
        ) do %>

          <span class="xt-pending-dot"></span>

          <span>
            Pending
          </span>

        <% end %>


      <% else %>


        <%= button_to(
          toggle_pending_xtransfer_path(transfer),
          method: :patch,
          class: "xt-pending-toggle is-not-pending",
          title: "Click to set pending"
        ) do %>

          <span class="xt-pending-dot"></span>

          <span>
            Mark pending
          </span>

        <% end %>


      <% end %>


    </div>


    <div class="xt-card-actions">


      <%= link_to(
        edit_xtransfer_path(transfer),
        data: { controller: "bs-modal-form" },
        class: "xt-card-action xt-card-action-edit",
        title: "Edit transfer"
      ) do %>

        <i class="bi bi-pencil"></i>

        <span>
          Edit
        </span>

      <% end %>


      <%= button_to(
        xtransfer_path(transfer),
        method: :delete,
        class: "xt-card-action xt-card-action-delete",
        title: "Delete transfer",
        form: {
          data: {
            turbo_confirm: "Delete transfer ##{transfer.id}?"
          }
        }
      ) do %>

        <i class="bi bi-trash3"></i>

        <span>
          Delete
        </span>

      <% end %>


    </div>

  </div>


</article>
