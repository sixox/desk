<%
  transfer_transactions =
    @xtransfer.money_movements
      .includes(:xtransactions)
      .flat_map(&:xtransactions)
      .sort_by(&:created_at)
      .reverse

  sends =
    @xtransfer.money_movements
      .select { |movement| movement.send? && !movement.marked_for_destruction? }

  receives =
    @xtransfer.money_movements
      .select { |movement| movement.receive? && !movement.marked_for_destruction? }
%>

<div class="col-lg-10 mx-auto mt-5">

  <div class="xtransfer-page">

    <div class="container-fluid px-3 px-lg-4 py-4">

      <!-- ================================================== -->
      <!-- HEADER -->
      <!-- ================================================== -->

      <div class="xt-index-header">

        <div class="xt-index-heading">

          <div class="xt-index-icon">
            <i class="bi bi-arrow-left-right"></i>
          </div>

          <div>
            <h1 class="xt-index-title">
              Transfer
              <span>
                <%= @xtransfer.id %>
              </span>
            </h1>

            <div class="text-muted small mt-1">
              <%= @xtransfer.created_at.strftime("%Y-%m-%d %H:%M") %>
            </div>
          </div>

        </div>

        <%= link_to(
          xtransfers_path,
          class: "btn btn-sm btn-outline-secondary xaccount-action"
        ) do %>

          <i class="bi bi-arrow-left"></i>

          <span>
            Back
          </span>

        <% end %>

      </div>


      <!-- ================================================== -->
      <!-- TRANSFER -->
      <!-- ================================================== -->

      <div class="xt-transfers-container">

        <div
          id="xtransfers"
          class="xt-transfer-list"
        >

          <%= render(
            "xtransfer",
            transfer: @xtransfer
          ) %>

        </div>

      </div>


      <!-- ================================================== -->
      <!-- MOVEMENT SUMMARY -->
      <!-- ================================================== -->

      <div class="row g-3 mt-3">

        <!-- SENDS -->

        <div class="col-md-6">

          <div class="card h-100 border-0 shadow-sm">

            <div class="card-body">

              <div class="d-flex justify-content-between align-items-center mb-3">

                <div class="d-flex align-items-center gap-2">

                  <div class="text-danger">
                    <i class="bi bi-arrow-up-circle fs-4"></i>
                  </div>

                  <div>
                    <div class="fw-semibold">
                      Sends
                    </div>

                    <div class="text-muted small">
                      Money leaving accounts
                    </div>
                  </div>

                </div>

                <span class="badge text-bg-danger">
                  <%= sends.size %>
                </span>

              </div>


              <% if sends.any? %>

                <div class="list-group list-group-flush">

                  <% sends.each do |movement| %>

                    <div class="list-group-item px-0">

                      <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                          <div class="fw-semibold">
                            <%= movement.xaccount&.organization&.name || "-" %>
                          </div>

                          <div class="text-muted small">
                            <%= movement.xaccount&.number || "-" %>
                          </div>

                        </div>


                        <div class="text-end">

                          <div class="fw-semibold">
                            <%= number_with_delimiter(movement.amount) %>
                            <%= movement.currency&.name %>
                          </div>

                          <% if movement.total.present? %>

                            <div class="text-muted small">
                              Total:
                              <%= number_with_delimiter(movement.total) %>
                            </div>

                          <% end %>

                        </div>

                      </div>

                    </div>

                  <% end %>

                </div>

              <% else %>

                <div class="text-muted text-center py-3">
                  No sends
                </div>

              <% end %>

            </div>

          </div>

        </div>


        <!-- RECEIVES -->

        <div class="col-md-6">

          <div class="card h-100 border-0 shadow-sm">

            <div class="card-body">

              <div class="d-flex justify-content-between align-items-center mb-3">

                <div class="d-flex align-items-center gap-2">

                  <div class="text-success">
                    <i class="bi bi-arrow-down-circle fs-4"></i>
                  </div>

                  <div>
                    <div class="fw-semibold">
                      Receives
                    </div>

                    <div class="text-muted small">
                      Money entering accounts
                    </div>
                  </div>

                </div>

                <span class="badge text-bg-success">
                  <%= receives.size %>
                </span>

              </div>


              <% if receives.any? %>

                <div class="list-group list-group-flush">

                  <% receives.each do |movement| %>

                    <div class="list-group-item px-0">

                      <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                          <div class="fw-semibold">
                            <%= movement.xaccount&.organization&.name || "-" %>
                          </div>

                          <div class="text-muted small">
                            <%= movement.xaccount&.number || "-" %>
                          </div>

                        </div>


                        <div class="text-end">

                          <div class="fw-semibold">
                            <%= number_with_delimiter(movement.amount) %>
                            <%= movement.currency&.name %>
                          </div>

                          <% if movement.total.present? %>

                            <div class="text-muted small">
                              Total:
                              <%= number_with_delimiter(movement.total) %>
                            </div>

                          <% end %>

                        </div>

                      </div>

                    </div>

                  <% end %>

                </div>

              <% else %>

                <div class="text-muted text-center py-3">
                  No receives
                </div>

              <% end %>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ================================================== -->
  <!-- TRANSACTIONS -->
  <!-- ================================================== -->

  <div class="xaccount-transactions-section">

    <div class="xaccount-transactions-header">

      <div>

        <div class="xaccount-section-title">
          Transactions
        </div>

        <div class="xaccount-section-subtitle">
          Complete transaction history for this Transfer
        </div>

      </div>


      <div class="xaccount-transaction-count">

        <i class="bi bi-arrow-left-right"></i>

        <%= transfer_transactions.count %>

      </div>

    </div>


    <% if transfer_transactions.any? %>

      <div class="mt-3">

        <%= render(
          "xtransactions/xtransactions",
          xtransactions: transfer_transactions
        ) %>

      </div>

    <% else %>

      <div class="text-muted text-center py-4">
        No transactions
      </div>

    <% end %>

  </div>


  <!-- ================================================== -->
  <!-- COMMENTS -->
  <!-- ================================================== -->

  <hr>


  <div class="card mb-5 mt-5">

    <div class="card-body">

      <div class="row">

        <div class="col-lg-6">

          <div class="d-flex justify-content-start">

            <h5>
              Comments
            </h5>

          </div>

        </div>


        <div class="col-lg-6">

          <div class="d-flex justify-content-end">

            <%= link_to(
              new_xtransfer_comment_path(@xtransfer),
              data: {
                controller: "bs-modal-form",
                xtransfer_id: @xtransfer.id
              },
              class: "btn btn-primary"
            ) do %>

              Add Comment

            <% end %>

          </div>

        </div>

      </div>


      <ul
        class="list-group mt-1"
        id="comment_items"
      >

        <% if @xtransfer.comments.present? %>

          <% @xtransfer.comments.reverse.each do |comment| %>

            <%= render(
              "comments/comment",
              comment: comment
            ) %>

          <% end %>

        <% else %>

          <p>
            no comments
          </p>

        <% end %>

      </ul>

    </div>

  </div>

</div>


<%= turbo_frame_tag "modal" %>