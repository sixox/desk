<div
  data-controller="money-movements exchange"
  data-accounts-url="<%= accounts_xtransfers_path %>"
  class="xt-form"
>

  <%= form_with(
    model: @exchange,
    local: true,
    data: {
      turbo: false
    }
  ) do |form| %>

    <% if @exchange.errors.any? %>

      <div class="alert alert-danger">

        <strong>
          <%= pluralize(
            @exchange.errors.count,
            "error"
          ) %>
          prevented this exchange from being saved:
        </strong>

        <ul class="mb-0 mt-2">

          <% @exchange.errors.full_messages.each do |message| %>

            <li>
              <%= message %>
            </li>

          <% end %>

        </ul>

      </div>

    <% end %>


    <!-- ================================================== -->
    <!-- EXCHANGE HEADER -->
    <!-- ================================================== -->

    <div class="xt-form-header">

      <div>

        <div class="xt-form-title">
          <%= @exchange.new_record? ? "Create Exchange" : "Edit Exchange" %>
        </div>

        <div class="xt-form-subtitle">
          Create the sell and buy movements for this exchange.
        </div>

      </div>


      <!-- PENDING -->

      <div class="form-check form-switch">

        <%= form.check_box(
          :pending,
          class: "form-check-input"
        ) %>

        <%= form.label(
          :pending,
          "Pending",
          class: "form-check-label"
        ) %>

      </div>

    </div>


    <!-- ================================================== -->
    <!-- KIND -->
    <!-- ================================================== -->

    <div class="xt-form-section">

      <div class="xt-form-section-title">

        <i class="bi bi-diagram-3"></i>

        Exchange Type

      </div>


      <div class="row g-3">

        <div class="col-md-6">

          <%= form.label(
            :kind,
            "Type",
            class: "form-label"
          ) %>

          <%= form.select(
            :kind,
            Exchange.kinds.keys.map {
              |kind|
              [
                kind.humanize,
                kind
              ]
            },
            {
              include_blank: "Select type"
            },
            class: "form-select"
          ) %>

        </div>


        <div class="col-md-6">

          <%= form.label(
            :wage,
            "Wage",
            class: "form-label"
          ) %>

          <%= form.number_field(
            :wage,
            class: "form-control",
            step: 1,
            min: 0
          ) %>

        </div>

      </div>

    </div>


    <!-- ================================================== -->
    <!-- MOVEMENTS -->
    <!-- ================================================== -->

    <div class="xt-form-section">

      <div class="xt-form-section-title">

        <i class="bi bi-arrow-left-right"></i>

        Exchange Movements

      </div>


      <!-- ================================================= -->
      <!-- SELL -->
      <!-- ================================================= -->

      <div class="mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

          <div>

            <strong>
              Sell
            </strong>

            <div class="text-muted small">
              This movement creates the debit transaction.
            </div>

          </div>

        </div>


        <div
          data-money-movements-target="sendContainer"
        >

          <%= form.fields_for :exchange_movements do |movement_form| %>

            <% if movement_form.object.direction == "sell" %>

              <%= render(
                "shared/movement_fields",
                movement_form: movement_form,
                direction: "sell"
              ) %>

            <% end %>

          <% end %>

        </div>


        <template
          data-money-movements-target="sendTemplate"
        >

          <%= form.fields_for(
            :exchange_movements,
            @exchange.exchange_movements.build(
              direction: "sell"
            ),
            child_index: "NEW_RECORD"
          ) do |movement_form| %>

            <%= render(
              "shared/movement_fields",
              movement_form: movement_form,
              direction: "sell"
            ) %>

          <% end %>

        </template>


        <button
          type="button"
          class="btn xt-add-btn"
          data-action="money-movements#addSend"
        >

          <i class="bi bi-plus-lg"></i>

          Add sell movement

        </button>

      </div>


      <!-- ================================================= -->
      <!-- BUY -->
      <!-- ================================================= -->

      <div>

        <div class="d-flex justify-content-between align-items-center mb-3">

          <div>

            <strong>
              Buy
            </strong>

            <div class="text-muted small">
              This movement creates the credit transaction.
            </div>

          </div>

        </div>


        <div
          data-money-movements-target="receiveContainer"
        >

          <%= form.fields_for :exchange_movements do |movement_form| %>

            <% if movement_form.object.direction == "buy" %>

              <%= render(
                "shared/movement_fields",
                movement_form: movement_form,
                direction: "buy"
              ) %>

            <% end %>

          <% end %>

        </div>


        <template
          data-money-movements-target="receiveTemplate"
        >

          <%= form.fields_for(
            :exchange_movements,
            @exchange.exchange_movements.build(
              direction: "buy"
            ),
            child_index: "NEW_RECORD"
          ) do |movement_form| %>

            <%= render(
              "shared/movement_fields",
              movement_form: movement_form,
              direction: "buy"
            ) %>

          <% end %>

        </template>


        <button
          type="button"
          class="btn xt-add-btn"
          data-action="money-movements#addReceive"
        >

          <i class="bi bi-plus-lg"></i>

          Add buy movement

        </button>

      </div>

    </div>


    <!-- ================================================== -->
    <!-- RELATED TRANSFERS -->
    <!-- ================================================== -->

    <div class="xt-form-section">

      <div class="xt-form-section-title">

        <i class="bi bi-link-45deg"></i>

        Related Transfers

      </div>


      <div
        id="exchange-transfers"
        class="xt-related-list"
      >

        <% @exchange.exchange_transfers.each_with_index do |exchange_transfer, index| %>

          <%= form.fields_for(
            :exchange_transfers,
            exchange_transfer
          ) do |transfer_form| %>

            <div class="xt-related-row">

              <%= transfer_form.hidden_field :id %>

              <%= transfer_form.select(
                :xtransfer_id,
                @xtransfers.map {
                  |transfer|
                  [
                    "Transfer ##{transfer.id}",
                    transfer.id
                  ]
                },
                {
                  include_blank: "Select transfer"
                },
                class: "form-select"
              ) %>


              <%= transfer_form.check_box(
                :_destroy,
                class: "d-none"
              ) %>

            </div>

          <% end %>

        <% end %>

      </div>

    </div>


    <!-- ================================================== -->
    <!-- DOCUMENTS -->
    <!-- ================================================== -->

    <div class="xt-form-section">

      <div class="xt-form-section-title">

        <i class="bi bi-paperclip"></i>

        Attachments

      </div>


      <%= form.file_field(
        :documents,
        multiple: true,
        class: "form-control"
      ) %>


      <% if @exchange.documents.attached? %>

        <div class="xt-document-list mt-3">

          <% @exchange.documents.each do |document| %>

            <div class="xt-document-item">

              <span>
                <i class="bi bi-file-earmark-text"></i>
                <%= document.filename %>
              </span>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>


    <!-- ================================================== -->
    <!-- ACTIONS -->
    <!-- ================================================== -->

    <div class="xt-form-actions">

      <%= link_to(
        "Cancel",
        exchanges_path,
        class: "btn btn-outline-secondary"
      ) %>


      <%= form.submit(
        @exchange.new_record? ?
          "Create Exchange" :
          "Update Exchange",
        class: "btn xt-submit-btn"
      ) %>

    </div>

  <% end %>

</div>