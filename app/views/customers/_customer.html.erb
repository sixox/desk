
<%
  customer_pis = customer.pis.to_a

  customer_cis = customer_pis
    .flat_map { |pi| pi.cis.to_a }
    .uniq(&:id)

  customer_projects = (
    customer_pis.filter_map(&:project) +
    customer_cis.filter_map(&:project)
  ).uniq(&:id)

  latest_records = [
    customer,
    *customer_pis,
    *customer_cis,
    *customer_projects
  ]

  last_activity = latest_records
    .filter_map(&:updated_at)
    .max

  customer_currencies = customer_pis
    .filter_map { |pi| pi.currency.presence }
    .uniq
%>

<tr id="customer_item_<%= customer.id %>">

  <td>
    <div class="d-flex align-items-center gap-3">

      <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold flex-shrink-0"
           style="width: 39px; height: 39px;">

        <%= (customer.nickname.presence || customer.name.presence || "C").first.upcase %>

      </div>

      <div class="min-width-0">

        <%= link_to(
          customer.nickname.presence&.titleize || customer.name,
          customer_path(customer),
          class: "fw-semibold text-body text-decoration-none"
        ) %>

        <div class="small text-body-secondary">
          <%= customer.company.presence || "No company recorded" %>
        </div>

      </div>

    </div>
  </td>

  <td class="text-center">
    <span class="fw-semibold"><%= customer_projects.size %></span>
  </td>

  <td class="text-center">
    <span class="fw-semibold"><%= customer_pis.size %></span>
  </td>

  <td class="text-center">
    <span class="fw-semibold"><%= customer_cis.size %></span>
  </td>

  <td>
    <div class="d-flex flex-wrap gap-1">

      <% customer_currencies.each do |currency| %>
        <span class="badge bg-secondary-subtle text-secondary">
          <%= currency.titleize %>
        </span>
      <% end %>

      <% if customer_currencies.empty? %>
        <span class="text-body-secondary small">—</span>
      <% end %>

    </div>
  </td>

  <td class="small text-body-secondary text-nowrap">
    <% if last_activity.present? %>
      <%= time_ago_in_words(last_activity) %> ago
    <% else %>
      —
    <% end %>
  </td>

  <td class="small">
    <%= customer.user&.name || "—" %>
  </td>

  <td class="text-end text-nowrap">

    <%= link_to customer_path(customer),
      class: "btn btn-sm btn-light border",
      title: "Customer 360" do %>
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    <% end %>

    <% if current_user.sales? %>
      <%= link_to edit_customer_path(customer),
        class: "btn btn-sm btn-light border",
        title: "Edit customer",
        data: { controller: "bs-modal-form" } do %>
        <i class="fa-solid fa-pen"></i>
      <% end %>
    <% end %>

  </td>

</tr>
