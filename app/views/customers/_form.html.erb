
<%
  in_modal = local_assigns.fetch(:in_modal, true)
  cancel_path = local_assigns[:cancel_path] || customers_path
  form_css_class = in_modal ? "erp-modal__form" : "erp-form"
%>

<%= form_with(
  model: customer,
  html: {
    class: form_css_class
  }
) do |f| %>

  <div class="<%= in_modal ? 'modal-body' : 'card-body' %> erp-form__body">

    <%= render "shared/forms/errors", object: customer %>

    <section class="erp-form__section">

      <%= render "shared/forms/section_heading",
        icon: "fa-address-card",
        title: "Customer Identity",
        description: "Enter the customer's official and business information." %>

      <div class="row g-3">

        <div class="col-12">
          <%= render "shared/forms/field",
            form: f,
            attribute: :name,
            label: "Full name",
            required: true,
            hint: "Official or registered customer name.",
            input_options: {
              placeholder: "Enter full name",
              autocomplete: "name",
              autofocus: true
            } %>
        </div>

        <div class="col-md-6">
          <%= render "shared/forms/field",
            form: f,
            attribute: :nickname,
            label: "Nickname",
            required: true,
            hint: "Short name used throughout Desk.",
            input_options: {
              placeholder: "e.g. ABC Trading"
            } %>
        </div>

        <div class="col-md-6">
          <%= render "shared/forms/field",
            form: f,
            attribute: :company,
            label: "Company",
            required: true,
            hint: "Customer's company or organization.",
            input_options: {
              placeholder: "Enter company name"
            } %>
        </div>

      </div>

    </section>

    <% if customer.persisted? %>
      <div class="small text-body-secondary">
        <i class="fa-solid fa-calendar-plus me-1"></i>
        Registered on <%= l(customer.created_at.to_date, format: :long) %>
      </div>
    <% end %>

  </div>

  <%= render "shared/forms/actions",
    in_modal: in_modal,
    cancel_path: cancel_path,
    submit_label: customer.persisted? ? "Save changes" : "Create customer" %>

<% end %>
