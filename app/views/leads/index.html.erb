<div class="page-header">
  <div>
    <h1>CRM & Leads</h1>
    <p class="subtitle">Manage prospects and follow up on business opportunities.</p>
  </div>

  <div class="d-flex gap-2 flex-wrap">
    <%= link_to tasks_path, class: "btn btn-light border position-relative" do %>
    <i class="fa-solid fa-list-check me-1"></i> My Tasks
    <% if @my_due_count.to_i.positive? %>
    <span class="badge bg-danger ms-1"><%= @my_due_count %></span>
    <% end %>
    <% end %>

    <%= link_to pipeline_leads_path, class: "btn btn-light border" do %>
    <i class="fa-solid fa-diagram-project me-1"></i> Pipeline
    <% end %>

    <%= link_to new_lead_path,
    class: "btn btn-primary",
      data: { controller: "bs-modal-form" } do %>
      <i class="fa-solid fa-plus me-1"></i> New Lead
      <% end %>
    </div>
  </div>

  <section class="card mb-3">
    <div class="card-body py-3">
      <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="text-body-secondary small fw-semibold me-1">
          <i class="fa-solid fa-filter me-1"></i> Status
        </span>

        <%= link_to "All",
        leads_path,
        class: "btn btn-sm #{params[:status].blank? ? 'btn-primary' : 'btn-light border'}" %>

        <% Lead.statuses.keys.each do |status| %>
        <%= link_to status.humanize,
        leads_path(status: status),
        class: "btn btn-sm #{params[:status] == status ? 'btn-primary' : 'btn-light border'}" %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div>
        <h5 class="mb-0">Lead Directory</h5>
        <small class="text-body-secondary">
          <%= @leads.size %> matching records
        </small>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Lead</th>
            <th>Contact</th>
            <th>Status</th>
            <th>Owner</th>
            <th>Quick Update</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @leads.each do |lead| %>
          <tr>
            <td>
              <%= link_to lead.name, lead_path(lead),
              class: "fw-semibold text-decoration-none" %>

              <div class="small text-body-secondary">
                <%= lead.company.presence || "Individual" %>
              </div>
            </td>

            <td>
              <% if lead.phone.present? %>
              <div class="small">
                <i class="fa-solid fa-phone text-body-secondary me-1"></i>
                <%= lead.phone %>
              </div>
              <% end %>

              <% if lead.email.present? %>
              <div class="small">
                <i class="fa-solid fa-envelope text-body-secondary me-1"></i>
                <%= mail_to lead.email, class: "text-decoration-none" %>
              </div>
              <% end %>

              <% if lead.phone.blank? && lead.email.blank? %>
              <span class="text-body-secondary small">—</span>
              <% end %>
            </td>

            <td>
              <span class="badge bg-<%= status_header_badge_class(lead.status) %>-subtle text-<%= status_header_badge_class(lead.status) %>">
                <%= lead.status.humanize %>
              </span>

              <div class="small text-body-secondary mt-1">
                <%= distance_of_time_in_words(lead.current_status_age || 0) %>
              </div>
            </td>

            <td>
              <div class="small fw-medium">
                <%= lead.owner&.name || "Unassigned" %>
              </div>
            </td>

            <td style="min-width: 260px;">
              <%= form_with(
                url: update_status_lead_path(lead),
                method: :patch,
                local: true,
                scope: :lead,
                html: {
                  class: "d-flex align-items-center gap-1",
                    data: {
                      controller: "lead-quick-status"
                    }
                  }
                  ) do |f| %>

                  <%= hidden_field_tag :back_status, params[:status] %>

                  <div class="flex-grow-1">
                    <%= f.select :status,
                    options_for_select(
                      Lead.statuses.keys.map { |s| [s.humanize, s] },
                      lead.status
                      ),
                    {},
                    class: "form-select form-select-sm",
                      data: {
                        action: "change->lead-quick-status#toggleFields"
                      } %>

                      <div
                      class="mt-1"
                      data-lead-quick-status-target="offerFields"
                      <%= "hidden" unless lead.status == "offer_sent" %>>

                      <%= f.number_field :offered_amount,
                      step: 0.01,
                      class: "form-control form-control-sm mb-1",
                        placeholder: "Offer amount",
                        value: lead.offered_amount %>

                        <%= f.date_field :offered_on,
                        class: "form-control form-control-sm",
                          value: lead.offered_on %>
                        </div>
                      </div>

                      <%= f.button class: "btn btn-sm btn-outline-primary",
                      title: "Update status" do %>
                      <i class="fa-solid fa-check"></i>
                      <% end %>

                      <% end %>
                    </td>

                    <td class="text-end text-nowrap">
                      <%= link_to lead_path(lead),
                      class: "btn btn-sm btn-light border",
                        title: "View" do %>
                        <i class="fa-solid fa-eye"></i>
                        <% end %>

                        <%= link_to edit_lead_path(lead),
                        class: "btn btn-sm btn-light border",
                          title: "Edit",
                          data: { controller: "bs-modal-form" } do %>
                          <i class="fa-solid fa-pen"></i>
                          <% end %>

                          <%= link_to lead_path(lead),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Delete this lead?"
                          },
                          class: "btn btn-sm btn-light border text-danger",
                            title: "Delete" do %>
                            <i class="fa-solid fa-trash"></i>
                            <% end %>
                          </td>
                        </tr>
                        <% end %>

                        <% if @leads.empty? %>
                        <tr>
                          <td colspan="6" class="text-center py-5">
                            <i class="fa-solid fa-users text-body-secondary fs-3"></i>
                            <p class="text-body-secondary mt-2 mb-0">
                              No leads found.
                            </p>
                          </td>
                        </tr>
                        <% end %>
                      </tbody>

                    </table>
                  </div>
                </section>