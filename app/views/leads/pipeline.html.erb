
<div class="page-header">
  <div>
    <h1>Sales Pipeline</h1>
    <p class="subtitle">Follow every opportunity from initial contact to closure.</p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to cardex_path, class: "btn btn-light border" do %>
      <i class="fa-solid fa-layer-group me-1"></i> My Cardex
    <% end %>

    <%= link_to leads_path, class: "btn btn-light border" do %>
      <i class="fa-solid fa-list me-1"></i> Lead List
    <% end %>

    <%= link_to new_lead_path,
      class: "btn btn-primary",
      data: { controller: "bs-modal-form" } do %>
      <i class="fa-solid fa-plus me-1"></i> New Lead
    <% end %>
  </div>
</div>

<!-- PIPELINE SUMMARY -->
<div class="row row-tight mb-3">

  <% [
    ["All Leads", @pipeline_total, "fa-users", "c1"],
    ["Active Opportunities", @pipeline_open_count, "fa-chart-line", "c2"],
    ["Won", @pipeline_won_count, "fa-circle-check", "c3"],
    ["Lost", @pipeline_lost_count, "fa-circle-xmark", "c4"]
  ].each do |label, value, icon, color| %>

    <div class="col-6 col-xl-3">
      <article class="stat-card h-100">
        <div class="stat-card__head">
          <p class="stat-card__label"><%= label %></p>
          <span class="stat-card__icon stat-card__icon--<%= color %>">
            <i class="fa-solid <%= icon %>"></i>
          </span>
        </div>

        <p class="stat-card__value">
          <%= number_with_delimiter(value) %>
        </p>
      </article>
    </div>

  <% end %>

</div>

<!-- FILTERS -->
<section class="m-card mb-3">

  <%= form_with url: pipeline_leads_path, method: :get, local: true do |f| %>

    <div class="row g-2 align-items-end">

      <div class="col-12 col-lg-4">
        <%= f.label :q, "Search", class: "form-label small" %>
        <%= f.search_field :q,
          value: params[:q],
          class: "form-control",
          placeholder: "Lead, company, email or phone..." %>
      </div>

      <div class="col-12 col-md-5 col-lg-3">
        <%= f.label :owner_id, "Lead owner", class: "form-label small" %>
        <%= f.collection_select :owner_id,
          @owners,
          :id,
          :name,
          { include_blank: "All owners" },
          class: "form-select" %>
      </div>

      <div class="col-12 col-md-5 col-lg-3">
        <%= f.label :source, "Lead source", class: "form-label small" %>
        <%= f.select :source,
          options_for_select(@sources, params[:source]),
          { include_blank: "All sources" },
          class: "form-select" %>
      </div>

      <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
        <%= f.submit "Filter", class: "btn btn-primary flex-grow-1" %>

        <%= link_to pipeline_leads_path,
          class: "btn btn-light border",
          title: "Reset filters" do %>
          <i class="fa-solid fa-rotate-left"></i>
        <% end %>
      </div>

    </div>

  <% end %>

</section>

<!-- KANBAN BOARD -->
<div class="mb-2 d-flex align-items-center justify-content-between">
  <h2 class="m-card__title">Lead Stages</h2>

  <span class="small text-body-secondary">
    <i class="fa-solid fa-arrows-left-right me-1"></i>
    Scroll horizontally to view all stages
  </span>
</div>

<div class="d-flex flex-nowrap gap-3 overflow-auto pb-3 align-items-start">

  <% @status_order.each do |status| %>
    <% leads = @leads_by_status[status] || [] %>
    <% color = status_header_badge_class(status) %>

    <section
      class="border rounded-3 bg-body-tertiary flex-shrink-0"
      style="width: 285px; max-width: 285px;">

      <!-- STAGE HEADER -->
      <header class="p-3 border-bottom d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center gap-2">
          <span class="rounded-circle bg-<%= color %>"
                style="width: 9px; height: 9px;">
          </span>

          <h3 class="h6 fw-semibold mb-0">
            <%= lead_status_label(status) %>
          </h3>
        </div>

        <span class="badge bg-white text-body border">
          <%= leads.size %>
        </span>

      </header>

      <!-- LEAD CARDS -->
      <div class="p-2 d-flex flex-column gap-2"
           style="height: min(68vh, 650px); overflow-y: auto;">

        <% if leads.any? %>

          <% leads.each do |lead| %>
            <%
              open_tasks = lead.lead_tasks.select(&:open?)

              overdue_tasks = open_tasks.count do |task|
                task.due_on.present? && task.due_on < Date.current
              end
            %>

            <article class="bg-white border rounded-3 p-3">

              <div class="d-flex align-items-start justify-content-between gap-2">

                <div class="min-w-0">
                  <%= link_to lead.name,
                    lead_path(lead),
                    class: "fw-semibold text-body text-decoration-none" %>

                  <div class="small text-body-secondary mt-1">
                    <%= lead.company.presence || "Individual" %>
                  </div>
                </div>

                <span class="badge bg-<%= color %>-subtle text-<%= color %> flex-shrink-0">
                  <%= status == "new_lead" ? "New" : status.humanize %>
                </span>

              </div>

              <div class="d-flex flex-column gap-1 mt-3 small text-body-secondary">

                <% if lead.phone.present? %>
                  <span>
                    <i class="fa-solid fa-phone me-1"></i>
                    <%= lead.phone %>
                  </span>
                <% end %>

                <% if lead.owner.present? %>
                  <span>
                    <i class="fa-solid fa-user me-1"></i>
                    <%= lead.owner.name %>
                  </span>
                <% end %>

                <span>
                  <i class="fa-regular fa-clock me-1"></i>
                  Stage age: <%= human_duration(lead.current_status_age) %>
                </span>

              </div>

              <% if lead.offered_amount.present? || open_tasks.any? %>
                <div class="border-top mt-3 pt-2 d-flex flex-wrap gap-2">

                  <% if lead.offered_amount.present? %>
                    <span class="badge bg-warning-subtle text-warning-emphasis">
                      <i class="fa-solid fa-file-invoice-dollar me-1"></i>
                      <%= number_with_precision(lead.offered_amount, precision: 2) %>
                    </span>
                  <% end %>

                  <% if open_tasks.any? %>
                    <span class="badge bg-primary-subtle text-primary">
                      <i class="fa-solid fa-list-check me-1"></i>
                      <%= open_tasks.size %> tasks
                    </span>
                  <% end %>

                  <% if overdue_tasks.positive? %>
                    <span class="badge bg-danger-subtle text-danger">
                      <%= overdue_tasks %> overdue
                    </span>
                  <% end %>

                </div>
              <% end %>

              <div class="text-end mt-3">
                <%= link_to lead_path(lead),
                  class: "btn btn-sm btn-light border" do %>
                  Open <i class="fa-solid fa-arrow-right ms-1"></i>
                <% end %>
              </div>

            </article>

          <% end %>

        <% else %>

          <div class="text-center py-5 text-body-secondary small">
            <i class="fa-regular fa-folder-open fs-4 mb-2"></i>
            <div>No leads in this stage</div>
          </div>

        <% end %>

      </div>

    </section>

  <% end %>

</div>
