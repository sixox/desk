<%= form_with model: [@project, @booking] do |form| %>

  <div class="modal-body erp-form">

    <%= render "shared/forms/errors", object: @booking %>

    <div class="mb-4">
      <div class="small text-body-secondary">Booking</div>
      <div class="fw-semibold"><%= @booking.number %></div>
    </div>

    <%= render "shared/forms/section_heading",
      title: "Customs Clearance",
      description: "Update the progress of customs processing.",
      icon: "fa-stamp" %>

    <div class="row g-3 mb-4">

      <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100">

          <div class="form-check form-switch">

            <%= form.check_box :declaration,
              class: "form-check-input" %>

            <%= form.label :declaration,
              "Declaration",
              class: "form-check-label fw-semibold" %>

          </div>

          <small class="text-body-secondary">
            Customs declaration completed.
          </small>

        </div>
      </div>

      <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100">

          <div class="form-check form-switch">

            <%= form.check_box :tally,
              class: "form-check-input" %>

            <%= form.label :tally,
              "Tally",
              class: "form-check-label fw-semibold" %>

          </div>

          <small class="text-body-secondary">
            Tally process completed.
          </small>

        </div>
      </div>

      <div class="col-md-4">
        <div class="border rounded-3 p-3 h-100">

          <div class="form-check form-switch">

            <%= form.check_box :send_to_line,
              class: "form-check-input" %>

            <%= form.label :send_to_line,
              "Deliver to Line",
              class: "form-check-label fw-semibold" %>

          </div>

          <small class="text-body-secondary">
            Cargo delivered to the shipping line.
          </small>

        </div>
      </div>

    </div>

    <div class="alert alert-light border small mb-0">
      <i class="fa-solid fa-circle-info me-1"></i>
      These fields update the existing customs workflow flags.
    </div>

  </div>

  <%= render "shared/forms/actions",
    in_modal: true,
    submit_label: "Update Customs Status" %>

<% end %>