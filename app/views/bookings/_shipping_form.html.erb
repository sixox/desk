<%= form_with model: [@project, @booking],
  html: { multipart: true } do |form| %>

  <div class="modal-body erp-form">

    <%= render "shared/forms/errors", object: @booking %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <div class="small text-body-secondary">Booking</div>
        <div class="fw-semibold"><%= @booking.number %></div>
      </div>

      <% if @booking.vessel_eta.present? %>
        <span class="badge bg-info-subtle text-info">
          ETA <%= @booking.vessel_eta.strftime("%d %b %Y") %>
        </span>
      <% end %>
    </div>

    <%= render "shared/forms/section_heading",
      title: "Vessel Information",
      description: "Vessel schedule and shipping details.",
      icon: "fa-ship" %>

    <div class="row g-3 mb-4">

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :vessel_eta,
          label: "Vessel ETA",
          type: :date_field %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :vessel_name,
          label: "Vessel Name & Voyage" %>
      </div>

    </div>

    <div class="erp-form__divider"></div>

    <%= render "shared/forms/section_heading",
      title: "Bill of Lading",
      description: "BL reference and document uploads.",
      icon: "fa-file-lines" %>

    <div class="row g-3 mb-4">

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :bl_number,
          label: "BL Number" %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :date_of_bl,
          label: "BL Date",
          type: :date_field %>
      </div>

      <div class="col-12">
        <div class="border rounded-3 p-3">

          <%= render "shared/forms/field",
            form: form,
            attribute: :bl_draft,
            label: "BL Draft",
            type: :file_field %>

          <% if @booking.bl_draft.attached? %>
            <div class="small mt-2">
              <i class="fa-solid fa-file-pdf text-danger me-1"></i>
              <%= link_to "View current draft",
                rails_blob_path(@booking.bl_draft, disposition: "attachment"),
                target: "_blank",
                rel: "noopener" %>
            </div>
          <% end %>

        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100">

          <%= render "shared/forms/field",
            form: form,
            attribute: :bl_dated,
            label: "Dated BL",
            type: :file_field %>

          <% if @booking.bl_dated.attached? %>
            <div class="small mt-2">
              <%= link_to "View current document",
                rails_blob_path(@booking.bl_dated, disposition: "attachment"),
                target: "_blank",
                rel: "noopener" %>
            </div>
          <% end %>

        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100">

          <%= render "shared/forms/field",
            form: form,
            attribute: :surrender,
            label: "Surrender Document",
            type: :file_field %>

          <% if @booking.surrender.attached? %>
            <div class="small mt-2">
              <%= link_to "View current document",
                rails_blob_path(@booking.surrender, disposition: "attachment"),
                target: "_blank",
                rel: "noopener" %>
            </div>
          <% end %>

        </div>
      </div>

    </div>

    <div class="erp-form__divider"></div>

    <%= render "shared/forms/section_heading",
      title: "Payment & Cargo Release",
      description: "Confirm the existing booking payment and release flag.",
      icon: "fa-circle-check" %>

    <div class="border rounded-3 p-3">

      <div class="form-check form-switch">

        <%= form.check_box :payment_done,
          class: "form-check-input" %>

        <%= form.label :payment_done,
          "Payment completed and cargo released",
          class: "form-check-label fw-semibold" %>

      </div>

    </div>

  </div>

  <%= render "shared/forms/actions",
    in_modal: true,
    submit_label: "Update Shipping" %>

<% end %>