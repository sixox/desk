<%= form_with model: [@project, @booking] do |form| %>

  <div class="modal-body erp-form">

    <%= render "shared/forms/errors", object: @booking %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <div class="small text-body-secondary">Booking</div>
        <div class="fw-semibold"><%= @booking.number %></div>
      </div>
      <div class="text-end">
        <div class="small text-body-secondary">Total containers</div>
        <div class="fs-5 fw-semibold"><%= @booking.quantity %></div>
      </div>
    </div>

    <%= render "shared/forms/section_heading",
      title: "Container Progress",
      description: "Update pickup and stuffing quantities.",
      icon: "fa-boxes-stacked" %>

    <%
      quantity = @booking.quantity.to_i
      picked_up = @booking.picked_up.to_i
      filled = @booking.filled.to_i

      picked_percentage = quantity.positive? ? [(picked_up.to_f / quantity * 100).round, 100].min : 0
      filled_percentage = quantity.positive? ? [(filled.to_f / quantity * 100).round, 100].min : 0
    %>

    <div class="row g-3 mb-4">

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100">

          <div class="d-flex justify-content-between mb-2">
            <label class="form-label fw-semibold mb-0">
              Picked up
            </label>
            <span class="small text-body-secondary">
              <%= picked_up %> / <%= quantity %>
            </span>
          </div>

          <div class="progress mb-3" style="height: 7px;">
            <div class="progress-bar bg-primary"
                 style="width: <%= picked_percentage %>%">
            </div>
          </div>

          <%= form.number_field :picked_up,
            class: "form-control",
            min: 0,
            max: quantity,
            step: 1 %>

          <small class="text-body-secondary">
            Number of containers collected from the factory.
          </small>

        </div>
      </div>

      <div class="col-md-6">
        <div class="border rounded-3 p-3 h-100">

          <div class="d-flex justify-content-between mb-2">
            <label class="form-label fw-semibold mb-0">
              Stuffed
            </label>
            <span class="small text-body-secondary">
              <%= filled %> / <%= quantity %>
            </span>
          </div>

          <div class="progress mb-3" style="height: 7px;">
            <div class="progress-bar bg-success"
                 style="width: <%= filled_percentage %>%">
            </div>
          </div>

          <%= form.number_field :filled,
            class: "form-control",
            min: 0,
            max: quantity,
            step: 1 %>

          <small class="text-body-secondary">
            Number of containers that have been stuffed.
          </small>

        </div>
      </div>

    </div>

    <%= render "shared/forms/section_heading",
      title: "Stuffing Status",
      description: "Indicate whether stuffing operations have started.",
      icon: "fa-clipboard-check" %>

    <div class="border rounded-3 p-3">

      <div class="form-check form-switch">

        <%= form.check_box :stuffing,
          class: "form-check-input" %>

        <%= form.label :stuffing,
          "Stuffing started",
          class: "form-check-label fw-semibold" %>

      </div>

    </div>

  </div>

  <%= render "shared/forms/actions",
    in_modal: true,
    submit_label: "Update Pickup & Stuffing" %>

<% end %>