<%
  project = local_assigns[:project] || @project
  booking = local_assigns[:booking] || @booking
%>

<%= form_with model: [project, booking] do |form| %>

  <div class="modal-body erp-form">

    <%= render "shared/forms/errors", object: booking %>

    <!-- PROJECT CONTEXT -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

      <div>
        <div class="small text-body-secondary">Project</div>

        <%= link_to project.number,
          project_path(project),
          class: "fw-semibold text-decoration-none" %>
      </div>

      <% if project.pi.present? %>
        <div class="text-end">
          <div class="small text-body-secondary">Performa Invoice</div>
          <span class="small fw-medium">
            <%= project.pi.number %>
          </span>
        </div>
      <% end %>

    </div>

    <!-- BOOKING DETAILS -->

    <%= render "shared/forms/section_heading",
      title: "Booking Details",
      description: "Booking reference and container configuration.",
      icon: "fa-box" %>

    <div class="row g-3 mb-4">

      <div class="col-md-8">
        <%= render "shared/forms/field",
          form: form,
          attribute: :number,
          label: "Booking Number",
          required: true %>
      </div>

      <div class="col-md-4">
        <%= render "shared/forms/field",
          form: form,
          attribute: :part,
          label: "Part",
          type: :number_field %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :line,
          label: "Shipping Line",
          type: :select,
          choices: Booking::LINE,
          select_options: { prompt: "Select shipping line" },
          required: true %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :forwarder,
          label: "Forwarder",
          type: :select,
          choices: Booking::FORWARDER,
          select_options: { prompt: "Select forwarder" },
          required: true %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :container_type,
          label: "Container Type",
          type: :select,
          choices: Booking::CONTAINER_TYPE,
          select_options: { prompt: "Select container type" },
          required: true %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :quantity,
          label: "Number of Containers",
          type: :number_field,
          required: true,
          input_options: { min: 0 } %>
      </div>

    </div>

    <div class="erp-form__divider"></div>

    <!-- ROUTE AND FREIGHT -->

    <%= render "shared/forms/section_heading",
      title: "Destination & Freight",
      description: "Port, freight price and cargo details.",
      icon: "fa-ship" %>

    <div class="row g-3 mb-4">

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :pod,
          label: "Port of Destination (POD)",
          required: true %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :free_time,
          label: "Free Time (Days)",
          type: :number_field,
          input_options: { min: 0 } %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :freight_price,
          label: "Freight Rate per Container (USD)",
          type: :number_field,
          input_options: { min: 0, step: "any" } %>
      </div>

      <div class="col-md-6">
        <%= render "shared/forms/field",
          form: form,
          attribute: :weight,
          label: "Weight (MT)",
          type: :number_field,
          input_options: { min: 0, step: "any" } %>
      </div>

    </div>

    <div class="erp-form__divider"></div>

    <!-- SERVICES -->

    <%= render "shared/forms/section_heading",
      title: "Additional Services",
      description: "Optional booking requirements.",
      icon: "fa-clipboard-check" %>

    <div class="row g-3">

      <div class="col-md-6">

        <div class="border rounded-3 p-3 h-100">

          <div class="form-check form-switch">

            <%= form.check_box :have_flexi,
              class: "form-check-input" %>

            <%= form.label :have_flexi,
              "Flexi Required",
              class: "form-check-label fw-medium" %>

          </div>

          <small class="text-body-secondary">
            Enable when this booking requires a flexi container.
          </small>

        </div>

      </div>

      <div class="col-md-6">

        <div class="border rounded-3 p-3 h-100">

          <div class="form-check form-switch">

            <%= form.check_box :inspection,
              class: "form-check-input" %>

            <%= form.label :inspection,
              "Inspection Required",
              class: "form-check-label fw-medium" %>

          </div>

          <small class="text-body-secondary">
            Enable when cargo inspection is required.
          </small>

        </div>

      </div>

    </div>

  </div>

  <%= render "shared/forms/actions",
    in_modal: true,
    submit_label: booking.persisted? ? "Save Booking" : "Create Booking" %>

<% end %>