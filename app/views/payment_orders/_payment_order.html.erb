<%
  rejected = payment_order.rejected_at.present?
  delivered = payment_order.delivered_at.present?
  status = payment_order.status

  approval_state = rejected ? :rejected : (status == "wait for confirm" ? :waiting : :done)
  payment_state =
    if rejected || status == "wait for confirm"
      :waiting
    elsif status == "wait for payment"
      :active
    else
      :done
    end
  delivery_state =
    if rejected || ["wait for confirm", "wait for payment"].include?(status)
      :waiting
    elsif status == "wait for delivery"
      :active
    else
      :done
    end
%>

<li
  id="payment_order_item_<%= payment_order.id %>"
  class="po-card
    <%= "po-card--#{status.to_s.parameterize}" %>
    <%= "po-card--secret" if payment_order.mahramane? %>
    <%= "po-card--rahkarsazan" if payment_order.is_rahkarsazan? %>
    <%= "po-card--rejected" if rejected %>">

  <% if rejected %>
    <%= image_tag "rejected.png",
      alt: "Rejected",
      class: "po-card__stamp" %>
  <% elsif delivered %>
    <%= image_tag "finished12.png",
      alt: "Finished",
      class: "po-card__stamp" %>
  <% end %>

  <div class="po-card__top">

    <div class="po-card__identity">

      <%= link_to payment_order_path(payment_order),
        class: "po-card__number" do %>
        <span>P.O</span>
        <strong>#<%= payment_order.id %></strong>
      <% end %>

      <% if payment_order.announce? && status == "wait for payment" %>
        <span class="po-card__announcement" title="Payment announced">
          <i class="fa-solid fa-bullhorn"></i>
        </span>
      <% end %>

      <% if payment_order.mahramane? %>
        <span class="po-card__type po-card__type--secret">
          <i class="fa-solid fa-lock"></i> Secret
        </span>
      <% end %>

      <% if payment_order.is_rahkarsazan? %>
        <span class="po-card__type po-card__type--rahkar">
          <i class="fa-solid fa-building"></i> Rahkarsazan
        </span>
      <% end %>

    </div>

    <div class="po-card__date">
      <i class="fa-regular fa-calendar"></i>
      <%= payment_order.created_at&.strftime("%d %b %Y") %>
    </div>

  </div>

  <% if rejected %>

    <div class="po-card__rejected">
      <i class="fa-solid fa-circle-xmark"></i>
      Rejected
      <% if payment_order.reject_by.present? %>
        by <strong><%= payment_order.reject_by %></strong>
      <% end %>
      <span><%= payment_order.rejected_at&.strftime("%d %b %Y") %></span>
    </div>

  <% else %>

    <div class="po-card__workflow">

      <div class="po-card__stage <%= "is-done" if approval_state == :done %> <%= "is-active" if approval_state == :waiting %>">
        <span class="po-card__stage-icon">
          <i class="fa-solid <%= approval_state == :done ? "fa-check" : "fa-user-check" %>"></i>
        </span>
        <span class="po-card__stage-label">Confirmation</span>
        <strong><%= approval_state == :done ? "Confirmed" : "Wait for confirm" %></strong>
      </div>

      <div class="po-card__stage <%= "is-done" if payment_state == :done %> <%= "is-active" if payment_state == :active %>">
        <span class="po-card__stage-icon">
          <i class="fa-solid <%= payment_state == :done ? "fa-check" : "fa-money-bill-transfer" %>"></i>
        </span>
        <span class="po-card__stage-label">Payment</span>
        <strong>
          <%= payment_state == :done ? "Paid" : (payment_state == :active ? "Wait for payment" : "Not paid") %>
        </strong>
      </div>

      <div class="po-card__stage <%= "is-done" if delivery_state == :done %> <%= "is-active" if delivery_state == :active %>">
        <span class="po-card__stage-icon">
          <i class="fa-solid <%= delivery_state == :done ? "fa-check" : "fa-truck-fast" %>"></i>
        </span>
        <span class="po-card__stage-label">Delivery</span>
        <strong>
          <%= delivery_state == :done ? "Delivered" : (delivery_state == :active ? "Wait for delivery" : "Not delivered") %>
        </strong>
        <% if delivery_state == :done && payment_order.delivered_at.present? %>
          <small><%= payment_order.delivered_at.strftime("%d %b") %></small>
        <% end %>
      </div>

    </div>

  <% end %>

  <div class="po-card__main">

    <div class="po-card__amount">
      <span class="po-card__caption">AMOUNT</span>
      <strong><%= number_with_delimiter(payment_order.amount, delimiter: ",") %></strong>
      <span><%= payment_order.currency.to_s.upcase %></span>
    </div>

    <div class="po-card__requester">
      <span class="po-card__caption">REQUESTED BY</span>
      <strong><%= payment_order.user&.name %></strong>
    </div>

    <% if payment_order.project.present? %>
      <div class="po-card__reference">
        <span class="po-card__caption">PROJECT</span>
        <%= link_to payment_order.project.number, project_path(payment_order.project) %>
      </div>
    <% end %>

    <% if payment_order.booking.present? %>
      <div class="po-card__reference">
        <span class="po-card__caption">BOOKING</span>
        <%= link_to payment_order.booking.number, project_path(payment_order.booking.project, anchor: "booking-#{payment_order.booking_id}") %>
      </div>
    <% end %>

    <% if payment_order.ballance.present? %>
      <div class="po-card__reference">
        <span class="po-card__caption">INVENTORY</span>
        <%= link_to payment_order.ballance.number, ballance_path(payment_order.ballance) %>
      </div>
    <% end %>

    <% if payment_order.spi.present? %>
      <div class="po-card__reference">
        <span class="po-card__caption">PI</span>
        <strong><%= payment_order.spi.number %></strong>
      </div>
    <% end %>

    <% if payment_order.sci.present? %>
      <div class="po-card__reference">
        <span class="po-card__caption">CI</span>
        <strong><%= payment_order.sci.number %></strong>
      </div>
    <% end %>

  </div>

  <% if payment_order.details.present? || payment_order.cost_type.present? %>
    <div class="po-card__description">
      <% if payment_order.details.present? %>
        <span><%= payment_order.details %></span>
      <% end %>
      <% if payment_order.cost_type.present? %>
        <small><%= payment_order.cost_type %></small>
      <% end %>
    </div>
  <% end %>

  <% if payment_order.hamed_confirm? || payment_order.shaghayegh_confirm? %>
    <div class="po-card__special-approvals">
      <% if payment_order.hamed_confirm? %>
        <span><i class="fa-solid fa-check-circle"></i> Mr. Iranshahy</span>
      <% end %>
      <% if payment_order.shaghayegh_confirm? %>
        <span><i class="fa-solid fa-check-circle"></i> Accounting</span>
      <% end %>
    </div>
  <% end %>

  <div class="po-card__approval-history">

    <% unless payment_order.mahramane? %>
      <% [
        ["Manager", payment_order.department_confirm, payment_order.department_confirmed_at],
        ["COO", payment_order.coo_confirm, payment_order.coo_confirmed_at],
        ["Accounting", payment_order.accounting_confirm, payment_order.accounting_confirmed_at]
      ].each do |label, confirmed, confirmed_at| %>
        <div class="po-card__approval <%= confirmed ? "is-approved" : "is-pending" %>">
          <i class="fa-solid <%= confirmed ? "fa-circle-check" : "fa-circle" %>"></i>
          <span><%= label %></span>
          <% if confirmed_at.present? %>
            <small><%= confirmed_at.strftime("%d %b") %></small>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% [
      ["CEO", payment_order.ceo_confirm, payment_order.ceo_confirmed_at],
      ["COB", payment_order.cob_confirm, payment_order.cob_confirmed_at]
    ].each do |label, confirmed, confirmed_at| %>
      <div class="po-card__approval <%= confirmed ? "is-approved" : "is-pending" %>">
        <i class="fa-solid <%= confirmed ? "fa-circle-check" : "fa-circle" %>"></i>
        <span><%= label %></span>
        <% if confirmed_at.present? %>
          <small><%= confirmed_at.strftime("%d %b") %></small>
        <% end %>
      </div>
    <% end %>

  </div>

  <div class="po-card__footer">

    <button
      type="button"
      class="po-card__action"
      data-controller="clipboard"
      data-action="click->clipboard#copy"
      data-clipboard-text="PO.<%= payment_order.id %> - <%= number_with_delimiter(payment_order.amount, delimiter: ",") %> <%= payment_order.currency %>">
      <i class="fa-regular fa-copy"></i> Copy
    </button>

    <% if action_name != "show" %>

      <% if user_signed_in? && [29, 47].include?(current_user.id) && !payment_order.rejected_at %>
        <% if (payment_order.coo_confirm && !payment_order.accounting_confirm) ||
              (!payment_order.department_confirm && current_user.role == payment_order.user.role) %>
          <%= link_to confirm_payment_order_path(payment_order),
            data: { turbo_method: :patch, turbo_confirm: "Confirm this Payment Order?" },
            class: "po-card__action po-card__action--confirm" do %>
            <i class="fa-solid fa-check"></i> Confirm
          <% end %>
        <% end %>
      <% end %>

      <% if user_signed_in? && current_user.is_manager && !payment_order.rejected_at %>
        <% can_confirm =
          (current_user.ceo? && !payment_order.ceo_confirm && payment_order.coo_confirm && payment_order.accounting_confirm && payment_order.department_confirm) ||
          (current_user.accounting? && payment_order.coo_confirm && !payment_order.accounting_confirm) ||
          (current_user.procurement? && !payment_order.coo_confirm && payment_order.department_confirm) ||
          (!payment_order.department_confirm && current_user.role == payment_order.user.role) ||
          (current_user.cob? && !payment_order.cob_confirm && payment_order.coo_confirm && payment_order.accounting_confirm && payment_order.department_confirm) %>

        <% if can_confirm %>
          <%= link_to confirm_payment_order_path(payment_order),
            data: { turbo_method: :patch, turbo_confirm: "Confirm this Payment Order?" },
            class: "po-card__action po-card__action--confirm" do %>
            <i class="fa-solid fa-check"></i> Confirm
          <% end %>
        <% end %>
      <% end %>

      <% if !payment_order.coo_confirm? && ((current_user == payment_order.user) || (current_user.is_manager && current_user.procurement?)) %>
        <%= link_to edit_payment_order_path(payment_order),
          data: { controller: "bs-modal-form" },
          class: "po-card__action" do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>

        <%= link_to payment_order_path(payment_order),
          data: { turbo_method: :delete, turbo_confirm: "Delete this Payment Order?" },
          class: "po-card__action po-card__action--delete" do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>
      <% end %>

      <% if current_user.admin? %>
        <%= link_to edit_payment_order_path(payment_order),
          data: { controller: "bs-modal-form" },
          class: "po-card__action" do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>
      <% end %>

      <%= link_to payment_order_path(payment_order),
        class: "po-card__action po-card__action--open" do %>
        <i class="fa-solid fa-arrow-right"></i> Open
      <% end %>

    <% end %>

  </div>

</li>