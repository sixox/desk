<%
  page_title =
    case @in_page
    when "mine"
      "My Payment Orders"
    when "not confirmed"
      "Awaiting Confirmation"
    when "notp"
      "Awaiting Payment"
    when "notd"
      "Awaiting Delivery"
    when "pending"
      "Pending Payment Orders"
    when "finished"
      "Completed Payment Orders"
    when "rejected"
      "Rejected Payment Orders"
    when "confirmable"
      "Payment Orders to Confirm"
    else
      "Payment Orders"
    end

  page_subtitle =
    case @in_page
    when "mine"
      "Payment requests created by you"
    when "confirmable"
      "Requests requiring your approval"
    else
      "Company payment requests and approval progress"
    end
%>

<% order_total =
  @payment_orders.respond_to?(:total_count) ?
    @payment_orders.total_count :
    @payment_orders&.size.to_i %>


<div class="po-index">


  <!-- HEADER -->

  <header class="po-index__header">

    <div>

      <div class="po-index__eyebrow">
        ACCOUNTING
      </div>

      <h1><%= page_title %></h1>

      <p><%= page_subtitle %></p>

    </div>


    <div class="po-index__header-actions">

      <%= link_to reports_payment_orders_path,
        class: "po-index__button po-index__button--secondary" do %>

        <i class="fa-solid fa-chart-column"></i>
        Reports

      <% end %>


      <%= link_to new_payment_order_path,
        data: { controller: "bs-modal-form" },
        class: "po-index__button po-index__button--primary" do %>

        <i class="fa-solid fa-plus"></i>
        New Payment Order

      <% end %>

    </div>

  </header>


  <!-- SPECIAL APPROVAL QUEUES -->

  <% if @pis.present? %>

    <section class="po-special-section">

      <header class="po-special-section__header">
        <div>
          <h2>
            <i class="fa-solid fa-file-invoice"></i>
            PIs Awaiting Confirmation
          </h2>
        </div>

        <span><%= @pis.size %></span>
      </header>

      <div class="po-special-section__list">

        <% @pis.each do |pi| %>

          <article class="po-special-item">

            <div class="po-special-item__main">

              <strong><%= pi.number %></strong>

              <span>
                <%= pi.customer&.nickname || "Customer not assigned" %>
              </span>

              <small>
                <%= pi.product %>
                ·
                <%= pi.quantity.to_i %> MT
                ·
                <%= pi.pod %>
              </small>

            </div>

            <div class="po-special-item__side">

              <strong>
                <%= number_with_delimiter(pi.unit_price, delimiter: ",") %>
                <small><%= pi.currency %></small>
              </strong>

              <%= link_to pi_path(pi),
                data: { controller: "bs-modal-form" },
                class: "po-special-item__action" do %>

                Review
                <i class="fa-solid fa-arrow-right"></i>

              <% end %>

            </div>

          </article>

        <% end %>

      </div>

    </section>

  <% end %>


  <% if @release_requests.present? %>

    <section class="po-special-section">

      <header class="po-special-section__header">
        <div>
          <h2>
            <i class="fa-solid fa-file-signature"></i>
            Release Requests
          </h2>
        </div>

        <span><%= @release_requests.size %></span>
      </header>

      <div class="po-special-section__list">

        <% @release_requests.each do |request| %>

          <article class="po-special-item">

            <div class="po-special-item__main">

              <strong>
                <%= link_to request.booking.project.number,
                  project_path(request.booking.project) %>
              </strong>

              <span>
                Booking <%= request.booking.number %>
              </span>

              <small>
                <%= request.booking.weight %> MT
                <% if request.note.present? %>
                  · <%= truncate(request.note, length: 90) %>
                <% end %>
              </small>

            </div>

            <div class="po-special-item__side">

              <%= button_to confirm_release_request_path(request),
                method: :patch,
                class: "po-special-item__confirm",
                form: {
                  data: {
                    turbo_confirm: "Confirm this request and grant release permission?"
                  }
                } do %>

                <i class="fa-solid fa-check"></i>
                Confirm Release

              <% end %>

            </div>

          </article>

        <% end %>

      </div>

    </section>

  <% end %>


  <% if @transfers.present? %>

    <section class="po-special-section">

      <header class="po-special-section__header">
        <div>
          <h2>
            <i class="fa-solid fa-right-left"></i>
            Bank Transfers
          </h2>
        </div>

        <span><%= @transfers.size %></span>
      </header>

      <div class="po-special-section__list">

        <% @transfers.each do |transfer| %>

          <article class="po-special-item">

            <div class="po-special-item__main">

              <strong>
                <%= transfer.withdraw_from_bank.name %>
                <i class="fa-solid fa-arrow-right mx-1"></i>
                <%= transfer.deposited_to_bank.name %>
              </strong>

              <small>
                <span class="text-danger">
                  -<%= number_with_delimiter(transfer.withdraw_amount, delimiter: ",") %>
                  <%= transfer.withdraw_from_bank.currency %>
                </span>

                <span class="mx-1">·</span>

                <span class="text-success">
                  +<%= number_with_delimiter(transfer.deposited_amount, delimiter: ",") %>
                  <%= transfer.deposited_to_bank.currency %>
                </span>

              </small>

              <% if transfer.document.attached? %>

                <%= link_to rails_blob_path(
                      transfer.document,
                      disposition: "attachment"
                    ),
                  target: "_blank",
                  rel: "noopener",
                  class: "po-special-item__document" do %>

                  <i class="fa-solid fa-paperclip"></i>
                  View document

                <% end %>

              <% end %>

            </div>


            <div class="po-special-item__side">

              <% if !transfer.confirmed && !transfer.rejected %>

                <%= link_to confirm_transfer_path(transfer),
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: "Confirm this transfer?"
                  },
                  class: "po-special-item__confirm" do %>

                  <i class="fa-solid fa-check"></i>
                  Confirm

                <% end %>

                <%= link_to reject_transfer_path(transfer),
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: "Reject this transfer?"
                  },
                  class: "po-special-item__reject" do %>

                  <i class="fa-solid fa-xmark"></i>
                  Reject

                <% end %>

              <% else %>

                <span class="po-special-item__status">
                  <%= transfer.rejected? ? "Rejected" : "Confirmed" %>
                </span>

              <% end %>

            </div>

          </article>

        <% end %>

      </div>

    </section>

  <% end %>


  <!-- PAYMENT ORDER DIRECTORY -->

  <section class="po-index__directory">

    <div class="po-index__directory-heading">

      <div>
        <h2>Payment Order Directory</h2>
        <p>Search, review and manage payment requests</p>
      </div>

      <span class="po-index__count">
        <%= number_with_delimiter(order_total) %> 
        records
      </span>

    </div>


    <!-- FILTERS -->

    <%= render "payment_orders/filter_not_mobile" %>


    <!-- SEARCH -->

    <%= search_form_for @q,
      url: request.path,
      html: { class: "po-index__search" } do |f| %>

      <div class="po-index__search-field">

        <i class="fa-solid fa-magnifying-glass"></i>

        <%= f.search_field :id_eq_or_details_cont_or_amount_cont_or_project_number_cont_or_ballance_number_cont,
  class: "form-control",
  placeholder: "Search PO number, details, amount, project or inventory" %>

      </div>

      <%= f.submit "Search",
        class: "po-index__search-submit" %>

    <% end %>


    <!-- PAYMENT ORDER CARDS -->

    <% if @payment_orders.present? %>

      <ul class="po-index__list" id="payment_order_items">

        <% @payment_orders.each do |payment_order| %>

          <% if !payment_order.mahramane ||
                payment_order.user == current_user ||
                @access_to_secret %>

            <%= render "payment_orders/payment_order",
              payment_order: payment_order %>

          <% end %>

        <% end %>

      </ul>

    <% else %>

      <div class="po-index__empty">

        <div>
          <i class="fa-solid fa-file-invoice-dollar"></i>
        </div>

        <strong>No Payment Orders found</strong>

        <span>
          Try another filter or search term.
        </span>

      </div>

    <% end %>


    <!-- PAGINATION -->

    <% if @payment_orders.respond_to?(:total_pages) &&
          @payment_orders.total_pages > 1 %>

      <div class="po-index__pagination">
        <%= paginate @payment_orders, remote: true %>
      </div>

    <% end %>

  </section>

</div>