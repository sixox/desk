<%
  po = @payment_order
  cu = current_user

  can_view_payment_order =
    user_signed_in? && po.car_payment_visible_to?(cu)

  designated_user_can_confirm =
    user_signed_in? &&
    [29, 47].include?(cu.id) &&
    !po.rejected_at &&
    (
      (po.coo_confirm && !po.accounting_confirm) ||
      (
        !po.department_confirm &&
        cu.role == po.user.role
      )
    )

  manager_can_confirm =
    user_signed_in? &&
    cu.is_manager &&
    !po.rejected_at &&
    (
      (
        cu.ceo? &&
        !po.ceo_confirm &&
        po.coo_confirm &&
        po.accounting_confirm &&
        po.department_confirm
      ) ||
      (
        cu.accounting? &&
        !po.accounting_confirm &&
        po.coo_confirm
      ) ||
      (
        cu.procurement? &&
        !po.coo_confirm &&
        po.department_confirm
      ) ||
      (
        !po.department_confirm &&
        cu.role == po.user.role
      ) ||
      (
        cu.cob? &&
        !po.cob_confirm &&
        po.coo_confirm &&
        po.accounting_confirm &&
        po.department_confirm
      )
    )

  can_confirm =
    designated_user_can_confirm ||
    manager_can_confirm

  can_hamed_confirm =
    po.hamed_confirmable_by?(cu)

  can_mark_delivered =
    user_signed_in? &&
    po.status == "wait for delivery" &&
    (
      (cu.is_manager && cu.procurement?) ||
      cu == po.user
    )

  can_manage_accounting =
    user_signed_in? &&
    (cu.accounting? || cu.admin?) &&
    po.cob_confirm.present? &&
    po.ceo_confirm.present?

  has_actions =
    can_confirm ||
    can_hamed_confirm ||
    can_mark_delivered
%>


<% if can_view_payment_order %>

  <div class="po-show w-100 pb-4"
       style="color: #25344d;">


    <!-- ==================================================
         PAGE HEADER
         ================================================== -->

    <header class="d-flex align-items-center
                   justify-content-between flex-wrap gap-3 mb-4">

      <div>

        <div class="small text-muted mb-2">

          <%= link_to payment_orders_path,
            class: "text-muted text-decoration-none" do %>

            <i class="fa-solid fa-arrow-left me-1"></i>

            Payment Orders

          <% end %>

          <span class="mx-1">/</span>

          Details

        </div>

        <h1 class="fw-bold mb-0"
            style="font-size: 28px; letter-spacing: -.8px;">

          Payment Order
          <span class="text-muted">#<%= po.id %></span>

        </h1>

      </div>


      <%= link_to payment_orders_path,
        class: "btn btn-sm btn-light border rounded-3 px-3 py-2" do %>

        <i class="fa-solid fa-list me-1"></i>

        All Orders

      <% end %>

    </header>


    <%= render "shared/forms/errors", object: po %>


    <!-- ==================================================
         PAYMENT SUMMARY — EXISTING LEDGER CARD
         ================================================== -->

    <section class="mb-3">

      <ul class="list-unstyled p-0 m-0">

        <%= render "payment_orders/payment_order",
          payment_order: po %>

      </ul>

    </section>


    <!-- ==================================================
         AUTHORIZED ACTIONS
         ================================================== -->

    <% if has_actions %>

      <section class="bg-white border rounded-3 shadow-sm mb-3 p-3"
               style="border-left: 4px solid #d99a2b !important;">

        <div class="d-flex align-items-center
                    justify-content-between flex-wrap gap-3">

          <div class="d-flex align-items-center gap-3">

            <div class="d-flex align-items-center
                        justify-content-center rounded-3"
                 style="width: 42px;
                        height: 42px;
                        background: #fff1d2;
                        color: #a66c12;">

              <i class="fa-solid fa-bolt"></i>

            </div>

            <div>

              <h6 class="fw-bold mb-1">
                Action required
              </h6>

              <small class="text-muted">

                <%= cu.role.to_s.titleize %>
                <% if cu.is_manager %> · Manager <% end %>

              </small>

            </div>

          </div>


          <div class="d-flex align-items-center
                      flex-wrap gap-2">


            <% if can_confirm %>

              <%= link_to confirm_payment_order_path(po),
                data: {
                  turbo_method: :patch,
                  turbo_confirm: "Confirm this Payment Order? This action cannot be undone."
                },
                class: "btn btn-success btn-sm rounded-3 px-3 py-2" do %>

                <i class="fa-solid fa-check me-1"></i>

                Confirm

              <% end %>


              <%= link_to reject_payment_order_path(po),
                data: {
                  turbo_method: :patch,
                  turbo_confirm: "Reject this Payment Order? This action cannot be undone."
                },
                class: "btn btn-outline-danger btn-sm rounded-3 px-3 py-2" do %>

                <i class="fa-solid fa-xmark me-1"></i>

                Reject

              <% end %>

            <% end %>


            <% if can_hamed_confirm %>

              <%= link_to hamed_confirm_payment_order_path(po),
                data: {
                  turbo_method: :patch,
                  turbo_confirm: "Confirm this Payment Order?"
                },
                class: "btn btn-success btn-sm rounded-3 px-3 py-2" do %>

                <i class="fa-solid fa-check-double me-1"></i>

                Hamed Confirm

              <% end %>

            <% end %>


            <% if can_mark_delivered %>

              <%= link_to delivered_payment_order_path(po),
                data: {
                  turbo_method: :patch,
                  turbo_confirm: "Mark this Payment Order as delivered?"
                },
                class: "btn btn-primary btn-sm rounded-3 px-3 py-2" do %>

                <i class="fa-solid fa-truck-fast me-1"></i>

                Mark Delivered

              <% end %>

            <% end %>

          </div>

        </div>

      </section>

    <% end %>


    <!-- ==================================================
         PAYMENT DETAILS & DOCUMENTS
         ================================================== -->

    <div class="row g-3 mb-3">


      <!-- PAYMENT DETAILS -->

      <div class="col-xl-7">

        <section class="bg-white border rounded-3
                        shadow-sm h-100 overflow-hidden">


          <header class="d-flex align-items-center gap-3
                         px-3 py-3 border-bottom">

            <div class="d-flex align-items-center
                        justify-content-center rounded-3"
                 style="width: 38px;
                        height: 38px;
                        background: #eaf0fc;
                        color: #3866bc;">

              <i class="fa-solid fa-money-bill-transfer"></i>

            </div>

            <div>

              <h6 class="fw-bold mb-0">
                Payment Details
              </h6>

              <small class="text-muted">
                Beneficiary & bank information
              </small>

            </div>

          </header>


          <%
            from_value =
              po.bank&.name.presence ||
              po.from.presence

            details = [
              [
                "Payment destination",
                po.to,
                "fa-location-dot"
              ],
              [
                "From",
                from_value,
                "fa-building-columns"
              ],
              [
                "Receiver",
                po.receiver,
                "fa-user"
              ],
              [
                "Receiver account",
                po.receiver_account,
                "fa-credit-card"
              ],
              [
                "Exchange rate",
                po.exchange_rate.present? ?
                  number_with_delimiter(po.exchange_rate) : nil,
                "fa-right-left"
              ],
              [
                "Exchange amount",
                po.exchange_amount.present? ?
                  number_with_delimiter(po.exchange_amount) : nil,
                "fa-money-bill-wave"
              ]
            ].select do |_, value, _|
              value.present?
            end
          %>


          <div class="p-3">

            <div class="row g-3">

              <% details.each do |label, value, icon| %>

                <div class="col-md-6">

                  <div class="d-flex align-items-start gap-2
                              rounded-3 p-3 h-100"
                       style="background: #f5f7fa;">

                    <i class="fa-solid <%= icon %> text-secondary mt-1"
                       style="font-size: 13px;"></i>

                    <div class="flex-grow-1"
                         style="min-width: 0;">

                      <small class="d-block text-muted mb-1">
                        <%= label %>
                      </small>

                      <strong class="d-block text-break"
                              style="font-size: 14px;">

                        <%= value %>

                      </strong>

                    </div>

                  </div>

                </div>

              <% end %>

            </div>


            <!-- ACCOUNTING INDICATORS -->

            <div class="d-flex align-items-center
                        flex-wrap gap-3 mt-3 pt-3 border-top">

              <span class="small fw-semibold
                           <%= po.have_factor? ? 'text-success' : 'text-muted' %>">

                <i class="fa-solid <%= po.have_factor? ?
                  'fa-circle-check' : 'fa-circle-minus' %> me-1"></i>

                <%= po.have_factor? ? "Has factor" : "No factor" %>

              </span>


              <span class="small fw-semibold
                           <%= po.inserted? ? 'text-success' : 'text-muted' %>">

                <i class="fa-solid <%= po.inserted? ?
                  'fa-circle-check' : 'fa-clock' %> me-1"></i>

                <%= po.inserted? ?
                  "Inserted in accounting" :
                  "Not inserted" %>

              </span>

            </div>

          </div>

        </section>

      </div>


      <!-- DOCUMENTS -->

      <div class="col-xl-5">

        <section class="bg-white border rounded-3
                        shadow-sm h-100 overflow-hidden">

          <header class="d-flex align-items-center gap-3
                         px-3 py-3 border-bottom">

            <div class="d-flex align-items-center
                        justify-content-center rounded-3"
                 style="width: 38px;
                        height: 38px;
                        background: #fff0e8;
                        color: #bd6738;">

              <i class="fa-solid fa-paperclip"></i>

            </div>

            <div>

              <h6 class="fw-bold mb-0">
                Documents
              </h6>

              <small class="text-muted">

                <%= [po.document, po.receipt].count(&:attached?) %>
                attachments

              </small>

            </div>

          </header>


          <div class="p-3 d-flex flex-column gap-2">

            <% [
              [
                po.document,
                "Supporting document",
                "fa-file-lines",
                "#c24958",
                "#fce9ec"
              ],
              [
                po.receipt,
                "Payment receipt",
                "fa-receipt",
                "#16834f",
                "#e5f4eb"
              ]
            ].each do |attachment, label, icon, color, background| %>


              <% if attachment.attached? %>

                <%= link_to rails_blob_path(
                  attachment,
                  disposition: "attachment"
                ),
                target: "_blank",
                rel: "noopener",
                class: "d-flex align-items-center gap-3
                        text-decoration-none border rounded-3 p-3" do %>

                  <div class="d-flex align-items-center
                              justify-content-center rounded-3 flex-shrink-0"
                       style="width: 43px;
                              height: 43px;
                              background: <%= background %>;
                              color: <%= color %>;">

                    <i class="fa-solid <%= icon %>"></i>

                  </div>

                  <div class="flex-grow-1"
                       style="min-width: 0;">

                    <strong class="d-block text-dark small">

                      <%= label %>

                    </strong>

                    <small class="d-block text-muted text-break mt-1">

                      <%= attachment.filename %>

                    </small>

                    <small class="text-muted">

                      <%= number_to_human_size(attachment.byte_size) %>

                    </small>

                  </div>

                  <i class="fa-solid fa-download text-primary"></i>

                <% end %>

              <% else %>

                <div class="d-flex align-items-center
                            gap-3 rounded-3 p-3"
                     style="background: #f5f7fa;">

                  <div class="d-flex align-items-center
                              justify-content-center rounded-3"
                       style="width: 43px;
                              height: 43px;
                              background: #e9edf3;
                              color: #94a3b8;">

                    <i class="fa-solid <%= icon %>"></i>

                  </div>

                  <div>

                    <strong class="d-block text-secondary small">

                      <%= label %>

                    </strong>

                    <small class="text-muted">

                      Not uploaded

                    </small>

                  </div>

                </div>

              <% end %>

            <% end %>

          </div>

        </section>

      </div>

    </div>


    <!-- ==================================================
         RELATED BUSINESS RECORDS
         ================================================== -->

    <%
      related_records = []

      if po.project.present?
        related_records << [
          "Project",
          po.project.number,
          "fa-folder-open",
          project_path(po.project)
        ]
      end

      if po.booking.present?
        related_records << [
          "Booking",
          po.booking.number,
          "fa-boxes-stacked",
          po.booking.project.present? ?
            project_path(po.booking.project) : nil
        ]
      end

      if po.ballance.present?
        related_records << [
          "Inventory",
          po.ballance.number,
          "fa-warehouse",
          ballance_path(po.ballance)
        ]
      end

      if po.spi.present?
        related_records << [
          "Inventory PI",
          po.spi.number,
          "fa-file-invoice",
          nil
        ]
      end

      if po.sci.present?
        related_records << [
          "Inventory CI",
          po.sci.number,
          "fa-file-invoice-dollar",
          nil
        ]
      end

      if po.car_pi.present?
        related_records << [
          "Car Project / PI",
          po.car_pi.pi_label,
          "fa-car-side",
          cu.car_access? ?
            cars_path(
              tab: "PIs",
              project: po.car_pi.fields["Project No."],
              pi: po.car_pi.external_key
            ) : nil
        ]
      end
    %>


    <% if related_records.any? %>

      <section class="bg-white border rounded-3
                      shadow-sm mb-3 overflow-hidden">

        <header class="d-flex align-items-center gap-3
                       px-3 py-3 border-bottom">

          <div class="d-flex align-items-center
                      justify-content-center rounded-3"
               style="width: 38px;
                      height: 38px;
                      background: #eaeffa;
                      color: #3866bc;">

            <i class="fa-solid fa-link"></i>

          </div>

          <div>

            <h6 class="fw-bold mb-0">
              Related Records
            </h6>

            <small class="text-muted">
              Associated business documents
            </small>

          </div>

        </header>


        <div class="p-3">

          <div class="row g-2">

            <% related_records.each do |label, value, icon, path| %>

              <div class="col-md-6 col-xl-4">

                <% if path.present? %>

                  <%= link_to path,
                    class: "d-flex align-items-center gap-3
                            border rounded-3 p-3 h-100
                            text-decoration-none" do %>

                    <i class="fa-solid <%= icon %> text-primary"></i>

                    <div class="flex-grow-1"
                         style="min-width: 0;">

                      <small class="d-block text-muted">
                        <%= label %>
                      </small>

                      <strong class="d-block small text-break">
                        <%= value %>
                      </strong>

                    </div>

                    <i class="fa-solid fa-arrow-up-right-from-square small"></i>

                  <% end %>

                <% else %>

                  <div class="d-flex align-items-center gap-3
                              border rounded-3 p-3 h-100">

                    <i class="fa-solid <%= icon %> text-secondary"></i>

                    <div style="min-width: 0;">

                      <small class="d-block text-muted">
                        <%= label %>
                      </small>

                      <strong class="d-block small text-break">
                        <%= value %>
                      </strong>

                    </div>

                  </div>

                <% end %>

              </div>

            <% end %>

          </div>

        </div>

      </section>

    <% end %>


    <!-- ==================================================
         ACCOUNTING & PAYMENT
         ================================================== -->

    <% if can_manage_accounting %>

      <section class="bg-white border rounded-3
                      shadow-sm mb-3 overflow-hidden">

        <header class="d-flex align-items-center
                       justify-content-between flex-wrap gap-3
                       px-3 py-3 border-bottom">

          <div class="d-flex align-items-center gap-3">

            <div class="d-flex align-items-center
                        justify-content-center rounded-3"
                 style="width: 38px;
                        height: 38px;
                        background: #e2f3e9;
                        color: #16834f;">

              <i class="fa-solid fa-building-columns"></i>

            </div>

            <div>

              <h6 class="fw-bold mb-0">
                Accounting & Payment
              </h6>

              <small class="text-muted">
                Record bank transaction and receipt
              </small>

            </div>

          </div>


          <small class="text-success fw-semibold">

            <i class="fa-solid fa-shield-halved me-1"></i>

            Authorized access

          </small>

        </header>


        <%= render "payment_orders/accounting_form",
          payment_order: po %>

      </section>

    <% end %>


    <!-- ==================================================
         COMMENTS
         ================================================== -->

    <section class="bg-white border rounded-3
                    shadow-sm overflow-hidden">

      <header class="d-flex align-items-center
                     justify-content-between flex-wrap gap-3
                     px-3 py-3 border-bottom">

        <div class="d-flex align-items-center gap-3">

          <div class="d-flex align-items-center
                      justify-content-center rounded-3"
               style="width: 38px;
                      height: 38px;
                      background: #eef0f8;
                      color: #6777a5;">

            <i class="fa-regular fa-comments"></i>

          </div>

          <div>

            <h6 class="fw-bold mb-0">
              Comments
            </h6>

            <small class="text-muted">
              Discussion & supporting notes
            </small>

          </div>

        </div>


        <%= link_to new_payment_order_comment_path(po),
          data: {
            controller: "bs-modal-form",
            payment_order_id: po.id
          },
          class: "btn btn-sm btn-outline-primary rounded-3 px-3 py-2" do %>

          <i class="fa-solid fa-plus me-1"></i>

          Add Comment

        <% end %>

      </header>


      <div class="p-3">

        <ul class="list-group list-unstyled m-0"
            id="comment_items">

          <% po.comments.reverse.each do |comment| %>

            <%= render "comments/comment",
              comment: comment %>

          <% end %>

        </ul>

      </div>

    </section>

  </div>


<% else %>


  <!-- ==================================================
       RESTRICTED PAYMENT ORDER
       ================================================== -->

  <div class="bg-white border rounded-3
              shadow-sm text-center p-5">

    <div class="d-inline-flex align-items-center
                justify-content-center rounded-circle mb-3"
         style="width: 75px;
                height: 75px;
                background: #fff0f2;
                color: #c43d50;">

      <i class="fa-solid fa-lock fa-2x"></i>

    </div>

    <h3 class="fw-bold mb-2">

      Restricted Payment Order

    </h3>

    <p class="text-muted mb-4">

      You do not have permission to view this confidential
      Payment Order.

    </p>

    <%= link_to payment_orders_path,
      class: "btn btn-outline-secondary rounded-3" do %>

      <i class="fa-solid fa-arrow-left me-1"></i>

      Back to Payment Orders

    <% end %>

  </div>


<% end %>