<%= form_with model: @payment_order, class: "po-form" do |form| %>

  <div class="modal-body po-form__body">

    <% if @payment_order.errors.any? %>
      <div class="po-form__errors">
        <% @payment_order.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <div class="po-form__flags">
      <label class="po-form__flag">
        <%= form.check_box :mahramane, class: "form-check-input" %>
        <span><i class="fa-solid fa-lock"></i> Secret</span>
      </label>

      <label class="po-form__flag">
        <%= form.check_box :is_rahkarsazan, class: "form-check-input" %>
        <span><i class="fa-solid fa-building"></i> Rahkarsazan</span>
      </label>
    </div>

    <div class="po-form__grid">

<% if current_user.car_access? %>
  <div class="po-form__field po-form__field--wide">
    <%= form.label :car_pi_id, 'Car Project / PI' %>
    <% if form.object.car_pi_locked? || (form.object.persisted? && form.object.receipt.attached?) %>
      <div class="form-control"><%= form.object.car_pi&.pi_label || 'Not assigned' %> · Locked after approval</div>
    <% else %>
      <% car_pis = CarImportRecord.pis.current.to_a %>
      <% car_pis |= [form.object.car_pi] if form.object.car_pi.present? %>
      <% groups = car_pis.group_by { |r| r.fields['Project No.'].presence || 'Unassigned' }.sort_by(&:first).map { |project, rows| [project, rows.sort_by(&:external_key).map { |r| ["#{r.external_key}#{' (archived)' unless r.active?}", r.id] }] } %>
      <%= form.select :car_pi_id, grouped_options_for_select(groups, form.object.car_pi_id), {include_blank: 'Not a car payment'}, class: 'form-select' %>
      <small class="text-muted">Select a car PI instead of an ordinary project or inventory reference.</small>
    <% end %>
  </div>
<% end %>
      <div class="po-form__field po-form__field--amount">
        <%= form.label :amount %>
        <%= form.number_field :amount,
          class: "form-control",
          step: "any",
          required: true %>
      </div>

      <div class="po-form__field">
        <%= form.label :currency %>
        <%= form.select :currency,
          options_for_select(Pi::CURRENCY, selected: form.object.currency),
          { prompt: "Currency" },
          { class: "form-select", required: true } %>
      </div>

      <div class="po-form__field po-form__field--wide">
        <%= form.label :bank_id, "Bank" %>
        <%= form.collection_select :bank_id, @banks, :id, :name,
          { prompt: "Select bank" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :to, "Payment to" %>
        <%= form.text_field :to, class: "form-control" %>
      </div>

      <div class="po-form__field">
        <%= form.label :receiver %>
        <%= form.text_field :receiver, class: "form-control" %>
      </div>

      <div class="po-form__field po-form__field--wide">
        <%= form.label :receiver_account %>
        <%= form.text_field :receiver_account, class: "form-control" %>
      </div>

      <div class="po-form__field">
        <%= form.label :project_id, "Project" %>
        <%= form.collection_select :project_id, @projects, :id, :number,
          { prompt: "Select project" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :booking_id, "Booking" %>
        <%= form.collection_select :booking_id, @bookings, :id, :number,
          { prompt: "Select booking" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :ballance_id, "Inventory" %>
        <%= form.collection_select :ballance_id, @ballances, :id, :number,
          { prompt: "Select inventory" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :spi_id, "Inventory PI" %>
        <%= form.collection_select :spi_id, @spis, :id, :number,
          { prompt: "Select PI" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :sci_id, "Inventory CI" %>
        <%= form.collection_select :sci_id, @scis, :id, :number,
          { prompt: "Select CI" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field">
        <%= form.label :cost_type %>
        <%= form.select :cost_type,
          PaymentOrder::COST_TYPES,
          { include_blank: "Select cost type" },
          { class: "form-select" } %>
      </div>

      <div class="po-form__field po-form__field--wide">
        <%= form.label :details, "Details" %>
        <%= form.text_area :details,
          class: "form-control",
          rows: 2 %>
      </div>

      <div class="po-form__field po-form__field--wide">
        <label class="po-form__upload">
          <span><i class="fa-solid fa-paperclip"></i> Document</span>
          <%= form.file_field :document, class: "form-control" %>
          <% if @payment_order.document.attached? %>
            <small>Current: <%= @payment_order.document.filename %></small>
          <% end %>
        </label>
      </div>

      <div class="po-form__field po-form__field--wide">
        <label class="po-form__factor">
          <%= form.check_box :have_factor, class: "form-check-input" %>
          <span>Has factor</span>
        </label>
      </div>

    </div>

  </div>

  <div class="modal-footer po-form__footer">
    <button type="button"
      class="btn btn-light"
      data-bs-dismiss="modal">
      Cancel
    </button>

    <%= form.submit "Save Payment Order",
      class: "btn btn-primary",
      data: { action: "click->bs-modal#submitEnd" } %>
  </div>

<% end %>