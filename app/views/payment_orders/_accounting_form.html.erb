<%= form_with model: payment_order,
  class: "po-accounting-form" do |form| %>

  <div class="modal-body erp-form">

    <%= render "shared/forms/errors",
      object: payment_order %>


    <%= render "shared/forms/section_heading",
      title: "Bank Payment",
      description: "Record the bank used to make this payment and any currency conversion.",
      icon: "fa-building-columns" %>


    <div class="row g-3 mb-4">

      <div class="col-md-4">

        <%= render "shared/forms/field",
          form: form,
          attribute: :exchange_rate,
          label: "Exchange Rate",
          type: :number_field,
          input_options: {
            min: 0,
            step: "any"
          } %>

      </div>

      <div class="col-md-4">

        <%= render "shared/forms/field",
          form: form,
          attribute: :exchange_amount,
          label: "Bank Withdrawal Amount",
          type: :number_field,
          input_options: {
            min: 0,
            step: "any"
          } %>

      </div>

      <div class="col-md-4">

        <%= render "shared/forms/field",
          form: form,
          attribute: :bank_id,
          label: "Bank",
          type: :select,
          choices: @banks.map { |bank| [bank.name, bank.id] },
          select_options: { prompt: "Select bank" },
          required: true %>

      </div>

    </div>


    <div class="po-form__switch">

      <div>
        <strong>Inserted</strong>
        <small>Mark this payment as inserted in the accounting system.</small>
      </div>

      <%= form.check_box :inserted,
        class: "form-check-input" %>

    </div>


    <div class="erp-form__divider"></div>


    <%= render "shared/forms/section_heading",
      title: "Payment Receipt",
      description: "Attach the receipt confirming the bank payment.",
      icon: "fa-receipt" %>


    <% if payment_order.receipt.attached? %>

      <div class="po-form__existing-file">

        <i class="fa-solid fa-file-circle-check"></i>

        <%= link_to payment_order.receipt.filename,
          rails_blob_path(
            payment_order.receipt,
            disposition: "attachment"
          ),
          target: "_blank",
          rel: "noopener" %>

        <span>Current receipt</span>

      </div>

    <% else %>

      <%= render "shared/forms/field",
  form: form,
  attribute: :receipt,
  label: "Upload Payment Receipt",
  type: :file_field,
  required: true %>

    <% end %>

  </div>


  <!-- ACCOUNTING ACTIONS -->

  <div class="po-accounting-form__actions">

    <%= form.submit "Save Accounting Details",
      class: "po-show__action po-show__action--confirm" %>


    <% if payment_order.status == "wait for payment" %>

      <%= link_to toggle_announce_payment_order_path(payment_order),
        data: {
          turbo: false,
          turbo_method: :patch,
          turbo_confirm: "Change the announcement status?"
        },
        class: "po-show__action po-show__action--delivery" do %>

        <i class="fa-solid fa-bullhorn"></i>
        Announce

      <% end %>

    <% end %>


    <% if payment_order.currency == "rial" &&
          payment_order.rial_receipt.nil? %>

      <%= link_to new_payment_order_rial_receipt_path(payment_order),
        data: { controller: "bs-modal-form" },
        class: "po-show__action po-show__action--special" do %>

        <i class="fa-solid fa-plus"></i>
        Create Rial Receipt

      <% end %>


    <% elsif payment_order.currency == "rial" &&
             payment_order.rial_receipt.present? %>

      <%= link_to payment_order_rial_receipt_path(
            payment_order,
            payment_order.rial_receipt
          ),
        class: "po-show__action" do %>

        <i class="fa-solid fa-eye"></i>
        View Rial Receipt

      <% end %>


      <%= link_to edit_payment_order_rial_receipt_path(
            payment_order,
            payment_order.rial_receipt
          ),
        data: { controller: "bs-modal-form" },
        class: "po-show__action po-show__action--delivery" do %>

        <i class="fa-solid fa-pen"></i>
        Edit Rial Receipt

      <% end %>


      <%= link_to payment_order_rial_receipt_path(
            payment_order,
            payment_order.rial_receipt
          ),
        data: {
          turbo_method: :delete,
          turbo_confirm: "Delete this Rial Receipt?"
        },
        class: "po-show__action po-show__action--reject" do %>

        <i class="fa-solid fa-trash"></i>
        Delete Rial Receipt

      <% end %>

    <% end %>

  </div>

<% end %>