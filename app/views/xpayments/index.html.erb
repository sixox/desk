<div class="col-lg-10 mx-auto mt-5">

<div class="container-fluid py-3 exchange-page">


  <div class="exchange-header d-flex justify-content-between align-items-center">

    <div>
      <h5 class="exchange-title">
        Payments
      </h5>

      <div class="exchange-subtitle">
        <%= @xpayments.count %> records
      </div>
    </div>

    <%= link_to new_xpayment_path,
      data: { controller: "bs-modal-form" },
      class: "btn btn-success exchange-create" do %>

      <i class="bi bi-plus"></i>
      Create Payment

    <% end %>

  </div>


  <div class="exchange-card">

    <div class="table-responsive">

      <table class="table table-striped exchange-table align-middle mb-0">

        <thead>

          <tr>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Sent</th>
            <th>Received</th>
            <th>Wage</th>
            <th>Attach</th>
            <th class="text-end">Actions</th>
          </tr>

        </thead>


        <tbody>

          <% @xpayments.each do |xpayment| %>

            <tr>

              <!-- SENDER -->

              <td>

                <div class="account-name">
                  <%= xpayment.sender_account.organization.name %>
                </div>

                <span class="account-number">
                  <%= xpayment.sender_account.number %>
                </span>

              </td>


              <!-- RECEIVER -->

              <td>

                <div class="account-name">
                  <%= xpayment.receiver_account.organization.name %>
                </div>

                <span class="account-number">
                  <%= xpayment.receiver_account.number %>
                </span>

              </td>


              <!-- SENT -->

              <td>

                <span class="amount-value text-danger">
                  <%= number_with_delimiter(xpayment.sent_amount) %>
                </span>
                 <span class="currency-inline">
                  <%= xpayment.currency.name %>
                </span>

              </td>


              <!-- RECEIVED -->

              <td>

                <span class="amount-value text-success">
                  <%= number_with_delimiter(xpayment.received_amount) %>
                </span>
                 <span class="currency-inline">
                  <%= xpayment.currency.name %>
                </span>

              </td>




              <!-- WAGE -->

              <td>

                <span class="amount-value">
                  <%= number_with_delimiter(xpayment.wage) %>
                </span>

              </td>

                      <td>
          <% if xpayment.documents.attached? %>

          <span class="badge bg-light text-dark">
            <i class="bi bi-paperclip"></i>
            <%= xpayment.documents.count %>
          </span>

          <% else %>

          <span class="text-muted">—</span>

          <% end %>
        </td>


              <!-- ACTIONS -->

              <td class="text-end">

                <div class="xe-actions">

                  <%= link_to edit_xpayment_path(xpayment),
                    data: { controller: "bs-modal-form" },
                    class: "btn btn-sm btn-outline-secondary xt-action" do %>
                    <span>Edit</span>

                    <i class="bi bi-pencil"></i>

                  <% end %>


                  <%= button_to(
                    xpayment_path(xpayment),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger xt-action",
                    form: {
                      data: {
                        turbo_confirm: "Delete this payment?"
                      }
                    }
                  ) do %>

                    <i class="bi bi-trash3"></i>

                  <% end %>

                </div>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>

</div>
<%= turbo_frame_tag "modal" %>
