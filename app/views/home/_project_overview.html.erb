<%
  stats = [
    {
      label: "Without PI",
      value: @project_dashboard[:projects_without_pi],
      note: "Projects needing a PI",
      icon: "fa-file-circle-question",
      color: "c4"
    },
    {
      label: "Sales Open",
      value: @project_dashboard[:sales_open],
      note: "Commercial stage unfinished",
      icon: "fa-handshake",
      color: "c1"
    },
    {
      label: "Open Logistics",
      value: @project_dashboard[:logistics_open],
      note: "Projects not completed",
      icon: "fa-truck-fast",
      color: "c2"
    },
    {
      label: "Unpaid CIs",
      value: @project_dashboard[:unpaid_cis],
      note: "Awaiting confirmed receipt",
      icon: "fa-file-invoice",
      color: "c3"
    },
    {
      label: "Pending POs",
      value: @project_dashboard[:pending_payment_orders],
      note: "Orders waiting for processing",
      icon: "fa-money-bill-transfer",
      color: "c4"
    }
  ]
%>

<section class="project-trading-overview mb-4">

  <!-- HEADER -->

  <header class="project-trading-overview__header">

    <div class="project-trading-overview__identity">

      <div class="project-trading-overview__icon">
        <i class="fa-solid fa-ship"></i>
      </div>

      <div>
        <div class="project-trading-overview__title-line">
          <h2>Trading & Projects</h2>

          <span class="project-trading-overview__total">
            <%= number_with_delimiter(@project_dashboard[:total_projects]) %>
            projects
          </span>
        </div>

        <p>
          Commercial activity, customer receipts and project execution
        </p>
      </div>

    </div>


    <nav class="project-trading-overview__actions">

      <%= link_to projects_path, class: "m-btn m-btn--ghost" do %>
        <i class="fa-solid fa-folder-open me-1"></i>
        All Projects
      <% end %>

      <%= link_to release_requests_path, class: "m-btn m-btn--ghost" do %>
        <i class="fa-solid fa-file-signature me-1"></i>
        Releases
      <% end %>

      <%= link_to turnovers_projects_path, class: "m-btn m-btn--ghost" do %>
        <i class="fa-solid fa-chart-line me-1"></i>
        DSO
      <% end %>

    </nav>

  </header>


  <!-- COMPACT TRADING INDICATORS -->

  <div class="row row-tight project-trading-overview__stats">

    <% stats.each do |item| %>

      <div class="col-6 col-lg">

        <article class="stat-card h-100">

          <div class="stat-card__head">

            <p class="stat-card__label">
              <%= item[:label] %>
            </p>

            <span class="stat-card__icon stat-card__icon--<%= item[:color] %>">
              <i class="fa-solid <%= item[:icon] %>"></i>
            </span>

          </div>

          <p class="stat-card__value">
            <%= number_with_delimiter(item[:value]) %>
          </p>

          <p class="stat-card__delta">
            <%= item[:note] %>
          </p>

        </article>

      </div>

    <% end %>

  </div>


  <!-- RECENT PROJECTS -->

  <div class="project-trading-overview__recent-header">

    <div>
      <h3>Recently Updated</h3>
      <p>Latest project activity across the company</p>
    </div>

    <span>
      <i class="fa-solid fa-clock-rotate-left"></i>
      Latest <%= @dashboard_recent_projects.size %>
    </span>

  </div>


  <% if @dashboard_recent_projects.any? %>

    <div class="row g-3">

      <% @dashboard_recent_projects.each do |project| %>

        <div class="col-12 col-md-6 col-xl-4">

          <%= render "projects/project_card",
            project: project %>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="project-trading-overview__empty">

      <i class="fa-solid fa-folder-open"></i>

      <div>
        <strong>No projects yet</strong>
        <span>New projects will appear here.</span>
      </div>

    </div>

  <% end %>

</section>