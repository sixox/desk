
<section class="m-card mb-3">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Bank Accounts</h2>
      <p class="m-card__subtitle">
        Current and expected balances
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary-subtle text-primary">
        <%= @banks.size %> accounts
      </span>

      <%= link_to "View all", banks_path, class: "m-btn m-btn--ghost" %>
    </div>
  </header>

  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">

      <thead>
        <tr>
          <th>Account</th>
          <th class="text-end">Current Balance</th>
          <th class="text-end">Expected Balance</th>
          <th>Currency</th>
        </tr>
      </thead>

      <tbody>
        <% @banks.each do |bank| %>
          <tr>
            <td>
              <%= link_to bank.name, bank_path(bank), class: "fw-medium" %>
            </td>

            <td class="text-end fw-semibold text-nowrap">
              <%= number_with_delimiter(bank.account_balance, delimiter: ",") %>
            </td>

            <td class="text-end text-body-secondary text-nowrap">
              <%= number_with_delimiter(bank.total_expected_balance, delimiter: ",") %>
            </td>

            <td>
              <span class="badge bg-secondary-subtle text-secondary">
                <%= bank.currency %>
              </span>
            </td>
          </tr>
        <% end %>

        <% if @banks.empty? %>
          <tr>
            <td colspan="4" class="text-center text-body-secondary py-3">
              No bank accounts.
            </td>
          </tr>
        <% end %>

      </tbody>

    </table>
  </div>

</section>
