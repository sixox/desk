
<div class="row row-tight">

  <!-- PAYMENT ORDERS -->
  <div class="col-12 col-xl-6">

    <section class="m-card mb-3 h-100">

      <header class="m-card__header">
        <div>
          <h2 class="m-card__title">Latest Payment Orders</h2>
          <p class="m-card__subtitle">Recent payment activity</p>
        </div>

        <%= link_to "View all", payment_orders_path, class: "m-btn m-btn--ghost" %>
      </header>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">

          <thead>
            <tr>
              <th>PO</th>
              <th>Amount</th>
              <th>Details</th>
            </tr>
          </thead>

          <tbody>
            <% @latest_payment_orders.first(6).each do |payment_order| %>
              <tr>
                <td>
                  <%= link_to payment_order.id, payment_order_path(payment_order) %>
                </td>

                <td class="fw-semibold text-nowrap">
                  <%= number_with_delimiter(payment_order.amount, delimiter: ",") %>
                  <small class="text-body-secondary">
                    <%= payment_order.currency %>
                  </small>
                </td>

                <td class="text-body-secondary small">
                  <span title="<%= payment_order.details %>">
                    <%= truncate(payment_order.details, length: 35) %>
                  </span>
                </td>
              </tr>
            <% end %>

            <% if @latest_payment_orders.empty? %>
              <tr>
                <td colspan="3" class="text-center text-body-secondary py-3">
                  No payment orders.
                </td>
              </tr>
            <% end %>

          </tbody>

        </table>
      </div>

    </section>

  </div>

  <!-- TRANSACTIONS -->
  <div class="col-12 col-xl-6">

    <section class="m-card mb-3 h-100">

      <header class="m-card__header">
        <div>
          <h2 class="m-card__title">Latest Transactions</h2>
          <p class="m-card__subtitle">Recent bank transactions</p>
        </div>
      </header>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">

          <thead>
            <tr>
              <th>Bank</th>
              <th>Reference</th>
              <th>Amount</th>
              <th>Date</th>
            </tr>
          </thead>

          <tbody>
            <% @transactions.first(6).each do |transaction| %>
              <tr>
                <td class="small">
                  <%= transaction.bank&.name || "—" %>
                </td>

                <td class="small">
                  <% if transaction.transactionable_type == "PaymentOrder" %>
                    <%= link_to "PO ##{transaction.transactionable_id}",
                      payment_order_path(transaction.transactionable_id) %>
                  <% else %>
                    <%= transaction.transactionable_type %>
                    #<%= transaction.transactionable_id %>
                  <% end %>
                </td>

                <td class="fw-semibold text-nowrap <%= transaction.deposit_amount.present? ? 'text-success' : 'text-danger' %>">
                  <%= transaction.deposit_amount.present? ? "+" : "−" %>
                  <%= number_with_delimiter(
                    transaction.deposit_amount.presence || transaction.withdrawal_amount,
                    delimiter: ","
                  ) %>
                </td>

                <td class="text-body-secondary small text-nowrap">
                  <%= (transaction.created_at + 3.5.hours).strftime("%d %b %H:%M") %>
                </td>
              </tr>
            <% end %>

            <% if @transactions.empty? %>
              <tr>
                <td colspan="4" class="text-center text-body-secondary py-3">
                  No transactions.
                </td>
              </tr>
            <% end %>

          </tbody>

        </table>
      </div>

    </section>

  </div>

</div>
