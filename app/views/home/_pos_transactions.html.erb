
<div class="row row-tight">

  <!-- PAYMENT ORDERS -->
<div class="col-12 col-xl-6">

  <section class="m-card mb-3 h-100 po-dashboard-card">

    <header class="m-card__header">

      <div>
        <h2 class="m-card__title">
          <i class="fa-solid fa-money-bill-transfer me-2"></i>
          Latest Payment Orders
        </h2>

        <p class="m-card__subtitle">
          Recent company payment requests
        </p>
      </div>

      <%= link_to "View all",
        payment_orders_path,
        class: "m-btn m-btn--ghost" %>

    </header>


    <div class="po-dashboard-list">

      <% @latest_payment_orders.first(6).each do |payment_order| %>

        <%
          label, status_class =
            case payment_order.status
            when "wait for confirm"
              ["Confirmation", "is-confirmation"]
            when "wait for payment"
              ["Payment pending", "is-payment"]
            when "wait for delivery"
              ["Delivery pending", "is-delivery"]
            when "delivered"
              ["Delivered", "is-delivered"]
            when "rejected"
              ["Rejected", "is-rejected"]
            else
              [payment_order.status.to_s.humanize, "is-pending"]
            end
        %>

        <%= link_to payment_order_path(payment_order),
          class: "po-dashboard-item" do %>

          <div class="po-dashboard-item__icon">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>

          <div class="po-dashboard-item__main">

            <strong>
              PO #<%= payment_order.id %>
            </strong>

            <small>
              <%= truncate(payment_order.details, length: 48) %>
            </small>

          </div>

          <div class="po-dashboard-item__side">

            <strong>
              <%= number_with_delimiter(payment_order.amount, delimiter: ",") %>
            </strong>

            <small>
              <%= payment_order.currency.to_s.upcase %>
            </small>

            <span class="po-card__status <%= status_class %>">
              <%= label %>
            </span>

          </div>

        <% end %>

      <% end %>


      <% if @latest_payment_orders.empty? %>

        <div class="po-index__empty">
          <i class="fa-regular fa-folder-open"></i>
          <strong>No Payment Orders</strong>
          <span>Recent payment activity will appear here.</span>
        </div>

      <% end %>

    </div>

  </section>

</div>

  <!-- TRANSACTIONS -->
  <div class="col-12 col-xl-6">

    <section class="m-card mb-3 h-100">

      <header class="m-card__header">
        <div>
          <h2 class="m-card__title">Latest Transactions</h2>
          <p class="m-card__subtitle">Recent bank transactions</p>
        </div>
      </header>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">

          <thead>
            <tr>
              <th>Bank</th>
              <th>Reference</th>
              <th>Amount</th>
              <th>Date</th>
            </tr>
          </thead>

          <tbody>
            <% @transactions.first(6).each do |transaction| %>
              <tr>
                <td class="small">
                  <%= transaction.bank&.name || "—" %>
                </td>

                <td class="small">
                  <% if transaction.transactionable_type == "PaymentOrder" %>
                    <%= link_to "PO ##{transaction.transactionable_id}",
                      payment_order_path(transaction.transactionable_id) %>
                  <% else %>
                    <%= transaction.transactionable_type %>
                    #<%= transaction.transactionable_id %>
                  <% end %>
                </td>

                <td class="fw-semibold text-nowrap <%= transaction.deposit_amount.present? ? 'text-success' : 'text-danger' %>">
                  <%= transaction.deposit_amount.present? ? "+" : "−" %>
                  <%= number_with_delimiter(
                    transaction.deposit_amount.presence || transaction.withdrawal_amount,
                    delimiter: ","
                  ) %>
                </td>

                <td class="text-body-secondary small text-nowrap">
                  <%= (transaction.created_at + 3.5.hours).strftime("%d %b %H:%M") %>
                </td>
              </tr>
            <% end %>

            <% if @transactions.empty? %>
              <tr>
                <td colspan="4" class="text-center text-body-secondary py-3">
                  No transactions.
                </td>
              </tr>
            <% end %>

          </tbody>

        </table>
      </div>

    </section>

  </div>

</div>
