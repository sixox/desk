
<section class="m-card mb-3 h-100">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Commercial Invoices</h2>
      <p class="m-card__subtitle">Six-month invoice trend</p>
    </div>

    <%= link_to "All", cis_path, class: "m-btn m-btn--ghost" %>
  </header>

  <div style="height: 125px; position: relative;">
    <canvas
      data-controller="dashboard-chart"
      data-dashboard-chart-unit-value="Dirham"
      data-dashboard-chart-config-value="<%= {
        type: "bar",
        data: {
          labels: @months,
          datasets: [{
            label: "CI Amount",
            data: @totals_ci,
            backgroundColor: "rgba(20, 184, 166, 0.18)",
            borderColor: "#14b8a6",
            borderWidth: 1,
            borderRadius: 4,
            maxBarThickness: 28
          }]
        }
      }.to_json %>">
    </canvas>
  </div>

  <div class="border-top mt-3 pt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small fw-semibold">Latest CIs</span>
      <span class="text-body-secondary small"><%= @latest_cis.size %> records</span>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>CI</th>
            <th>Project</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          <% @latest_cis.each do |ci| %>
            <tr>
              <td class="fw-semibold">
                <%= ci.number %>
              </td>

              <td>
                <%= link_to ci.project_number, project_path(ci.project_id) %>
              </td>

              <td class="text-nowrap small fw-semibold">
                <%= number_with_delimiter(ci.balance_payment, delimiter: ",") %>
                <small class="text-body-secondary"><%= ci.ci_currency %></small>
              </td>

              <td>
                <% if ci.swift.present? %>
                  <span class="badge bg-success-subtle text-success">Paid</span>
                <% else %>
                  <span class="badge bg-warning-subtle text-warning-emphasis">Unpaid</span>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @latest_cis.empty? %>
            <tr>
              <td colspan="4" class="text-center text-body-secondary py-3">
                No CIs.
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

</section>
