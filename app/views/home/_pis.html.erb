
<section class="m-card mb-3 h-100">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Proforma Invoices</h2>
      <p class="m-card__subtitle">Six-month sales trend</p>
    </div>

    <%= link_to "All", pis_path, class: "m-btn m-btn--ghost" %>
  </header>

  <div style="height: 125px; position: relative;">
    <canvas
      data-controller="dashboard-chart"
      data-dashboard-chart-unit-value="Dirham"
      data-dashboard-chart-config-value="<%= {
        type: "bar",
        data: {
          labels: @months,
          datasets: [{
            label: "PI Amount",
            data: @totals,
            backgroundColor: "rgba(66, 114, 215, 0.18)",
            borderColor: "#4272d7",
            borderWidth: 1,
            borderRadius: 4,
            maxBarThickness: 28
          }]
        }
      }.to_json %>">
    </canvas>
  </div>

  <div class="border-top mt-3 pt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small fw-semibold">Latest PIs</span>
      <span class="text-body-secondary small"><%= @latest_pis.size %> records</span>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>PI</th>
            <th>Project</th>
            <th>Customer</th>
          </tr>
        </thead>

        <tbody>
          <% @latest_pis.each do |pi| %>
            <tr>
              <td class="fw-semibold">
                <%= pi.number %>
              </td>

              <td>
                <% if pi.project.present? %>
                  <%= link_to pi.project_number, project_path(pi.project_id) %>
                <% else %>
                  —
                <% end %>
              </td>

              <td class="small">
                <%= truncate(pi.customer_nickname, length: 18) %>
              </td>
            </tr>
          <% end %>

          <% if @latest_pis.empty? %>
            <tr>
              <td colspan="3" class="text-center text-body-secondary py-3">
                No PIs.
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

</section>
