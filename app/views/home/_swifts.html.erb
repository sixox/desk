
<section class="m-card mb-3 h-100">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Swift Payments</h2>
      <p class="m-card__subtitle">Six-month payment trend</p>
    </div>

    <%= link_to "All", swifts_path, class: "m-btn m-btn--ghost" %>
  </header>

  <div style="height: 125px; position: relative;">
    <canvas
      data-controller="dashboard-chart"
      data-dashboard-chart-unit-value="Dirham"
      data-dashboard-chart-config-value="<%= {
        type: "bar",
        data: {
          labels: @months,
          datasets: [{
            label: "Swift Amount",
            data: @totals_swifts,
            backgroundColor: "rgba(245, 158, 11, 0.18)",
            borderColor: "#f59e0b",
            borderWidth: 1,
            borderRadius: 4,
            maxBarThickness: 28
          }]
        }
      }.to_json %>">
    </canvas>
  </div>

  <div class="border-top mt-3 pt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small fw-semibold">Latest Swifts</span>
      <span class="text-body-secondary small"><%= @latest_swifts.size %> records</span>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Project</th>
            <th>From</th>
            <th>Amount</th>
            <th>Type</th>
          </tr>
        </thead>

        <tbody>
          <% @latest_swifts.each do |swift| %>
            <% project = swift.ci&.project || swift.project %>

            <tr>
              <td>
                <% if project.present? %>
                  <%= link_to project.number, project_path(project) %>
                <% else %>
                  —
                <% end %>
              </td>

              <td class="small">
                <%= truncate(swift.from, length: 15) %>
              </td>

              <td class="text-nowrap small fw-semibold">
                <%= number_with_delimiter(swift.amount, delimiter: ",") %>
                <small class="text-body-secondary"><%= swift.currency %></small>
              </td>

              <td>
                <span class="badge <%= swift.advance ? 'bg-info-subtle text-info' : 'bg-secondary-subtle text-secondary' %>">
                  <%= swift.advance ? "Advance" : "Balance" %>
                </span>
              </td>
            </tr>
          <% end %>

          <% if @latest_swifts.empty? %>
            <tr>
              <td colspan="4" class="text-center text-body-secondary py-3">
                No Swifts.
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

</section>
