
<%
  payment_stats = [
    {
      name: "Dirham",
      current: @current_paid_dirham,
      previous: @last_month_paid_dirham,
      icon: "fa-coins",
      color: "c1"
    },
    {
      name: "Dollar",
      current: @current_paid_dollar,
      previous: @last_month_paid_dollar,
      icon: "fa-dollar-sign",
      color: "c2"
    },
    {
      name: "Rial",
      current: @current_paid_rial,
      previous: @last_month_paid_rial,
      icon: "fa-money-bill-wave",
      color: "c3"
    }
  ]
%>

<div class="mb-3">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h2 class="m-card__title">Payments Collected</h2>
    <span class="text-body-secondary small">
      <%= Date.current.strftime("%B %Y") %>
    </span>
  </div>

  <div class="row row-tight">

    <% payment_stats.each do |stat| %>
      <div class="col-12 col-sm-6 col-xl-4">

        <article class="stat-card">

          <div class="stat-card__head">
            <p class="stat-card__label">
              <%= stat[:name] %>
            </p>

            <span class="stat-card__icon stat-card__icon--<%= stat[:color] %>">
              <i class="fa-solid <%= stat[:icon] %>"></i>
            </span>
          </div>

          <p class="stat-card__value">
            <%= number_with_delimiter(stat[:current], delimiter: ",") %>
          </p>

          <p class="stat-card__delta">
            <span class="stat-card__delta-period">
              Last month:
              <%= number_with_delimiter(stat[:previous], delimiter: ",") %>
            </span>
          </p>

        </article>

      </div>
    <% end %>

  </div>
</div>
