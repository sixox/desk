
<%
  payment_charts = [
    {
      id: "rial",
      name: "Rial",
      values: @total_payments_var_rial,
      color: "#8b5cf6",
      background: "rgba(139, 92, 246, 0.18)"
    },
    {
      id: "dirham",
      name: "Dirham",
      values: @total_payments_var_dirham,
      color: "#14b8a6",
      background: "rgba(20, 184, 166, 0.18)"
    },
    {
      id: "dollar",
      name: "Dollar",
      values: @total_payments_var_dollar,
      color: "#4272d7",
      background: "rgba(66, 114, 215, 0.18)"
    }
  ]
%>

<section class="m-card mb-3">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Payment Trends</h2>
      <p class="m-card__subtitle">Monthly payments · Last six months</p>
    </div>
  </header>

  <div class="row row-tight">

    <% payment_charts.each do |chart| %>
      <div class="col-12 col-md-4">

        <div class="border rounded-3 p-3 h-100">

          <div class="d-flex align-items-center gap-2 mb-2">
            <span
              class="rounded-circle"
              style="width: 9px; height: 9px; background-color: <%= chart[:color] %>;">
            </span>

            <span class="small fw-semibold">
              <%= chart[:name] %>
            </span>
          </div>

          <div style="height: 125px; position: relative;">
            <canvas
              data-controller="dashboard-chart"
              data-dashboard-chart-unit-value="<%= chart[:name] %>"
              data-dashboard-chart-config-value="<%= {
                type: "bar",
                data: {
                  labels: @months,
                  datasets: [{
                    label: "Payments",
                    data: chart[:values],
                    backgroundColor: chart[:background],
                    borderColor: chart[:color],
                    borderWidth: 1,
                    borderRadius: 4,
                    maxBarThickness: 28
                  }]
                }
              }.to_json %>">
            </canvas>
          </div>

        </div>

      </div>
    <% end %>

  </div>

</section>
