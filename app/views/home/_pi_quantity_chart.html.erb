
<section class="m-card mb-3">

  <header class="m-card__header">
    <div>
      <h2 class="m-card__title">Sales Volume & Weight</h2>
      <p class="m-card__subtitle">Monthly quantities · Last six months</p>
    </div>
  </header>

  <div class="row row-tight">

    <div class="col-12 col-lg-6">
      <div class="border rounded-3 p-3 h-100">

        <h3 class="small fw-semibold mb-3">PI Quantity</h3>

        <div style="height: 175px; position: relative;">
          <canvas
            data-controller="dashboard-chart"
            data-dashboard-chart-unit-value="MT"
            data-dashboard-chart-breakdown-value="<%= @pi_quantity_breakdown.to_json %>"
            data-dashboard-chart-config-value="<%= {
              type: "bar",
              data: {
                labels: @total_pi_quantity_by_month.map { |data| data[:month] },
                datasets: [{
                  label: "Total Quantity",
                  data: @totals_pi_quantity,
                  backgroundColor: "rgba(66, 114, 215, 0.18)",
                  borderColor: "#4272d7",
                  borderWidth: 1,
                  borderRadius: 4,
                  maxBarThickness: 34
                }]
              }
            }.to_json %>">
          </canvas>
        </div>

      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="border rounded-3 p-3 h-100">

        <h3 class="small fw-semibold mb-3">CI Net Weight</h3>

        <div style="height: 175px; position: relative;">
          <canvas
            data-controller="dashboard-chart"
            data-dashboard-chart-unit-value="MT"
            data-dashboard-chart-breakdown-value="<%= @ci_net_weight_breakdown.to_json %>"
            data-dashboard-chart-config-value="<%= {
              type: "bar",
              data: {
                labels: @total_ci_net_weight_by_month.map { |data| data[:month] },
                datasets: [{
                  label: "Net Weight",
                  data: @totals_ci_net_weight,
                  backgroundColor: "rgba(20, 184, 166, 0.18)",
                  borderColor: "#14b8a6",
                  borderWidth: 1,
                  borderRadius: 4,
                  maxBarThickness: 34
                }]
              }
            }.to_json %>">
          </canvas>
        </div>

      </div>
    </div>

  </div>

</section>
