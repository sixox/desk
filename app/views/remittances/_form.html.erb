<div data-controller="remittance" class="rm-form">

  <%= form_for @remittance do |form| %>

    <div class="modal-body p-3 p-md-4">

      <% if @remittance.errors.any? %>
        <div class="rm-error">

          <div class="rm-error-title">
            <i class="bi bi-exclamation-circle"></i>
            <%= pluralize(@remittance.errors.count, "error") %>
            prohibited this remittance from being saved.
          </div>

          <ul>
            <% @remittance.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>

        </div>
      <% end %>


      <!-- HEADER -->

      <div class="rm-form-header">

        <h4 class="rm-form-title">

          <span class="rm-form-title-icon">
            <i class="bi bi-send"></i>
          </span>

          <%= @remittance.new_record? ? "Create Remittance" : "Edit Remittance" %>

        </h4>

      </div>


      <!-- SENDER / RECEIVER -->

      <div class="row g-3">


        <!-- SENDER -->

        <div class="col-lg-6">

          <div class="rm-party-panel rm-sender-panel">


            <!-- HEADER -->

            <div class="rm-party-header">

              <div class="rm-party-icon">
                <i class="bi bi-box-arrow-up-right"></i>
              </div>

              <div>
                <div class="rm-party-title">
                  Sender
                </div>
              </div>

            </div>


            <!-- BODY -->

            <div class="rm-party-body">


              <!-- ORGANIZATION -->

              <div class="rm-field">

                <label class="rm-label">
                  Organization
                  <span class="rm-required">*</span>
                </label>

                <%= select_tag(
                  :sender_organization_id,
                  options_from_collection_for_select(
                    @organizations,
                    :id,
                    :name,
                    @remittance.sender_account&.organization_id
                  ),
                  prompt: "Select organization",
                  class: "form-select",
                  data: {
                    remittance_target: "senderOrganization",
                    action: "change->remittance#loadSenderAccounts"
                  }
                ) %>

                <div data-remittance-target="senderInfo"></div>

              </div>


              <!-- ACCOUNT -->

              <div class="rm-field">

                <label class="rm-label">
                  Account
                  <span class="rm-required">*</span>
                </label>

                <%= form.collection_select(
                  :sender_account_id,
                  @sender_accounts,
                  :id,
                  ->(account) {
                    "#{account.number} - #{account.currency.name}"
                  },
                  { prompt: "Select account" },
                  {
                    class: "form-select",
                    data: {
                      remittance_target: "senderAccount"
                    }
                  }
                ) %>

              </div>


              <!-- SENT AMOUNT -->

              <div class="rm-field">

                <label class="rm-label">
                  Sent Amount
                  <span class="rm-required">*</span>
                </label>

                <div class="input-group">

                  <span class="input-group-text">
                    <i class="bi bi-cash-stack"></i>
                  </span>

                  <%= form.number_field(
                    :sent_amount,
                    class: "form-control",
                    placeholder: "0"
                  ) %>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- RECEIVER -->

        <div class="col-lg-6">

          <div class="rm-party-panel rm-receiver-panel">


            <!-- HEADER -->

            <div class="rm-party-header">

              <div class="rm-party-icon">
                <i class="bi bi-box-arrow-in-down-left"></i>
              </div>

              <div>
                <div class="rm-party-title">
                  Receiver
                </div>
              </div>

            </div>


            <!-- BODY -->

            <div class="rm-party-body">


              <!-- ORGANIZATION -->

              <div class="rm-field">

                <label class="rm-label">
                  Organization
                  <span class="rm-required">*</span>
                </label>

                <%= select_tag(
                  :receiver_organization_id,
                  options_from_collection_for_select(
                    @organizations,
                    :id,
                    :name,
                    @remittance.receiver_account&.organization_id
                  ),
                  prompt: "Select organization",
                  class: "form-select",
                  data: {
                    remittance_target: "receiverOrganization",
                    action: "change->remittance#loadReceiverAccounts"
                  }
                ) %>

                <div data-remittance-target="receiverInfo"></div>

              </div>


              <!-- ACCOUNT -->

              <div class="rm-field">

                <label class="rm-label">
                  Account
                  <span class="rm-required">*</span>
                </label>

                <%= form.collection_select(
                  :receiver_account_id,
                  @receiver_accounts,
                  :id,
                  ->(account) {
                    "#{account.number} - #{account.currency.name}"
                  },
                  { prompt: "Select account" },
                  {
                    class: "form-select",
                    data: {
                      remittance_target: "receiverAccount"
                    }
                  }
                ) %>

              </div>


              <!-- RECEIVED AMOUNT -->

              <div class="rm-field">

                <label class="rm-label">
                  Received Amount
                  <span class="rm-required">*</span>
                </label>

                <div class="input-group">

                  <span class="input-group-text">
                    <i class="bi bi-cash-coin"></i>
                  </span>

                  <%= form.number_field(
                    :received_amount,
                    class: "form-control",
                    placeholder: "0"
                  ) %>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- CURRENCY -->

      <div class="rm-form-section">

        <div class="rm-section-title">
          <i class="bi bi-currency-exchange"></i>
          Currency Details
        </div>


        <div class="row g-3">

          <div class="col-md-12">

            <div class="rm-field">

              <label class="rm-label">
                Currency
                <span class="rm-required">*</span>
              </label>

              <%= form.collection_select(
                :currency_id,
                @currencies,
                :id,
                :name,
                { prompt: "Select currency" },
                { class: "form-select" }
              ) %>

            </div>

          </div>

        </div>

      </div>


    </div>


    <!-- FOOTER -->

    <div class="modal-footer rm-form-footer px-3 px-md-4 pb-3">

      <button
        type="button"
        class="btn btn-light border rm-close"
        data-bs-dismiss="modal"
      >
        Close
      </button>

      <%= form.submit(
        @remittance.new_record? ? "Create Remittance" : "Update Remittance",
        class: "btn btn-primary rm-submit",
        data: {
          action: "click->bs-modal#submitEnd"
        }
      ) %>

    </div>

  <% end %>

</div>