<div
  data-controller="money-movements"
  data-accounts-url="<%= accounts_xtransfers_path %>"
  class="xt-form"
>

  <%= form_for @remittance,
               html: {
                 multipart: true
               } do |form| %>

    <div class="modal-body p-3 p-md-4">

      <% if @remittance.errors.any? %>

        <div class="xt-error">

          <div class="xt-error-title">

            <i class="bi bi-exclamation-circle"></i>

            <%= pluralize(
              @remittance.errors.count,
              "error"
            ) %>

            prohibited this remittance from being saved.

          </div>


          <ul>

            <% @remittance.errors.each do |error| %>

              <li>
                <%= error.full_message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>


      <!-- ================================================= -->
      <!-- HEADER -->
      <!-- ================================================= -->

      <div class="xt-form-header">

        <h4 class="xt-form-title">

          <span class="xt-form-title-icon">
            <i class="bi bi-send"></i>
          </span>

          <%= @remittance.new_record? ?
                "Create Remittance" :
                "Edit Remittance" %>

        </h4>

      </div>


      <!-- ================================================= -->
      <!-- SEND -->
      <!-- ================================================= -->

      <div class="xt-form-section">

        <div class="xt-section-heading-row">

          <div class="xt-section-title">

            <span class="xt-section-title-icon">
              <i class="bi bi-box-arrow-up-right"></i>
            </span>

            <div>

              <strong>
                Send
              </strong>

              <small>
                Money leaving accounts.
              </small>

            </div>

          </div>


          <button
            type="button"
            class="btn xt-add-btn"
            data-action="click->money-movements#addSend"
          >

            <i class="bi bi-plus-lg"></i>
            Add Send

          </button>

        </div>


        <div
          data-money-movements-target="sendContainer"
        >

          <%= form.fields_for :money_movements do |movement_form| %>

            <% if movement_form.object.direction == "send" %>

              <%= render(
                "shared/movement_fields",
                movement_form: movement_form
              ) %>

            <% end %>

          <% end %>

        </div>


        <template
          data-money-movements-target="sendTemplate"
        >

          <%
            prototype =
              MoneyMovement.new(
                direction: "send"
              )
          %>

          <%= form.fields_for(
            :money_movements,
            prototype,
            child_index: "NEW_RECORD"
          ) do |movement_form| %>

            <%= render(
              "shared/movement_fields",
              movement_form: movement_form
            ) %>

          <% end %>

        </template>

      </div>


      <!-- ================================================= -->
      <!-- RECEIVE -->
      <!-- ================================================= -->

      <div class="xt-form-section">

        <div class="xt-section-heading-row">

          <div class="xt-section-title">

            <span class="xt-section-title-icon">
              <i class="bi bi-box-arrow-in-down-left"></i>
            </span>

            <div>

              <strong>
                Receive
              </strong>

              <small>
                Money entering accounts.
              </small>

            </div>

          </div>


          <button
            type="button"
            class="btn xt-add-btn"
            data-action="click->money-movements#addReceive"
          >

            <i class="bi bi-plus-lg"></i>
            Add Receive

          </button>

        </div>


        <div
          data-money-movements-target="receiveContainer"
        >

          <%= form.fields_for :money_movements do |movement_form| %>

            <% if movement_form.object.direction == "receive" %>

              <%= render(
                "shared/movement_fields",
                movement_form: movement_form
              ) %>

            <% end %>

          <% end %>

        </div>


        <template
          data-money-movements-target="receiveTemplate"
        >

          <%
            prototype =
              MoneyMovement.new(
                direction: "receive"
              )
          %>

          <%= form.fields_for(
            :money_movements,
            prototype,
            child_index: "NEW_RECORD"
          ) do |movement_form| %>

            <%= render(
              "shared/movement_fields",
              movement_form: movement_form
            ) %>

          <% end %>

        </template>

      </div>


      <!-- ================================================= -->
      <!-- ATTACHMENTS -->
      <!-- ================================================= -->

      <div class="xt-attachments-panel">

        <div class="xt-attachments-header">

          <div class="xt-attachments-title">

            <i class="bi bi-paperclip"></i>

            Attachments

          </div>


          <% if @remittance.documents.attached? %>

            <%= link_to(
              remove_all_documents_remittance_path(
                @remittance
              ),
              data: {
                turbo_method: :delete,
                turbo_confirm:
                  "Delete all attachments?"
              },
              class:
                "xt-remove-all text-decoration-none p-0",
              style:
                "font-size: 9px; gap: 0rem !important; border: 0; margin-top: -5px;"
            ) do %>

              Delete All Attachs

            <% end %>

          <% end %>

        </div>


        <% if @remittance.documents.attached? %>

          <div class="xt-attachments-list">

            <% @remittance.documents.each do |document| %>

              <div class="xt-attachment-item">

                <i class="bi bi-file-earmark-text xt-attachment-file-icon"></i>

                <%= link_to(
                  document.filename.to_s,
                  rails_blob_path(
                    document,
                    disposition: "attachment"
                  ),
                  target: "_blank",
                  class: "xt-attachment-link"
                ) %>


                <%= link_to(
                  remove_document_remittance_path(
                    @remittance,
                    document_id: document.id
                  ),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm:
                      "Remove this file?"
                  },
                  class: "xt-attachment-delete"
                ) do %>

                  <i class="bi bi-trash3"></i>

                <% end %>

              </div>

            <% end %>

          </div>

        <% end %>


        <div class="xt-attachments-list">

          <div class="xt-attachment-item xt-new-document">

            <i class="bi bi-paperclip xt-attachment-file-icon"></i>

            <%= form.file_field(
              :documents,
              multiple: true,
              class: "xt-attachment-input"
            ) %>

          </div>

        </div>

      </div>

    </div>


    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <div class="modal-footer xt-form-footer px-3 px-md-4 pb-3">

      <button
        type="button"
        class="btn btn-light border xt-close"
        data-bs-dismiss="modal"
      >
        Close
      </button>


      <%= form.submit(
        @remittance.new_record? ?
          "Create Remittance" :
          "Update Remittance",
        class: "btn btn-success xt-submit",
        data: {
          action:
            "click->bs-modal#submitEnd"
        }
      ) %>

    </div>

  <% end %>

</div>