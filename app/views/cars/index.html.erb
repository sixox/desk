<div class="carops">
  <header class="carops-heading carops-page-header">
    <div><div class="carops-kicker">BUSINESS / CARS</div><h1>Vehicle Import</h1><p>Projects, procurement, transport and delivery in one workspace.</p></div>
    <a href="#carops-upload" class="carops-button"><i class="fa-solid fa-cloud-arrow-up"></i> Update data</a>
  </header>
  <details id="carops-upload" class="carops-panel carops-upload mb-3">
    <summary>Upload complete CSV snapshot</summary>
    <p>Choose all six files. Existing records are refreshed, missing records archived, and events and incidents replaced. All files must have the original headers.</p>
    <%= form_with url: import_cars_path, method: :post, multipart: true, data: {turbo: false} do %>
      <div class="carops-upload-grid">
        <% CarImportRecord::HEADERS.each_key do |name| %>
          <label><strong><%= name %>.csv</strong><%= file_field_tag "files[#{name}]", accept: '.csv,text/csv', required: true, class: 'form-control' %></label>
        <% end %>
      </div>
      <label class="d-flex align-items-center gap-2 my-3"><input type="checkbox" required> I confirm these are complete exports.</label>
      <%= submit_tag 'Validate & update all data', class: 'carops-button' %>
    <% end %>
  </details>
  <%= render 'cars/overview', snapshot: @snapshot, compact: false %>
  <section class="carops-panel">
    <nav class="carops-tabs" aria-label="Cars datasets">
      <% (['Projects'] + CarImportRecord::HEADERS.keys).each do |tab| %>
        <%= link_to cars_path(tab: tab, project: @project, pi: @pi), class: (@tab == tab ? 'active' : nil), aria: {current: (@tab == tab ? 'page' : nil)} do %>
          <%= tab == 'Cars' ? 'Vehicles' : tab %><span><%= tab == 'Projects' ? (@project ? @project_names.count { |n| n == @project } : @project_names.size) : @filtered.fetch(tab, []).size %></span>
        <% end %>
      <% end %>
    </nav>
    <%= form_with url: cars_path, method: :get, local: true, class: 'carops-filters' do %>
      <%= hidden_field_tag :tab, @tab %>
      <%= select_tag :project, options_for_select(@project_names, @project), include_blank: 'All projects', class: 'form-select', aria: {label:'Project'} %>
      <% if @statuses.present? %><%= select_tag :status, options_for_select(@statuses, @status), include_blank: 'All statuses', class: 'form-select', aria: {label:'Status'} %><% end %>
      <%= search_field_tag :search, @query, placeholder: 'Search VIN, PI, supplier, truck...', class: 'form-control', aria: {label:'Search'} %>
      <%= submit_tag 'Search', class: 'carops-button' %>
      <%= link_to 'Reset', cars_path(tab: @tab), class: 'btn btn-light' %>
    <% end %>
    <% if @pi.present? %><div class="carops-selection">PI <strong><%= @pi %></strong> <%= link_to 'Clear PI filter', cars_path(tab: @tab, project: @project) %></div><% end %>
    <% if @tab == 'Projects' %>
      <div class="carops-project-grid">
        <% @projects.each do |project, pis| %>
          <% total = pis.sum { |p| p.fields['Cars'].to_i }; delivered = pis.sum { |p| p.fields['Delivered'].to_i }; percent = total.zero? ? 0 : [100, (100.0 * delivered / total).round].min %>
          <article class="carops-project <%= 'complete' if total.positive? && delivered >= total %>">
            <header><div><div class="carops-kicker">PROJECT</div><h3><%= project.presence || 'Unassigned' %></h3><small><%= pis.size %> PI(s) · <%= pis.map { |p| p.fields['Owner'] }.compact.uniq.join(', ') %></small></div><div class="carops-project-number"><strong><%= total %></strong><span>Cars</span></div></header>
            <div class="carops-bar-label"><span>Delivered</span><strong><%= delivered %> / <%= total %></strong></div><div class="carops-track"><div style="width:<%= percent %>%;background:#15976b"></div></div>
            <% pis.each do |pi| %><div class="carops-project-pi"><%= link_to pi.external_key, cars_path(tab: 'PIs', project: project, pi: pi.external_key) %><small><%= pi.fields['Supplier'] %> · <%= pi.fields['Next Step'] %></small></div><% end %>
            <%= link_to(@project_records[project] ? car_path(@project_records[project]) : cars_path(tab: 'PIs', project: project), class: 'carops-project-link') do %>Open project <i class="fa-solid fa-arrow-right"></i><% end %>
          </article>
        <% end %>
      </div>
      <% if @projects.empty? %><div class="carops-empty">No projects found.</div><% end %>
      <%= paginate @projects %>
    <% else %>
      <div class="carops-table-wrap">
        <table class="carops-table">
          <thead><tr><% @columns.each do |column| %><th scope="col"><%= column %></th><% end %><th scope="col">Details</th><% if @tab == 'PIs' %><th scope="col">Payment orders</th><% end %></tr></thead>
          <tbody>
            <% @records.each do |record| %>
              <tr>
                <% @columns.each do |column| %>
                  <td>
                    <% value = record.fields[column] %>
                    <% if column == 'Status' && value.present? %><span class="carops-status <%= %w[Delivered Closed].include?(value) || value == 'Customs released' ? 'is-done' : 'is-pending' %>"><%= value %></span>
                    <% elsif column == 'PI No.' && value.present? %><%= link_to value, cars_path(tab: 'PIs', pi: value) %>
                    <% elsif column == 'Project No.' && value.present? %><%= link_to value, (@project_records[value] ? car_path(@project_records[value]) : cars_path(project: value)) %>
                    <% else %><%= value.nil? ? '—' : value %><% end %>
                    <% if value.present? && record.estimated?(column) %><span class="carops-estimate" title="Estimated date">Est.</span><% end %>
                  </td>
                <% end %>
                <td><details class="carops-record-details"><summary>View all</summary><dl><% CarImportRecord::HEADERS.fetch(@tab).each do |column| %><dt><%= column %></dt><dd><%= record.fields[column].nil? ? '—' : record.fields[column] %><% if record.fields[column].present? && record.estimated?(column) %> <span class="carops-estimate">Est.</span><% end %></dd><% end %></dl></details></td>
                <% if @tab == 'PIs' %>
                  <td>
                    <% linked = @linked_pos.fetch(record.id, []) %>
                    <% if linked.empty? %><small class="text-muted">No visible orders</small><% end %>
                    <% if linked.any? %>
                      <details class="carops-record-details"><summary><%= linked.size %> visible orders</summary>
                        <% linked.each do |po| %><div class="mb-2"><%= link_to "PO ##{po.id}", payment_order_path(po) %> · <%= number_with_delimiter(po.amount) %> <%= po.currency.to_s.upcase %><br><small><%= po.status %></small></div><% end %>
                      </details>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @records.empty? %><div class="carops-empty">No matching records.</div><% end %>
      <%= paginate @records %>
    <% end %>
  </section>
</div>
