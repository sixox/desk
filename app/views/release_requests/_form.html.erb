<%= form_with model: [project, booking, release_request],
  data: { turbo_stream: true } do |form| %>

  <div class="modal-body">

    <%= render "shared/forms/errors",
      object: release_request %>


    <div class="border rounded-3 p-3 mb-3">

      <div class="row g-3">

        <div class="col-6">
          <small class="text-body-secondary">Project</small>
          <div class="fw-semibold">
            <%= project.number %>
          </div>
        </div>

        <div class="col-6">
          <small class="text-body-secondary">Booking</small>
          <div class="fw-semibold">
            <%= booking.number %>
          </div>
        </div>

        <div class="col-6">
          <small class="text-body-secondary">Customer</small>
          <div class="fw-semibold">
            <%= project.pi&.customer&.nickname || "—" %>
          </div>
        </div>

        <div class="col-6">
          <small class="text-body-secondary">Destination</small>
          <div class="fw-semibold">
            <%= booking.pod.presence || "—" %>
          </div>
        </div>

        <div class="col-4">
          <small class="text-body-secondary">Containers</small>
          <div class="fw-semibold">
            <%= booking.quantity.to_i %>
          </div>
        </div>

        <div class="col-4">
          <small class="text-body-secondary">Picked Up</small>
          <div class="fw-semibold">
            <%= booking.picked_up.to_i %>
          </div>
        </div>

        <div class="col-4">
          <small class="text-body-secondary">Stuffed</small>
          <div class="fw-semibold">
            <%= booking.filled.to_i %>
          </div>
        </div>

        <div class="col-12">
          <small class="text-body-secondary">Weight</small>
          <div class="fw-semibold">
            <%= booking.weight.presence || "—" %>
            <%= booking.weight.present? ? "MT" : "" %>
          </div>
        </div>

      </div>

    </div>


    <div class="mb-2">

      <%= form.label :note,
        "Request Note",
        class: "form-label fw-semibold" %>

      <span class="small text-body-secondary">
        Optional
      </span>

      <%= form.text_area :note,
        rows: 4,
        class: "form-control",
        placeholder: "Add the reason or additional information for this release request..." %>

    </div>

  </div>


  <div class="modal-footer">

    <button type="button"
      class="btn btn-light border"
      data-bs-dismiss="modal">
      Cancel
    </button>

    <%= form.submit "Submit Release Request",
      class: "btn btn-primary" %>

  </div>

<% end %>