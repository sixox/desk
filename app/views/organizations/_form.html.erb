<div data-controller="organization" class="rm-form">

  <%= form_for @organization do |form| %>

    <div class="modal-body p-3 p-md-4">

      <% if @organization.errors.any? %>

        <div class="rm-error">

          <div class="rm-error-title">
            <i class="bi bi-exclamation-circle"></i>
            <%= pluralize(@organization.errors.count, "error") %>
            prohibited this organization from being saved.
          </div>

          <ul>
            <% @organization.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>

        </div>

      <% end %>


      <!-- ====================================================== -->
      <!-- ORGANIZATION HEADER -->
      <!-- ====================================================== -->

      <div class="org-form-header">

        <div class="org-form-identity">

          <div class="org-form-icon">
            <i class="bi bi-building"></i>
          </div>

          <div class="org-form-name-wrap">

            <div class="org-form-small-label">
              <%= @organization.new_record? ? "New organization" : "Organization" %>
            </div>

            <%= form.text_field :name,
              class: "org-form-name",
              placeholder: "Organization name",
              autocomplete: "off" %>

          </div>

        </div>


        <!-- KIND -->

        <div class="org-form-kind">

          <label class="org-form-kind-label">
            Kind
          </label>

          <%= form.select :kind,
            Organization::KINDS,
            { prompt: "Select kind" },
            { class: "form-select org-form-kind-select" } %>

        </div>

      </div>


      <!-- ====================================================== -->
      <!-- ACCOUNTS -->
      <!-- ====================================================== -->

      <div class="xt-exchanges-panel p-2">

        <div class="org-form-accounts-header">

          <div>

            <div class="rm-section-title mb-0">
              <i class="bi bi-bank"></i>
              Accounts
            </div>

            <div class="org-form-accounts-subtitle">
              Manage the accounts belonging to this organization
            </div>

          </div>

          <div class="org-form-account-count"
               data-organization-target="accountCount">
            <%= @organization.xaccounts.reject(&:marked_for_destruction?).size %>
          </div>

        </div>


        <div
          class="xt-exchanges-body"
          data-organization-target="accountsContainer"
        >

          <%= form.fields_for :xaccounts do |account_form| %>

            <div class="xt-exchange-row">

              <!-- NUMBER -->

              <div class="xt-exchange-number">
                <i class="bi bi-bank"></i>
              </div>


              <!-- FIELDS -->

              <div class="flex-grow-1">

                <%= account_form.hidden_field :_destroy, value: "0" %>

                <div class="row g-2">

                  <div class="col-md-4">

                    <label class="xt-label">
                      Account No.
                    </label>

                    <%= account_form.text_field :number,
                      class: "form-control",
                      placeholder: "Account number",
                      autocomplete: "off" %>

                  </div>


                  <div class="col-md-4">

                    <label class="xt-label">
                      Account Kind
                    </label>

                    <%= account_form.text_field :kind,
                      class: "form-control",
                      placeholder: "Account kind",
                      autocomplete: "off" %>

                  </div>


                  <div class="col-md-4">

                    <label class="xt-label">
                      Currency
                    </label>

                    <%= account_form.collection_select :currency_id,
                      @currencies,
                      :id,
                      :name,
                      { prompt: "Select currency" },
                      { class: "form-select" } %>

                  </div>

                </div>

              </div>


              <!-- ACTIONS -->

              <div class="xt-exchange-actions">

                <button
                  type="button"
                  class="btn xt-add-exchange"
                  data-action="click->organization#addAccount"
                  title="Add account"
                >
                  <i class="bi bi-plus-lg"></i>
                </button>

                <button
                  type="button"
                  class="btn xt-remove-exchange"
                  data-action="click->organization#removeAccount"
                  title="Remove account"
                >
                  <i class="bi bi-trash3"></i>
                </button>

              </div>

            </div>

          <% end %>

        </div>


        <!-- ==================================================== -->
        <!-- NEW ACCOUNT TEMPLATE -->
        <!-- ==================================================== -->

        <template data-organization-target="accountTemplate">

          <%= form.fields_for :xaccounts,
            Xaccount.new,
            child_index: "NEW_RECORD" do |account_form| %>

            <div class="xt-exchange-row">

              <div class="xt-exchange-number">
                <i class="bi bi-bank"></i>
              </div>


              <div class="flex-grow-1">

                <div class="row g-2">

                  <div class="col-md-4">

                    <label class="xt-label">
                      Account No.
                    </label>

                    <%= account_form.text_field :number,
                      class: "form-control",
                      placeholder: "Account number",
                      autocomplete: "off" %>

                  </div>


                  <div class="col-md-4">

                    <label class="xt-label">
                      Account Kind
                    </label>

                    <%= account_form.text_field :kind,
                      class: "form-control",
                      placeholder: "Account kind",
                      autocomplete: "off" %>

                  </div>


                  <div class="col-md-4">

                    <label class="xt-label">
                      Currency
                    </label>

                    <%= account_form.collection_select :currency_id,
                      @currencies,
                      :id,
                      :name,
                      { prompt: "Select currency" },
                      { class: "form-select" } %>

                  </div>

                </div>

              </div>


              <div class="xt-exchange-actions">

                <button
                  type="button"
                  class="btn xt-add-exchange"
                  data-action="click->organization#addAccount"
                  title="Add account"
                >
                  <i class="bi bi-plus-lg"></i>
                </button>

                <button
                  type="button"
                  class="btn xt-remove-exchange"
                  data-action="click->organization#removeAccount"
                  title="Remove account"
                >
                  <i class="bi bi-trash3"></i>
                </button>

              </div>

            </div>

          <% end %>

        </template>

      </div>

    </div>


    <!-- ====================================================== -->
    <!-- FOOTER -->
    <!-- ====================================================== -->

    <div class="modal-footer rm-form-footer px-3 px-md-4 pb-3">

      <div class="org-form-footer-info">

        <i class="bi bi-info-circle"></i>

        <span>
          Add as many accounts as this organization needs.
        </span>

      </div>


      <div class="d-flex gap-2">

        <button
          type="button"
          class="btn btn-light border rm-close"
          data-bs-dismiss="modal"
        >
          Close
        </button>

        <%= form.submit(
          @organization.new_record? ? "Create Organization" : "Update Organization",
          class: "btn btn-primary rm-submit",
          data: {
            action: "click->bs-modal#submitEnd"
          }
        ) %>

      </div>

    </div>

  <% end %>

</div>
