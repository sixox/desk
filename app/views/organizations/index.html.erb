<div class="col-lg-10 mx-auto mt-4">
  <div class="container-fluid py-3 organization-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="organization-header d-flex justify-content-between align-items-center">
      <div class="organization-heading">
        <div class="organization-heading-icon">
          <i class="bi bi-buildings"></i>
        </div>

        <div>
          <h5 class="organization-title banafsh-h">Organizations</h5>
          
        </div>
      </div>

      <%= link_to new_organization_path,
        data: { controller: "bs-modal-form" },
        class: "btn btn-success organization-create" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Create Organization</span>
      <% end %>
    </div>


    <!-- ========================================================= -->
    <!-- SUMMARY -->
    <!-- ========================================================= -->

    <div class="organization-summary-grid">

      <div class="organization-summary-card">
        <div class="organization-summary-icon organization-summary-icon-primary">
          <i class="bi bi-buildings"></i>
        </div>

        <div class="organization-summary-content">
          <div class="organization-summary-label">
            Organizations
          </div>

          <div class="organization-summary-value">
            <%= @organizations.count %>
          </div>
        </div>
      </div>


      <div class="organization-summary-card">
        <div class="organization-summary-icon organization-summary-icon-success">
          <i class="bi bi-wallet2"></i>
        </div>

        <div class="organization-summary-content">
          <div class="organization-summary-label">
            Accounts
          </div>

          <div class="organization-summary-value">
            <%= @organizations.sum { |organization| organization.xaccounts.size } %>
          </div>
        </div>
      </div>

    </div>


    <!-- ========================================================= -->
    <!-- ORGANIZATIONS -->
    <!-- ========================================================= -->

    <% if @organizations.any? %>

      <div class="organization-list">
        <% @organizations.each do |organization| %>
          <%= render 'organization', organization: organization %>
        <% end %>

      </div>

    <% else %>

      <!-- ======================================================= -->
      <!-- EMPTY STATE -->
      <!-- ======================================================= -->

      <div class="organization-empty-state">

        <div class="organization-empty-icon">
          <i class="bi bi-buildings"></i>
        </div>

        <h5>No organizations yet</h5>

        <p>
          Create your first organization to start managing accounts
          and financial activity.
        </p>

        <%= link_to new_organization_path,
          data: { controller: "bs-modal-form" },
          class: "btn btn-success organization-create" do %>
          <i class="bi bi-plus-lg"></i>
          Create Organization
        <% end %>

      </div>

    <% end %>


    <%= turbo_frame_tag "modal" %>

  </div>
</div>