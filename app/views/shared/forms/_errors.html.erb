
<% if object.errors.any? %>
  <div class="erp-form__errors" role="alert">

    <div class="erp-form__errors-title">
      <i class="fa-solid fa-circle-exclamation me-1"></i>
      Please correct <%= pluralize(object.errors.count, "error") %> before saving.
    </div>

    <ul>
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>

  </div>
<% end %>
