<%
  editing = @swift.persisted?
  endpoint = if editing
    swift_path(@swift)
  elsif @object == 3
    car_swifts_path(@car_project)
  elsif @object == 1
    ci_swifts_path(@ci)
  else
    project_swifts_path(@project)
  end
%>
<%= form_with model: @swift, url: endpoint, method: editing ? :patch : :post, multipart: true do |form| %>
  <div class="modal-body carops">
    <%= render 'shared/forms/errors', object: @swift %>
    <div class="rounded-3 bg-light p-3 mb-3">
      <div class="carops-kicker"><%= @object == 3 ? 'AUTOMOTIVE / PROJECT' : 'PROJECT / SWIFT' %></div>
      <h3 class="fw-bold fs-5"><%= @car_project&.external_key || @project&.number || 'Unassigned' %></h3>
      <% if @object != 3 && @project&.pi %>
        <small class="text-muted">PI <%= @project.pi.number %></small>
      <% end %>
    </div>
    <div class="row g-3">
      <div class="col-md-6">
        <%= form.label :amount, 'Amount', class: 'form-label small fw-bold' %>
        <%= form.number_field :amount, step: 'any', required: true, class: 'form-control' %>
      </div>
      <div class="col-md-6">
        <%= form.label :currency, class: 'form-label small fw-bold' %>
        <%= form.select :currency, Pi::CURRENCY, {prompt: 'Select currency'}, {class: 'form-select', required: true} %>
      </div>
      <div class="col-md-6">
        <%= form.label :from, 'From', class: 'form-label small fw-bold' %>
        <%= form.text_field :from, class: 'form-control' %>
      </div>
      <div class="col-md-6">
        <%= form.label :bank_id, 'To bank', class: 'form-label small fw-bold' %>
        <%= form.collection_select :bank_id, @banks, :id, :name, {prompt: 'Select bank'}, {class: 'form-select', required: true} %>
      </div>
      <% if editing && @object == 2 %>
        <div class="col-12">
          <%= form.label :project_id, 'Project', class: 'form-label small fw-bold' %>
          <%= form.collection_select :project_id, @projects, :id, :number, {prompt: 'Select project'}, {class: 'form-select'} %>
        </div>
      <% end %>
      <div class="col-12">
        <%= form.label :documents, 'Supporting documents', class: 'form-label small fw-bold' %>
        <% @swift.documents.each do |document| %>
          <% if document.blob.persisted? %><div class="small mb-1"><i class="fa-solid fa-paperclip"></i> <%= link_to document.filename, rails_blob_path(document, disposition: 'attachment') %></div><% end %>
        <% end %>
        <%= form.file_field :documents, multiple: true, class: 'form-control', required: !@swift.documents.attached? %>
        <% if editing %><small class="text-muted">Leave empty to retain existing documents. Selecting new files replaces them.</small><% end %>
      </div>
      <div class="col-12">
        <%= form.label :note, class: 'form-label small fw-bold' %>
        <%= form.text_area :note, class: 'form-control', rows: 4 %>
      </div>
      <div class="col-12">
        <div class="form-check form-switch bg-light rounded-3 py-3 ps-5">
          <%= form.check_box :advance, class: 'form-check-input' %>
          <%= form.label :advance, 'Advance payment (off = balance payment)', class: 'form-check-label small fw-semibold' %>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
    <%= form.submit(editing ? 'Save SWIFT' : 'Add SWIFT', class: 'btn btn-primary') %>
  </div>
<% end %>
