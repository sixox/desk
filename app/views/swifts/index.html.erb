<div class="carops pb-4">
  <header class="carops-heading carops-page-header">
    <div><div class="carops-kicker">FINANCE / BANK TRANSFERS</div><h1>SWIFTs</h1><p>Incoming transfers and deposit confirmations.</p></div>
    <div class="btn-group" role="group" aria-label="SWIFT filters">
      <%= link_to 'Pending', unconfirmed_swifts_path, class: "btn btn-sm #{@in_page == 'unconfirmed' ? 'btn-primary' : 'btn-outline-primary'}" %>
      <%= link_to 'All', swifts_path, class: "btn btn-sm #{@in_page == 'index' ? 'btn-primary' : 'btn-outline-primary'}" %>
    </div>
  </header>
  <section class="carops-panel">
    <%= search_form_for @q, url: request.path, html: {class: 'carops-filters'} do |f| %>
      <%= f.search_field :amount_or_from_or_project_number_cont, class: 'form-control', placeholder: 'Amount, sender, project number' %>
      <%= f.submit 'Search', class: 'carops-button' %>
      <%= link_to 'Reset', request.path, class: 'btn btn-light btn-sm' %>
    <% end %>
    <div class="carops-table-wrap">
      <table class="carops-table">
        <thead><tr><% ['SWIFT', 'Amount', 'Deposited', 'From / Bank', 'Project', 'Type / Status', 'Documents / Note', 'Actions'].each do |label| %><th scope="col"><%= label %></th><% end %></tr></thead>
        <tbody>
          <% @swifts.each do |swift| %>
            <% rejected = swift.rejected?; confirmed = swift.confirmed? && !rejected; color = rejected ? '#c12d40' : confirmed ? '#16834f' : '#c08a28' %>
            <tr>
              <td style="border-left:4px solid <%= color %>;" class="text-nowrap"><strong>#<%= swift.id %></strong> <% if swift.announce? %><i class="fa-solid fa-bullhorn text-success"></i><% end %><div class="small text-muted"><%= swift.created_at&.strftime('%d %b %Y') %></div></td>
              <td class="text-nowrap"><strong><%= number_with_delimiter(swift.amount) %></strong> <small><%= swift.currency.to_s.upcase %></small></td>
              <td class="text-nowrap"><%= swift.deposited_amount.nil? ? '—' : number_with_delimiter(swift.deposited_amount) %> <small><%= swift.bank&.currency.to_s.upcase %></small></td>
              <td><strong><%= swift.from.presence || '—' %></strong><div class="small text-muted"><%= swift.bank&.name || '—' %></div></td>
              <td>
                <% if swift.car_project %>
                  <%= link_to car_path(swift.car_project) do %><i class="fa-solid fa-car-side"></i> <%= swift.car_project.external_key %><% end %>
                  <% unless swift.car_project.active? %><div class="small text-muted">Archived</div><% end %>
                <% elsif (project = swift.ci&.project || swift.project) %>
                  <%= link_to project.number, project_path(project) %>
                <% else %>—<% end %>
              </td>
              <td><strong><%= swift.advance? ? 'Advance' : 'Balance' %></strong><div class="small mt-1" style="color:<%= color %>;"><%= rejected ? 'Rejected' : confirmed ? 'Confirmed' : 'Awaiting deposit' %></div><small class="text-muted"><%= (rejected ? swift.rejected_at : confirmed ? swift.confirm_at : nil)&.strftime('%d %b %Y, %H:%M') %></small></td>
              <td>
                <% swift.documents.each do |file| %><div class="mb-1"><%= link_to file.filename, rails_blob_path(file, disposition: 'attachment'), class: 'small' %></div><% end %>
                <% if swift.note.present? %><details><summary class="small text-muted">Note</summary><div class="small text-break"><%= swift.note %></div></details><% end %>
              </td>
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <% if swift.confirmable_by?(current_user) %>
                    <%= link_to 'Confirm', edit_amount_before_confirm_swift_path(swift), data: {controller: 'bs-modal-form'}, class: 'btn btn-sm btn-outline-success' %>
                    <%= button_to 'Reject', reject_swift_path(swift), method: :patch, form: {class: 'm-0', data: {turbo_confirm: 'Reject this SWIFT?'}}, class: 'btn btn-sm btn-outline-danger' %>
                    <%= button_to(swift.announce? ? 'Unannounce' : 'Announce', toggle_announce_swift_path(swift), method: :patch, form: {class: 'm-0'}, class: 'btn btn-sm btn-outline-secondary') %>
                  <% end %>
                  <% if swift.editable_by?(current_user) %>
                    <%= link_to 'Edit', edit_swift_path(swift), data: {controller: 'bs-modal-form'}, class: 'btn btn-sm btn-outline-primary' %>
                    <%= button_to 'Delete', swift_path(swift), method: :delete, form: {class: 'm-0', data: {turbo_confirm: 'Delete this SWIFT?'}}, class: 'btn btn-sm btn-outline-danger' %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @swifts.empty? %><div class="carops-empty">No matching SWIFTs.</div><% end %>
    <div class="mt-3"><%= paginate @swifts %></div>
  </section>
</div>
