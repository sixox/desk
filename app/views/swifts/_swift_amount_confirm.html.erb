<%= form_with model: @swift, url: confirm_swift_path(@swift), method: :patch do |form| %>
  <div class="modal-body carops">
    <%= render 'shared/forms/errors', object: @swift %>
    <div class="p-3 rounded-3 mb-3" style="background:#e8f4ec;color:#17673f;">
      <div class="carops-kicker">CONFIRM INCOMING SWIFT #<%= @swift.id %></div>
      <h3 class="fs-4 fw-bold"><%= number_with_delimiter(@swift.amount) %> <small class="fs-6"><%= @swift.currency.to_s.upcase %></small></h3>
      <div class="small mt-1">Project <%= @swift.car_project&.external_key || @swift.project&.number || @swift.ci&.project&.number || '—' %></div>
    </div>
    <div class="row g-3">
      <div class="col-md-6">
        <%= form.label :bank_id, 'Receiving bank', class: 'form-label small fw-bold' %>
        <%= form.collection_select :bank_id, @banks.map { |bank| ["#{bank.name} – #{bank.currency}", bank.id] }, :second, :first, {prompt: 'Select bank'}, {class: 'form-select', required: true} %>
      </div>
      <div class="col-md-6">
        <%= form.label :deposited_amount, 'Deposited amount', class: 'form-label small fw-bold' %>
        <%= form.number_field :deposited_amount, value: @swift.deposited_amount.presence || @swift.amount, step: 'any', min: 0, required: true, class: 'form-control' %>
        <small class="text-muted">Enter amount in the receiving bank's currency.</small>
      </div>
    </div>
    <div class="small text-muted mt-3"><i class="fa-solid fa-shield-halved"></i> Confirmation credits the selected bank and creates a transaction.</div>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
    <%= form.submit 'Confirm deposit', class: 'btn btn-success' %>
  </div>
<% end %>
